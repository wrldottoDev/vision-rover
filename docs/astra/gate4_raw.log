   190	def test_replay_beats_naive_apply_under_latency():
   191	    rng = np.random.default_rng(4)
   192	    profile = lambda t: (70.0, 0.9)   # turning -> position moves meaningfully during latency
   193	    frames, truth_log = make_frames(rng, 6.0, profile, latency_range=(0.1, 0.3))
   194	
   195	    est_replay = make_est()
   196	    log_replay = drive(est_replay, frames, profile, 6.0, naive=False)
   197	
   198	    est_naive = make_est()
   199	    log_naive = drive(est_naive, frames, profile, 6.0, naive=True)
   200	
   201	    assert rmse_pos(log_replay, truth_log) < 0.7 * rmse_pos(log_naive, truth_log)
