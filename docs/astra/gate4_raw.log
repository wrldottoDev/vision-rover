   282	    profile = lambda t: (50.0, 0.0)
   283	    frames, truth_log = make_frames(rng, 3.0, profile, outlier_ts={1.0})
   284	    est = make_est()
   285	    log = drive(est, frames, profile, 3.0)
   286	    # The outlier at t=1.0 must not have derailed the estimate: RMSE stays tight.
   287	    assert rmse_pos(log, truth_log) < 2.0
   288	    assert est.reinit_count == 0
   289	    assert est.consecutive_rejects == 0   # good frames after the outlier reset the streak
