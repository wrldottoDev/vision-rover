   337	        est.predict(t)
   338	    ok1 = est.update_vision(Pose(60.0 * t, 0.0, 0.0), t, t)
   339	    assert ok1
   340	    before = (est._x.copy(), est._P.copy())
   341	    # A measurement captured well before anything we've retained -> must be ignored,
   342	    # not crash, not corrupt state.
   343	    stale_t = t - 5 * C.estimator.history_s
   344	    ok2 = est.update_vision(Pose(0.0, 0.0, 0.0), stale_t, t)
   345	    assert not ok2
   346	    assert np.allclose(before[0], est._x)
   347	    assert np.allclose(before[1], est._P)
   348	
   349	    # A duplicate of the exact same capture time as the last processed one is ignored.
   350	    ok3 = est.update_vision(Pose(9999.0, 9999.0, 2.0), t, t)
   351	    assert not ok3
   352	    assert np.allclose(before[0], est._x)
