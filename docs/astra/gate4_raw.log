   204	# ---------------------------------------------------------------------- dropped frames / quality
   205	
   206	def test_dropped_frames_degrade_then_lost_then_recover():
   207	    rng = np.random.default_rng(5)
   208	    profile = lambda t: (50.0, 0.0)
   209	    est = make_est()
   210	    last_cmd = None
   211	    t = 0.0
   212	    control_dt = 0.01
   213	    est.set_command(0.0, 50.0, 0.0)
   214	
   215	    def send_vision(t_now):
   216	        est.update_vision(Pose(50.0 * t_now, 0.0, 0.0), t_now, t_now)
   217	
   218	    # Feed good frames for 1s -> should be GOOD.
   219	    for i in range(100):
   220	        t = round(t + control_dt, 6)
   221	        est.predict(t)
   222	        if i % 2 == 0:
   223	            send_vision(t)
   224	    assert est.estimate(t).quality == TrackQuality.GOOD
   225	    assert est.is_safe_to_drive(t)
   226	
   227	    # Now stop all vision for a long stretch -> DEGRADED then LOST.
   228	    saw_degraded = False
   229	    for _ in range(150):
   230	        t = round(t + control_dt, 6)
   231	        est.predict(t)
   232	        q = est.estimate(t).quality
   233	        if q == TrackQuality.DEGRADED:
   234	            saw_degraded = True
   235	        if q == TrackQuality.LOST:
   236	            break
   237	    assert saw_degraded
   238	    assert est.estimate(t).quality == TrackQuality.LOST
   239	    assert not est.is_safe_to_drive(t)
   240	
   241	    # Frames resume -> should recover to GOOD.
   242	    for i in range(60):
   243	        t = round(t + control_dt, 6)
   244	        est.predict(t)
   245	        send_vision(t)
   246	    assert est.estimate(t).quality == TrackQuality.GOOD
   247	    assert est.is_safe_to_drive(t)
   248	
