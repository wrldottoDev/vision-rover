   355	# ---------------------------------------------------------------------- cube tracker
   356	
   357	def test_cube_occlusion_semantics_age_and_std_floor():
   358	    rng = np.random.default_rng(7)
   359	    cfg = CubeTrackerConfig()
   360	    ct = CubeTracker("red", cfg)
   361	    t = 0.0
   362	    true_x, true_y = 400.0, 300.0
   363	    stds = []
   364	    for i in range(40):
   365	        t = round(t + 0.05, 6)
   366	        nx = true_x + rng.normal(0, cfg.meas_pos_std)
   367	        ny = true_y + rng.normal(0, cfg.meas_pos_std)
   368	        ct.update(nx, ny, t, 0.0)
   369	        stds.append(ct.estimate(t).pos_std)
   370	
   371	    # std shrinks with more fresh frames but floors at bias_floor, never below it.
   372	    assert stds[0] > stds[-1] >= cfg.bias_floor_mm - 1e-9
   373	    assert ct.estimate(t).age_s < 1e-6
   374	
   375	    # Occlusion: feed repeats last known position with growing age_ms -> not new evidence.
   376	    last_estimate = ct.estimate(t)
   377	    for k in range(20):
   378	        t = round(t + 0.05, 6)
   379	        ct.update(true_x, true_y, t, age_s=0.05 * (k + 1))
   380	    occluded = ct.estimate(t)
   381	    assert occluded.x == last_estimate.x and occluded.y == last_estimate.y
   382	    # uncertainty must GROW while stale, driven by query time (not the frozen feed).
   383	    assert occluded.pos_std > last_estimate.pos_std
   384	    assert occluded.age_s > 0.9
