     1	"""Position filter for one cube: static-with-jumps model.
     2	
     3	A cube does not move on its own -- position is constant except while a rover is
     4	actively pushing it (`set_pushed(True)`), so the process model is "random walk with a
     5	process-noise rate that depends on whether we are currently pushing": tiny while
     6	static (just enough that the filter never fully stops listening to new evidence),
     7	large while pushed (so the estimate can track genuine motion quickly).
     8	
     9	Two independent scalar filters (x, y) are used rather than a full 2x2 covariance:
    10	vision gives an isotropic centroid estimate with no cross-axis correlation modelled,
    11	so a diagonal covariance is the right amount of machinery.
    12	
    13	Vision feed quirks handled here (mirrors pose_estimator.py):
    14	  * The feed repeats the last-known position with growing `age_ms` while occluded;
    15	    `age_s > 0` on a call means "not a fresh observation" and must not be treated as
    16	    new evidence (no Kalman correction, no jump/orientation-reset check).
    17	  * When >= 2 corner markers are occluded, the feed can additionally FREEZE: same
    18	    t_capture, unchanged age, repeated verbatim. Such a repeat is detected by
    19	    `t_capture` not having advanced past the last call and is dropped before it can
    20	    reset anything -- age_s alone is not a reliable freshness signal for this case.
    21	  * Because a frozen feed cannot itself carry "time is passing" information, the
    22	    growing uncertainty while stale is evaluated lazily in `estimate(t)` against the
    23	    caller's own clock `t`, not against the (possibly frozen) feed timestamps. The
    24	    running covariance is only advanced by elapsed feed time at the moment a genuinely
    25	    fresh observation arrives (predict-then-update).
    26	"""
    27	from __future__ import annotations
    28	
    29	import math
    30	from dataclasses import dataclass
    31	
    32	from ..world import CubeEstimate
    33	
    34	
    35	@dataclass(frozen=True)
    36	class CubeTrackerConfig:
    37	    # ASSUMED mm, fresh vision centroid noise. docs/interpretation_v0.md quotes a 5 mm
    38	    # worst-case *occluded* sigma; a fresh (unoccluded) centroid is assumed tighter,
    39	    # in line with the rover position noise (1-3 mm sigma) given for the same camera.
    40	    meas_pos_std: float = 3.0
    41	    # TUNED mm/sqrt(s) random-walk while NOT pushed: keeps the Kalman gain from decaying
    42	    # to exactly zero after many static frames (a cube nudged without triggering the
    43	    # jump gate must still be trackable).
    44	    static_process_std_per_s: float = 0.3
    45	    # TUNED mm/sqrt(s) while being pushed: lets the estimate follow genuine motion
    46	    # instead of lagging behind a moving cube.
    47	    pushed_process_std_per_s: float = 120.0
    48	    # ASSUMED mm floor on reported std: systematic vision bias (lens distortion,
    49	    # colour-segmentation centroid offset) does not average out with more frames.
    50	    bias_floor_mm: float = 1.5
    51	    # TUNED mm: a fresh observation vs. current estimate distance beyond this, while
    52	    # NOT pushed, is flagged as an unexpected move. Combined 1-sigma of a fresh
    53	    # measurement (3 mm) and a converged static estimate (floor 1.5 mm) is ~3.4 mm;
    54	    # this sits at ~4.5 sigma above that -- comfortably above sensor jitter, well below
    55	    # any real nudge of a 60 mm cube.
    56	    jump_threshold_mm: float = 15.0
    57	    # ASSUMED mm: uncertainty before the first observation is ever seen.
    58	    init_pos_std: float = 10.0
    59	
    60	
    61	class CubeTracker:
    62	    """Position (+ optional orientation) filter for one cube."""
    63	
    64	    def __init__(self, color: str, cfg: CubeTrackerConfig = CubeTrackerConfig()):
    65	        self.color = color
    66	        self.cfg = cfg
    67	        self._initialized = False
    68	        self._x = 0.0
    69	        self._y = 0.0
    70	        self._Pxx = cfg.init_pos_std ** 2
    71	        self._Pyy = cfg.init_pos_std ** 2
    72	        self._pushed = False
    73	        self._alpha: float | None = None
    74	        self._alpha_std = math.pi / 4
    75	        self._unexpected = False
    76	        self._last_fresh_t = 0.0
    77	        self._last_seen_capture_t = -math.inf
    78	
    79	    def _process_var_rate(self) -> float:
    80	        std_rate = self.cfg.pushed_process_std_per_s if self._pushed else self.cfg.static_process_std_per_s
    81	        return std_rate ** 2
    82	
    83	    def update(self, x: float, y: float, t_capture: float, age_s: float) -> None:
    84	        if not self._initialized:
    85	            self._x, self._y = x, y
    86	            self._Pxx = self._Pyy = self.cfg.init_pos_std ** 2
    87	            self._last_fresh_t = t_capture
    88	            self._last_seen_capture_t = t_capture
    89	            self._initialized = True
    90	            return
    91	
    92	        if t_capture <= self._last_seen_capture_t:
    93	            # Frozen/duplicate frame (or out-of-order): no new information.
    94	            return
    95	        self._last_seen_capture_t = t_capture
    96	
    97	        if age_s > 0.0:
    98	            # Feed is repeating a stale detection (partial occlusion with advancing
    99	            # age): not new evidence. Uncertainty growth is handled lazily in estimate().
   100	            return
   101	
   102	        # Fresh observation: predict the running covariance to t_capture, then correct.
   103	        elapsed = max(0.0, t_capture - self._last_fresh_t)
   104	        q_rate = self._process_var_rate()
   105	        self._Pxx += q_rate * elapsed
   106	        self._Pyy += q_rate * elapsed
   107	
   108	        dist = math.hypot(x - self._x, y - self._y)
   109	        self._unexpected = (not self._pushed) and (dist > self.cfg.jump_threshold_mm)
   110	        if self._unexpected:
   111	            self.set_orientation(None, math.pi / 4)
   112	
   113	        r = self.cfg.meas_pos_std ** 2
   114	        kx = self._Pxx / (self._Pxx + r)
   115	        ky = self._Pyy / (self._Pyy + r)
   116	        self._x += kx * (x - self._x)
   117	        self._y += ky * (y - self._y)
   118	        self._Pxx = max((1.0 - kx) * self._Pxx, self.cfg.bias_floor_mm ** 2)
   119	        self._Pyy = max((1.0 - ky) * self._Pyy, self.cfg.bias_floor_mm ** 2)
   120	        self._last_fresh_t = t_capture
   121	
   122	    def estimate(self, t: float) -> CubeEstimate:
   123	        elapsed = max(0.0, t - self._last_fresh_t) if self._initialized else math.inf
   124	        q_rate = self._process_var_rate()
   125	        proj_pxx = self._Pxx + q_rate * elapsed
   126	        proj_pyy = self._Pyy + q_rate * elapsed
   127	        pos_std = max(math.sqrt(max(proj_pxx, proj_pyy)), self.cfg.bias_floor_mm)
   128	        return CubeEstimate(
   129	            color=self.color,
   130	            x=self._x,
   131	            y=self._y,
   132	            pos_std=pos_std,
   133	            age_s=elapsed,
   134	            alpha=self._alpha,
   135	            alpha_std=self._alpha_std,
   136	            delivered=False,
   137	        )
   138	
   139	    def set_pushed(self, flag: bool) -> None:
   140	        self._pushed = flag
   141	
   142	    def set_orientation(self, alpha: float | None, std: float) -> None:
   143	        if alpha is None:
   144	            self._alpha = None
   145	        else:
   146	            r = alpha % (math.pi / 2.0)
   147	            if r >= math.pi / 4.0:
   148	                r -= math.pi / 2.0
   149	            self._alpha = r
   150	        self._alpha_std = std
   151	
   152	    def moved_unexpectedly(self) -> bool:
   153	        """True if the most recent fresh observation jumped beyond the gate while the
   154	        cube was not being pushed. Level-triggered: reflects the last fresh update
   155	        until the next fresh update re-evaluates it."""
   156	        return self._unexpected
     1	"""Tests for PoseEstimator and CubeTracker.
     2	
     3	Truth simulator: unicycle with the same first-order-lag speed response the filter
     4	assumes. This validates the EKF *mechanics* (propagation, gating, replay, wrapping,
     5	quality/blind-driving logic) rather than robustness to process-model mismatch, which
     6	is out of scope for this module.
     7	"""
     8	from __future__ import annotations
     9	
    10	import math
    11	
    12	import numpy as np
    13	import pytest
    14	
    15	from rover_strategy.config import DEFAULT as C
    16	from rover_strategy.frames import wrap, angle_diff
    17	from rover_strategy.world import Pose, TrackQuality
    18	from rover_strategy.estimation.pose_estimator import PoseEstimator
    19	from rover_strategy.estimation.cube_tracker import CubeTracker, CubeTrackerConfig
    20	
    21	TAU = C.estimator.cmd_tau
    22	POS_STD = C.estimator.meas_pos_std          # 2.0 mm
    23	HEAD_STD = C.estimator.meas_heading_std     # ~1.5 deg
    24	
    25	
    26	class Truth:
    27	    """Unicycle-with-lag ground truth, integrated at a fine fixed sub-step."""
    28	
    29	    SIM_DT = 0.002
    30	
    31	    def __init__(self):
    32	        self.x = self.y = self.theta = self.v = self.omega = 0.0
    33	
    34	    def step(self, dt: float, v_cmd: float, w_cmd: float) -> None:
    35	        n = max(1, round(dt / self.SIM_DT))
    36	        h = dt / n
    37	        for _ in range(n):
    38	            a = math.exp(-h / TAU)
    39	            v1 = v_cmd + (self.v - v_cmd) * a
    40	            w1 = w_cmd + (self.omega - w_cmd) * a
    41	            v_avg = 0.5 * (self.v + v1)
    42	            w_avg = 0.5 * (self.omega + w1)
    43	            th_mid = self.theta + 0.5 * w_avg * h
    44	            self.x += v_avg * math.cos(th_mid) * h
    45	            self.y += v_avg * math.sin(th_mid) * h
    46	            self.theta = wrap(self.theta + w_avg * h)
    47	            self.v, self.omega = v1, w1
    48	
    49	
    50	def make_est(rover_id=0, pose=Pose(0.0, 0.0, 0.0), t0=0.0):
    51	    est = PoseEstimator(C.estimator, C.telemetry, rover_id)
    52	    est.initialize(pose, t0)
    53	    return est
    54	
    55	
    56	def make_frames(rng, duration, cmd_profile, *, frame_hz=20.0, drop_prob=0.0,
    57	                 latency_range=(0.03, 0.3), pos_std=POS_STD, heading_std=HEAD_STD,
    58	                 outlier_ts=frozenset(), control_dt=0.01):
    59	    """Simulate truth + a noisy, delayed, occasionally-dropped vision feed.
    60	
    61	    Returns (frames, truth_log). frames: list of dict(capture_t, deliver_t, pose).
    62	    truth_log: list of (t, x, y, theta) sampled every control tick.
    63	    """
    64	    truth = Truth()
    65	    frame_dt = 1.0 / frame_hz
    66	    t = 0.0
    67	    next_frame_t = 0.0
    68	    frames = []
    69	    truth_log = [(0.0, 0.0, 0.0, 0.0)]
    70	    n_ticks = round(duration / control_dt)
    71	    for _ in range(n_ticks):
    72	        v_cmd, w_cmd = cmd_profile(t)
    73	        truth.step(control_dt, v_cmd, w_cmd)
    74	        t = round(t + control_dt, 6)
    75	        truth_log.append((t, truth.x, truth.y, truth.theta))
    76	        while next_frame_t <= t + 1e-9:
    77	            capture_t = next_frame_t
    78	            if rng.random() >= drop_prob:
    79	                nx = truth.x + rng.normal(0, pos_std)
    80	                ny = truth.y + rng.normal(0, pos_std)
    81	                nth = wrap(truth.theta + rng.normal(0, heading_std))
    82	                if capture_t in outlier_ts:
    83	                    ang = rng.uniform(0, 2 * math.pi)
    84	                    nx += 300.0 * math.cos(ang)
    85	                    ny += 300.0 * math.sin(ang)
    86	                lat = rng.uniform(*latency_range)
    87	                frames.append(dict(capture_t=capture_t, deliver_t=round(capture_t + lat, 6), pose=Pose(nx, ny, nth)))
    88	            next_frame_t = round(next_frame_t + frame_dt, 6)
    89	    frames.sort(key=lambda f: f["deliver_t"])
    90	    return frames, truth_log
    91	
    92	
    93	def drive(est, frames, cmd_profile, duration, control_dt=0.01, naive=False):
    94	    """Feed cmd_profile + frames through est, return list of (t, RoverEstimate)."""
    95	    fi = 0
    96	    t = 0.0
    97	    last_cmd = None
    98	    log = []
    99	    n_ticks = round(duration / control_dt)
   100	    for _ in range(n_ticks):
   101	        v_cmd, w_cmd = cmd_profile(t)
   102	        if (v_cmd, w_cmd) != last_cmd:
   103	            est.set_command(t, v_cmd, w_cmd)
   104	            last_cmd = (v_cmd, w_cmd)
   105	        t = round(t + control_dt, 6)
   106	        est.predict(t)
   107	        while fi < len(frames) and frames[fi]["deliver_t"] <= t + 1e-9:
   108	            f = frames[fi]
   109	            t_cap = t if naive else f["capture_t"]
   110	            est.update_vision(f["pose"], t_cap, t)
   111	            fi += 1
   112	        log.append((t, est.estimate(t)))
   113	    return log
   114	
   115	
   116	def truth_at(truth_log, t):
   117	    times = [r[0] for r in truth_log]
   118	    idx = min(range(len(times)), key=lambda i: abs(times[i] - t))
   119	    return truth_log[idx]
   120	
   121	
   122	def rmse_pos(log, truth_log):
   123	    errs = []
   124	    for t, e in log:
   125	        _, tx, ty, _ = truth_at(truth_log, t)
   126	        errs.append((e.pose.x - tx) ** 2 + (e.pose.y - ty) ** 2)
   127	    return math.sqrt(np.mean(errs))
   128	
   129	
   130	def rmse_heading(log, truth_log):
   131	    errs = []
   132	    for t, e in log:
   133	        _, _, _, tth = truth_at(truth_log, t)
   134	        errs.append(angle_diff(e.pose.theta, tth) ** 2)
   135	    return math.sqrt(np.mean(errs))
   136	
   137	
   138	# ---------------------------------------------------------------------- trajectories
   139	
   140	def test_straight_line_rmse_and_consistency():
   141	    rng = np.random.default_rng(1)
   142	    profile = lambda t: (80.0, 0.0)
   143	    frames, truth_log = make_frames(rng, 5.0, profile, drop_prob=0.0)
   144	    est = make_est()
   145	    log = drive(est, frames, profile, 5.0)
   146	
   147	    # 20 Hz vision at 2 mm sigma fused over ~1 s of history should beat a single raw
   148	    # measurement by a solid margin; 2 mm is a generous cap (empirically ~1.6 mm here)
   149	    # that would fail if the update/replay math were broken (e.g. innovation sign
   150	    # flipped, wrong gain).
   151	    assert rmse_pos(log, truth_log) < 2.0
   152	    assert rmse_heading(log, truth_log) < math.radians(1.5)
   153	
   154	    # NEES (3 dof): chi2 mean is 3. Average over the whole run should land in a wide
   155	    # but meaningful band -- this is what would catch an inconsistent (over/under-
   156	    # confident) covariance, e.g. a missing Q term or a Joseph-form bug.
   157	    nees = []
   158	    for t, e in log:
   159	        _, tx, ty, tth = truth_at(truth_log, t)
   160	        err = np.array([e.pose.x - tx, e.pose.y - ty, angle_diff(e.pose.theta, tth)])
   161	        nees.append(err @ np.linalg.solve(e.cov, err))
   162	    assert 0.5 < np.mean(nees) < 9.0
   163	
