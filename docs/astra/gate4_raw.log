     1	"""Unit and frame conversions.  The ONLY place official (cells, row-down, degrees) meets internal
     2	(mm, y-up, radians).
     3	
     4	Official (CONTRATO.md s4): col right, row DOWN, theta degrees CCW, 0 = +col, forward = (cos, -sin) in (col,row).
     5	Internal: x = col*cell, y = (rows - row)*cell, theta = rad(theta_deg); forward = (cos, sin).
     6	"""
     7	from __future__ import annotations
     8	
     9	import math
    10	from dataclasses import dataclass
    11	
    12	TWO_PI = 2.0 * math.pi
    13	
    14	
    15	def wrap(a: float) -> float:
    16	    """Wrap angle to [-pi, pi)."""
    17	    return (a + math.pi) % TWO_PI - math.pi
    18	
    19	
    20	def angle_diff(a: float, b: float) -> float:
    21	    """Signed smallest a - b in [-pi, pi)."""
    22	    return wrap(a - b)
    23	
    24	
    25	@dataclass(frozen=True)
    26	class Grid:
    27	    cols: int = 43
    28	    rows: int = 43
    29	    cell_mm: float = 20.0
    30	
    31	    def to_internal_xy(self, col: float, row: float) -> tuple[float, float]:
    32	        return col * self.cell_mm, (self.rows - row) * self.cell_mm
    33	
    34	    def to_official_xy(self, x: float, y: float) -> tuple[float, float]:
    35	        return x / self.cell_mm, self.rows - y / self.cell_mm
    36	
    37	    @staticmethod
    38	    def to_internal_heading(theta_deg: float) -> float:
    39	        return wrap(math.radians(theta_deg))
    40	
    41	    @staticmethod
    42	    def to_official_heading(theta: float) -> float:
    43	        return math.degrees(theta) % 360.0
    44	
    45	    def to_internal_pose(self, col: float, row: float, theta_deg: float) -> tuple[float, float, float]:
    46	        x, y = self.to_internal_xy(col, row)
    47	        return x, y, self.to_internal_heading(theta_deg)
    48	
    49	
    50	def marker_to_body(x: float, y: float, th: float, fwd: float, left: float, dth: float) -> tuple[float, float, float]:
    51	    """Published marker pose -> rotation-centre pose. (fwd, left) is the vector marker->rotation centre
    52	    expressed in the rover frame (same convention as config_vision.json desfase_marcador_a_centro_mm)."""
    53	    t = wrap(th + dth)
    54	    c, s = math.cos(t), math.sin(t)
    55	    return x + c * fwd - s * left, y + s * fwd + c * left, t
    56	
    57	
    58	def body_to_marker(x: float, y: float, th: float, fwd: float, left: float, dth: float) -> tuple[float, float, float]:
    59	    c, s = math.cos(th), math.sin(th)
    60	    return x - (c * fwd - s * left), y - (s * fwd + c * left), wrap(th - dth)

