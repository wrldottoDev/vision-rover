   250	def test_frozen_ts_ms_duplicate_does_not_reset_age_and_goes_lost():
   251	    """Lead's audit finding: >=2 markers occluded => feed repeats the SAME t_capture
   252	    forever. Repeated calls with an unchanged t_capture must not be treated as new
   253	    evidence: quality must still degrade to LOST and stay LOST until t_capture moves."""
   254	    est = make_est()
   255	    est.set_command(0.0, 40.0, 0.0)
   256	    t = 0.0
   257	    control_dt = 0.01
   258	    frozen_capture_t = 0.5
   259	    frozen_pose = Pose(20.0, 0.0, 0.0)
   260	
   261	    accepted_after_freeze = 0
   262	    for _ in range(200):
   263	        t = round(t + control_dt, 6)
   264	        est.predict(t)
   265	        ok = est.update_vision(frozen_pose, frozen_capture_t, t)
   266	        if ok:
   267	            accepted_after_freeze += 1
   268	
   269	    # The first delivery (t_capture=0.5 arriving once t has passed it) may or may not
   270	    # be accepted depending on gate/geometry, but subsequent identical repeats of the
   271	    # SAME t_capture must all be rejected as duplicates -> at most one accept total.
   272	    assert accepted_after_freeze <= 1
   273	    assert est.consecutive_rejects == 0   # duplicates must never count as rejects
   274	    assert est.estimate(t).quality == TrackQuality.LOST
   275	    assert not est.is_safe_to_drive(t)
   276	
