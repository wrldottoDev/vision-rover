+    cache = nav._FastCache(FP0)
+    cache.poly(pose.x, pose.y, 0.0)  # Same rounded key as pose.theta.
+    assert independently_collides(pose, [])
+    assert nav.pose_collides(FP0, pose, [], BW, BH, 0)
