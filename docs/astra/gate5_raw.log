   340	class NavPlanner:
   341	    """Hybrid A* planner from a start Pose to a goal Pose, honouring a wall-clock deadline."""
   342	
   343	    def __init__(self, cfg: Config = DEFAULT, params: NavParams | None = None):
   344	        self.cfg = cfg
   345	        self.params = params or NavParams()
   346	        self.last_failure: str = ""
   347	
   348	    # -- public -------------------------------------------------------------------------------
   349	    def plan(self, start: Pose, goal: Pose, obstacles: Sequence[Obstacle], board_w: float, board_h: float,
   350	             inflate: float | None = None, deadline_s: float = 1.0) -> Path | None:
   351	        t0 = time.monotonic()
   352	        cfg, params = self.cfg, self.params
   353	        self.last_failure = ""
   354	
   355	        inflate = cfg.margins.pose_uncertainty if inflate is None else inflate
   356	        board_margin = cfg.margins.board
   357	        fp = Footprint(cfg.rover, inflate=inflate)
   358	        fp0 = Footprint(cfg.rover, inflate=0.0)
   359	        cache = _FastCache(fp)
   360	        cache0 = _FastCache(fp0)
   361	        obstacles_fast = _fast_obstacles(obstacles)
   362	
   363	        if _fast_pose_collides(cache, goal, obstacles_fast, board_w, board_h, board_margin):
   364	            self.last_failure = "goal pose in collision"
   365	            return None
   366	
   367	        prefix: list[Segment] = []
   368	        search_start = start
   369	        if _fast_pose_collides(cache, start, obstacles_fast, board_w, board_h, board_margin):
   370	            if _fast_pose_collides(cache0, start, obstacles_fast, board_w, board_h, board_margin):
   371	                self.last_failure = "start pose in collision (uninflated)"
   372	                return None
   373	            escaped = self._escape(cache, cache0, fp0, start, obstacles, board_w, board_h, board_margin)
   374	            if escaped is None:
   375	                self.last_failure = "start pose in inflated collision; escape failed"
   376	                return None
   377	            search_start, prefix = escaped
   378	
   379	        result = self._search(cache, search_start, goal, obstacles_fast, board_w, board_h, board_margin,
   380	                               deadline_s, t0)
   381	        if result is None:
   382	            return None  # last_failure already set by _search
   383	
   384	        segs = prefix + result
   385	        if not segs:
   386	            # start already at goal (within tolerance): still return a well-formed Path (`.goal` reads
   387	            # the last segment's end) rather than an empty one.
   388	            segs = [Segment(SegKind.STRAIGHT, search_start, search_start, reverse=False)]
   389	        path = Path(segments=segs, cost_s=_segs_cost(segs, cfg, params))
   390	        return self._smooth(cache, path, obstacles_fast, board_w, board_h, board_margin)
