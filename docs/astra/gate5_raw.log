   327	def _segs_cost(segs: Sequence[Segment], cfg: Config, params: NavParams) -> float:
   328	    total = 0.0
   329	    for s in segs:
   330	        if s.kind is SegKind.ROTATE:
   331	            total += abs(angle_diff(s.end.theta, s.start.theta)) / cfg.limits.w_nav + params.rotate_settle_s
   332	        else:
   333	            c = s.length / cfg.limits.v_nav
   334	            if s.reverse:
   335	                c *= params.reverse_penalty
   336	            total += c
   337	    return total
