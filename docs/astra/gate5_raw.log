        assert path is not None
        polys = nav.swept_polygons(Footprint(C.rover, C.margins.pose_uncertainty), path)
        pose = path.segments[0].start
        dt, t = 0.005, 0.0
        follower = SegmentFollower()
        for seg in path.segments:
