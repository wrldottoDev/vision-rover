+def test_escape_does_not_drive_into_a_real_cube():
+    start = Pose(430, 430, 0)
+    obstacles = [corner_graze(2.0, 0.03),
+                 nav.DiscObstacle(430 - 47 - C.cube.half_diag - 1, 430 - 49.75, C.cube.half_diag)]
