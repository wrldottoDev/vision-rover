    96	def _decel_speed(remaining: float, accel: float, v_cap: float) -> float:
    97	    """Speed that can still be brought to zero within `remaining` distance at `accel` -- the standard
    98	    accel-limited stopping profile v = sqrt(2 a d), clamped to the cruise cap."""
    99	    return min(v_cap, math.sqrt(2.0 * accel * max(remaining, 0.0)))
