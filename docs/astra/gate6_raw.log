   159	        self.align = AlignController(cfg)
   160	        self.capture = CaptureController(cfg)
   161	        self.pusher = PushController(cfg)
   162	        self.retreat = RetreatController(cfg)
   163	        self._last_t = 0.0
   164	
   165	    # ------------------------------------------------------------------ helpers
   166	    def _go(self, s: S, t: float, ctx: AgentContext, why: str = "") -> None:
   167	        if s != self.state:
   168	            ctx.log(self.id, "state", frm=self.state.value, to=s.value, why=why)
   169	        self.state = s
   170	        self.t_enter = t
   171	
   172	    def dwell(self, t: float) -> float:
   173	        return t - self.t_enter
   174	
   175	    @property
   176	    def leg(self):
   177	        return self.task.plan.legs[self.task.leg] if self.task else None
   178	
   179	    @property
   180	    def retreat_distance(self) -> float:
   181	        return self.cfg.rover.paddle_reach + self.p.retreat_extra
   182	
   183	    def priority_state(self) -> str:
   184	        """State name for reservation priority: an engaged rover is always treated as PUSH."""
   185	        return "PUSH" if self.engaged else self.state.value
   186	
   187	    def assign(self, task: Task, t: float, ctx: AgentContext) -> None:
   188	        task.t_start = t
   189	        self.task = task
   190	        ctx.log(self.id, "assign", color=task.color, legs=len(task.plan.legs), cost=round(task.plan.cost_s, 1))
   191	        self._start_nav(t, ctx)
   192	
   193	    def _start_nav(self, t: float, ctx: AgentContext) -> None:
   194	        self.path = None
   195	        self._go(S.NAVIGATE, t, ctx)
   196	
   197	    def _charge(self, w: float, t: float, ctx: AgentContext, why: str) -> bool:
   198	        """Charge the task failure budget. Returns True if the task was released (budget exhausted)."""
   199	        if not self.task:
   200	            return False
   201	        self.task.budget_used += w
   202	        ctx.log(self.id, "budget", used=self.task.budget_used, why=why)
   203	        if self.task.budget_used >= self.p.task_budget or t - self.task.t_start > self.p.task_time_budget_s:
   204	            if self.engaged:
   205	                return False                     # must retreat first; the release happens after the retreat
   206	            ctx.release_task(self.id, self.task.color, failed=True, t=t)
   207	            self.task = None
   208	            self.path = None
   209	            self._go(S.IDLE, t, ctx, "task budget exhausted: " + why)
   210	            return True
   211	        return False
   212	
   213	    def _fail_task(self, t: float, ctx: AgentContext, why: str, weight: float = 1.0) -> None:
   214	        """Abort current attempt: retreat first if the channel may hold the cube, then replan."""
   215	        self.stats.recoveries += 1
   216	        ctx.log(self.id, "task_fail", why=why, state=self.state.value)
   217	        if self.engaged:
   218	            if self.task:
   219	                self.task.budget_used += weight
   220	            self._begin_retreat(t, ctx, "replan")
   221	            return
   222	        if not self._charge(weight, t, ctx, why):
   223	            self._replan(t, ctx)
   224	
   225	    def _replan(self, t: float, ctx: AgentContext) -> None:
   226	        if not self.task:
   227	            self._go(S.IDLE, t, ctx)
   228	            return
   229	        if self.task.budget_used >= self.p.task_budget:
   230	            ctx.release_task(self.id, self.task.color, failed=True, t=t)
   231	            self.task = None
   232	            self._go(S.IDLE, t, ctx, "task budget exhausted")
   233	            return
   234	        self.stats.replans += 1
   235	        plan = ctx.plan_push(self.id, self.task.color)
   236	        if plan is None:
   237	            ctx.release_task(self.id, self.task.color, failed=True, t=t)
   238	            self.task = None
   239	            self._go(S.IDLE, t, ctx, "no push plan")
   240	            return
   241	        self.task.plan, self.task.leg = plan, 0
   242	        self._start_nav(t, ctx)
   243	
   244	    def _begin_retreat(self, t: float, ctx: AgentContext, after: str) -> None:
   245	        self.after_retreat = after
   246	        self.retreat_start = None
   247	        self.retreat_blocked_since = None
   248	        if self.task:
   249	            ctx.set_cube_pushed(self.task.color, False)
   250	        self.retreat.reset(self.retreat_distance)
   251	        self._go(S.RETREAT, t, ctx, after)
   252	
   253	    def _progress(self, t: float, est: RoverEstimate) -> None:
   254	        xy = est.pose.xy()
   255	        if self._progress_xy is None or np.linalg.norm(xy - self._progress_xy) > 15.0:
   256	            self._progress_xy = xy
   257	            self.last_progress_t = t
   258	
   259	    # ------------------------------------------------------------------ external interrupts
   260	    def estop(self, t: float, ctx: AgentContext) -> None:
   261	        if self.state in INTERRUPTS or self.state in PASSIVE:
   262	            return
   263	        self.resume = self.state
   264	        self.stats.estops += 1
   265	        self._go(S.EMERGENCY_STOP, t, ctx)
   266	
   267	    def clear_estop(self, t: float, ctx: AgentContext) -> None:
   268	        if self.state == S.EMERGENCY_STOP:
   269	            self._resume(t, ctx)
   270	
   271	    def order_yield(self, goal: Pose, hold_s: float, t: float, ctx: AgentContext) -> bool:
   272	        if self.engaged or self.state not in (S.IDLE, S.DONE, S.WAIT, S.NAVIGATE):
   273	            return False
   274	        self.resume = S.NAVIGATE if self.task else S.IDLE
   275	        self.yield_goal = goal
   276	        self.yield_hold_until = t + hold_s
   277	        self.path = None
   278	        self._go(S.YIELD, t, ctx, "ordered")
   279	        return True
   280	
   281	    # ------------------------------------------------------------------ main step
   282	    def step(self, t: float, est: RoverEstimate, safe: bool, ctx: AgentContext) -> tuple[float, float]:
   283	        dt = max(1e-3, t - self._last_t)
   284	        self._last_t = t
   285	        self._progress(t, est)
   286	        if not safe and self.state not in (S.RELOCALIZE,) and self.state not in PASSIVE:
   287	            if self.state not in INTERRUPTS:
   288	                self.resume = self.state
   289	            self._go(S.RELOCALIZE, t, ctx, "estimate unsafe")
   290	        v, w = getattr(self, "_s_" + self.state.value.lower())(t, est, safe, ctx)
   291	        if self.state == S.WAIT:
   292	            self.stats.waits_s += dt
   293	        if self.engaged and w != 0.0 and self.state not in (S.CAPTURE, S.PUSH):
   294	            w = 0.0                                  # hard invariant: no free rotation with a cube in the channel
   295	        return v, w
   296	
   297	    # ------------------------------------------------------------------ passive / interrupt states
   298	    def _s_idle(self, t, est, safe, ctx):
   299	        return 0.0, 0.0
   300	
   301	    _s_done = _s_idle
   302	
   303	    def _s_emergency_stop(self, t, est, safe, ctx):
   304	        return 0.0, 0.0
   305	
   306	    def _s_relocalize(self, t, est, safe, ctx):
   307	        if not safe:
   308	            self.t_enter = t
   309	            return 0.0, 0.0
   310	        if self.dwell(t) >= self.p.relocalize_good_s:
   311	            self._resume(t, ctx)
   312	        return 0.0, 0.0
   313	
   314	    def _resume(self, t, ctx):
   315	        r, self.resume = self.resume, None
   316	        if self.engaged:
   317	            # Never resume blind manipulation: re-verify contact (region is still committed), or keep retreating.
   318	            if r == S.RETREAT:
   319	                self._go(S.RETREAT, t, ctx, "resume")
   320	            elif r in (S.VERIFY_DELIVERY, S.MEASURE):
   321	                self._go(r, t, ctx, "resume")
   322	            else:
   323	                self._go(S.VERIFY_CAPTURE, t, ctx, "resume")
   324	            return
   325	        if r == S.CONFIRM:
   326	            self._go(S.CONFIRM, t, ctx, "resume")
   327	        elif r == S.YIELD and self.yield_goal is not None:
   328	            self.path = None
   329	            self._go(S.YIELD, t, ctx, "resume")
   330	        elif self.task:
   331	            self._start_nav(t, ctx)                  # re-plan navigation from where we actually are
   332	        else:
   333	            self._go(S.IDLE, t, ctx, "resume")
   334	
   335	    def _s_wait(self, t, est, safe, ctx):
   336	        if self.dwell(t) >= self.p.wait_retry_s:
   337	            r, self.resume = self.resume, None
   338	            if self.engaged:
   339	                self._go(r if r in (S.RETREAT, S.VERIFY_CAPTURE) else S.VERIFY_CAPTURE, t, ctx, "retry")
   340	            elif r == S.YIELD and self.yield_goal is not None:
   341	                self.path = None
   342	                self._go(S.YIELD, t, ctx, "retry")
   343	            elif self.task:
   344	                self._start_nav(t, ctx)
   345	            else:
   346	                self._go(S.IDLE, t, ctx)
   347	        return 0.0, 0.0
   348	
   349	    def _wait(self, t, ctx, resume: S, why: str):
   350	        self.resume = resume
   351	        self._go(S.WAIT, t, ctx, why)
   352	        return 0.0, 0.0
   353	
   354	    # ------------------------------------------------------------------ navigation (also used by YIELD)
   355	    def _navigate_to(self, t, est, ctx, goal: Pose, extra: list[np.ndarray]):
   356	        """-> (v, w, status) status in {'moving','arrived','blocked','noplan','deviated','timeout'}."""
   357	        if self.path is None:
   358	            path = ctx.plan_nav(self.id, goal)
   359	            if path is None:
   360	                return 0.0, 0.0, "noplan"
   361	            if not ctx.commit_path(self.id, path, extra):
   362	                return 0.0, 0.0, "blocked"
   363	            self.path, self.seg_i, self.nav_t0 = path, 0, t
   364	            self.follow.reset(self.path.segments[0])
   365	            self._revalidate_t = t
   366	        if self.seg_i >= len(self.path.segments):
   367	            return 0.0, 0.0, "arrived"
   368	        if t - self.nav_t0 > self.p.nav_timeout_factor * self.path.cost_s + 8.0:
   369	            return 0.0, 0.0, "timeout"
   370	        if t - self._revalidate_t > 0.5:             # the world may have changed (cubes moved)
   371	            self._revalidate_t = t
   372	            if not ctx.path_still_clear(self.id, self.path, self.seg_i):
   373	                return 0.0, 0.0, "deviated"
   374	        seg = self.path.segments[self.seg_i]
   375	        v, w, done = self.follow.step(est, t)
   376	        if seg.kind == SegKind.STRAIGHT:
   377	            _, cross, head = self.follow.tracking_error()
   378	            if abs(cross) > self.p.nav_track_cross_tol or abs(head) > self.p.nav_track_heading_tol:
   379	                ctx.log(self.id, "nav_deviation", cross=round(cross, 1), head=round(head, 3))
   380	                return 0.0, 0.0, "deviated"
   381	        if done:
   382	            self.seg_i += 1
   383	            if self.seg_i >= len(self.path.segments):
   384	                return 0.0, 0.0, "arrived"
   385	            self.follow.reset(self.path.segments[self.seg_i])
   386	        return v, w, "moving"
   387	
   388	    def _leg_region(self, ctx: AgentContext) -> list[np.ndarray]:
   389	        leg = self.leg
   390	        pre = leg.prepush
   391	        travel = math.hypot(leg.cube_end[0] - pre.x, leg.cube_end[1] - pre.y) - self.cfg.contact_distance
   392	        return ctx.manipulation_region(self.id, pre, leg.heading, max(0.0, travel))
   393	
   394	    _NAV_WEIGHT = {"noplan": 1.0, "blocked": 0.15, "deviated": 0.5, "timeout": 1.0}
   395	
   396	    def _s_navigate(self, t, est, safe, ctx):
   397	        cube = ctx.cube(self.task.color)
   398	        leg = self.leg
   399	        if cube is None:
   400	            return self._wait(t, ctx, S.NAVIGATE, "cube unknown")
   401	        if math.hypot(cube.x - leg.cube_start[0], cube.y - leg.cube_start[1]) > self.p.cube_moved_tol:
   402	            ctx.log(self.id, "cube_moved_before_capture", color=self.task.color)
   403	            self.path = None
   404	            if not self._charge(0.5, t, ctx, "cube moved"):
   405	                self._replan(t, ctx)
   406	            return 0.0, 0.0
   407	        v, w, st = self._navigate_to(t, est, ctx, leg.prepush, self._leg_region(ctx))
   408	        if st == "arrived":
   409	            self.path = None
   410	            self.align_started = False
   411	            self._go(S.ALIGN, t, ctx)
   412	        elif st != "moving":
   413	            self.path = None
   414	            if st == "noplan":
   415	                self.stats.nav_failures += 1
   416	            if not self._charge(self._NAV_WEIGHT[st], t, ctx, "nav " + st):
   417	                return self._wait(t, ctx, S.NAVIGATE, "nav " + st)
   418	        return v, w
   419	
   420	    def _s_yield(self, t, est, safe, ctx):
   421	        if self.yield_goal is None:
   422	            self._go(S.IDLE, t, ctx)
   423	            return 0.0, 0.0
   424	        v, w, st = self._navigate_to(t, est, ctx, self.yield_goal, [])
   425	        if st == "arrived":
   426	            if t < self.yield_hold_until:
   427	                return 0.0, 0.0                      # hold the parking spot until released / timeout
   428	            self.path, self.yield_goal = None, None
   429	            if self.task:
   430	                return self._wait(t, ctx, S.NAVIGATE, "yield done")
   431	            self._go(S.IDLE, t, ctx, "yield done")
   432	        elif st != "moving":
   433	            self.path = None
   434	            if t > self.yield_hold_until:
   435	                self.yield_goal = None
   436	                self._go(S.IDLE if not self.task else S.WAIT, t, ctx, "yield " + st)
   437	                self.resume = S.NAVIGATE if self.task else None
   438	                return 0.0, 0.0
   439	            return self._wait(t, ctx, S.YIELD, "yield " + st)
   440	        return v, w
   441	
   442	    def release_yield(self, t: float) -> None:
   443	        self.yield_hold_until = min(self.yield_hold_until, t)
   444	
   445	    # ------------------------------------------------------------------ manipulation
   446	    def _s_align(self, t, est, safe, ctx):
   447	        if self.dwell(t) > self.p.align_timeout_s:
   448	            self._fail_task(t, ctx, "align timeout")
   449	            return 0.0, 0.0
   450	        obs = ctx.fresh_cube(self.task.color, t - 0.6)
   451	        cube = ctx.cube(self.task.color)
   452	        if obs is None or cube is None:
   453	            return 0.0, 0.0                          # wait for a fresh look at the (static) cube
   454	        p0 = obs[0]
   455	        p1 = np.array(self.leg.cube_end, float)
   456	        d = p1 - p0
   457	        phi = math.atan2(d[1], d[0]) if np.linalg.norm(d) > 10.0 else self.leg.heading
   458	        if abs(angle_diff(phi, self.leg.heading)) > math.radians(10):
   459	            if not self._charge(0.5, t, ctx, "cube moved at align"):
   460	                self._replan(t, ctx)
   461	            return 0.0, 0.0
   462	        lat = -math.sin(phi) * (est.pose.x - p0[0]) + math.cos(phi) * (est.pose.y - p0[1])
   463	        if abs(lat) > self.p.align_reposition_tol:
   464	            if not self._charge(0.5, t, ctx, "align lateral too large"):
   465	                self._start_nav(t, ctx)
   466	            return 0.0, 0.0
   467	        if not self.align_started:
   468	            self.align.reset((float(p0[0]), float(p0[1])), phi)
   469	            self.align_started = True
   470	            self.align_phi = phi
   471	        v, w, done, status = self.align.step(est, t)
   472	        if done:
   473	            fw = np.array([math.cos(phi), math.sin(phi)])
   474	            dist = float(np.dot(p0 - est.pose.xy(), fw))
   475	            travel = dist - self.cfg.contact_distance + self.p.capture_overdrive
   476	            start_on_line = p0 - dist * fw           # point of the cube line abeam of the rover: along = 0 here
   477	            region = ctx.manipulation_region(self.id, est.pose.rotated_to(phi), phi,
   478	                                             max(0.0, float(np.linalg.norm(p1 - est.pose.xy())) - self.cfg.contact_distance))
   479	            if not ctx.commit_region(self.id, region):
   480	                return self._wait(t, ctx, S.NAVIGATE, "manipulation region denied")
   481	            self.capture.reset((float(start_on_line[0]), float(start_on_line[1])), phi, max(0.0, travel))
   482	            self.push_line = (p0, p1)
   483	            self.engaged = True
   484	            ctx.set_cube_pushed(self.task.color, True)
   485	            self._go(S.CAPTURE, t, ctx)
   486	        return v, w
   487	
   488	    def _s_capture(self, t, est, safe, ctx):
   489	        if self.dwell(t) > self.p.capture_timeout_s:
   490	            self._fail_task(t, ctx, "capture timeout")
   491	            return 0.0, 0.0
   492	        v, w, done = self.capture.step(est, t)
   493	        if done:
   494	            self._go(S.VERIFY_CAPTURE, t, ctx)
   495	            return 0.0, 0.0
   496	        return v, w
   497	
   498	    def _contact(self, est: RoverEstimate, since: float, ctx: AgentContext):
   499	        """Relative cube geometry from distinct fresh captures since `since`: (depth, lateral, n) or None.
   500	        depth = cube-centre distance ahead of the front plate."""
   501	        obs = ctx.fresh_cube(self.task.color, since)
   502	        if obs is None or obs[1] < self.p.min_frames:
   503	            return None
   504	        xl, yl = est.pose.to_local(float(obs[0][0]), float(obs[0][1]))
   505	        return xl - self.cfg.rover.x_front_plate, yl, obs[1]
   506	
   507	    def _fits_channel(self, depth: float, lat: float) -> bool:
   508	        """Is there an orientation a for which a cube touching the plate has projected half-depth h(a) = depth
   509	        and fits laterally: |lat| + h(a) <= inner half width?  (square: same h for depth and width)"""
   510	        c, g = self.cfg.cube, self.cfg.rover
   511	        if not (c.half - self.p.depth_tol <= depth <= c.half_diag + self.p.depth_tol):
   512	            return False
   513	        h = min(max(depth, c.half), c.half_diag)
   514	        return abs(lat) + h <= g.inner_half_width + self.p.contact_tol
   515	
   516	    def _infer_orientation(self, depth: float, heading: float, ctx) -> None:
   517	        if depth <= self.cfg.cube.half + self.p.flush_tol:
   518	            ctx.set_cube_orientation(self.task.color, wrap4(heading), self.p.flush_alpha_std)
   519	        else:
   520	            ctx.set_cube_orientation(self.task.color, None, math.pi / 4)
   521	
   522	    def _s_verify_capture(self, t, est, safe, ctx):
   523	        if self.dwell(t) < self.p.verify_s:
   524	            return 0.0, 0.0
   525	        m = self._contact(est, self.t_enter + self.p.verify_s * 0.5, ctx)
   526	        if m is None:
   527	            if self.dwell(t) > self.p.verify_timeout_s:
   528	                self.stats.capture_failures += 1
   529	                self._fail_task(t, ctx, "cube not observed at capture")
   530	            return 0.0, 0.0
   531	        depth, lat, n = m
   532	        ok = self._fits_channel(depth, lat)
   533	        ctx.log(self.id, "verify_capture", ok=ok, depth=round(depth, 1), lat=round(lat, 1), n=n)
   534	        if not ok:
   535	            self.stats.capture_failures += 1
   536	            self._fail_task(t, ctx, "capture verification failed")
   537	            return 0.0, 0.0
   538	        self._infer_orientation(depth, est.pose.theta, ctx)
   539	        cube = ctx.cube(self.task.color)
   540	        p0 = cube.xy()
   541	        p1 = np.array(self.leg.cube_end, float)
   542	        if np.linalg.norm(p1 - p0) < 5.0:
   543	            self._go(S.MEASURE, t, ctx, "leg already complete")
   544	            return 0.0, 0.0
   545	        phi_new = math.atan2(*(p1 - p0)[::-1])
   546	        if abs(angle_diff(phi_new, est.pose.theta)) > math.radians(self.p.push_line_recommit_deg):
   547	            # The actual push line differs from the reserved one: re-validate the corridor.
   548	            region = ctx.manipulation_region(self.id, est.pose, est.pose.theta, float(np.linalg.norm(p1 - p0)))
   549	            if not ctx.commit_region(self.id, region):
   550	                return 0.0, 0.0                      # hold (engaged) until granted; verify timeout path above
   551	            if abs(angle_diff(phi_new, est.pose.theta)) > math.radians(25):
   552	                self._fail_task(t, ctx, "push line changed too much")
   553	                return 0.0, 0.0
   554	        self.push_line = (p0, p1)
   555	        self.pusher.reset((float(p0[0]), float(p0[1])), (float(p1[0]), float(p1[1])))
   556	        self.push_budget = self.p.push_timeout_factor * (np.linalg.norm(p1 - p0) / self.cfg.limits.v_push) + 6.0
   557	        self.last_seen_push = t
   558	        ctx.set_cube_pushed(self.task.color, True)
   559	        self._go(S.PUSH, t, ctx)
   560	        return 0.0, 0.0
   561	
   562	    def _s_push(self, t, est, safe, ctx):
   563	        if self.dwell(t) > self.push_budget:
   564	            self._fail_task(t, ctx, "push timeout")
   565	            return 0.0, 0.0
   566	        obs = ctx.fresh_cube(self.task.color, t - 0.25)
   567	        if obs is not None:
   568	            self.last_seen_push = t
   569	        blind = t - self.last_seen_push
   570	        if blind > self.p.push_blind_fail_s:
   571	            self._fail_task(t, ctx, "cube unseen during push")
   572	            return 0.0, 0.0
   573	        if blind > self.p.push_blind_hold_s:
   574	            return 0.0, 0.0                          # hold still until the cube is seen again
   575	        cube_xy = (float(obs[0][0]), float(obs[0][1])) if obs else None
   576	        v, w, done, status = self.pusher.step(est, cube_xy, 0.0 if obs else 99.0, t)
   577	        self.stats.push_cross_track.append(abs(status.cross_mm))
   578	        if status.lost_cube:
   579	            self.stats.capture_failures += 1
