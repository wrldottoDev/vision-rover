+def point_inside_convex(poly, point):
+    # Independent containment oracle, not production shapes.point_in.
+    signs = []
+    for a, b in zip(poly, np.roll(poly, -1, axis=0)):
+        edge, rel = b - a, np.asarray(point) - a
