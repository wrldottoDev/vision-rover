   350	# --------------------------------------------------------------------------------------- CaptureController
   351	class CaptureController:
   352	    """Slow straight advance at `config.limits.v_capture` along the push line from the pre-push pose,
   353	    with the same closed-loop line tracking as SegmentFollower, until the given travel distance
   354	    (prepush_distance - contact_distance, plus a small caller-supplied overdrive) has been covered."""
   355	
   356	    def __init__(self, cfg: Config = DEFAULT, params: NavParams = NavParams()):
   357	        self.cfg = cfg
   358	        self.params = params
   359	        self._line = _LineHold(params, params.line_wn, params.line_zeta, cfg.limits.w_fine)
   360	        self._travel = 0.0
   361	        self._last: tuple[float, float, float] = (0.0, 0.0, 0.0)
   362	
   363	    def reset(self, line_p0: tuple[float, float], phi: float, travel_mm: float) -> None:
   364	        self._line.reset(_Line(line_p0, phi, reverse=False))
   365	        self._travel = travel_mm
   366	        self._last = (0.0, 0.0, 0.0)
   367	
   368	    def step(self, est: RoverEstimate, t: float) -> tuple[float, float, bool]:
   369	        pose = est.pose
   370	        along, cross, e_h = self._line.errors(pose)
   371	        self._last = (along, cross, e_h)
   372	        if along >= self._travel:
   373	            return 0.0, 0.0, True
   374	        v = self.cfg.limits.v_capture
   375	        omega = self._line.omega(e_h, cross, v)
   376	        return v, omega, False
   377	
   378	    def tracking_error(self) -> tuple[float, float, float]:
   379	        return self._last
