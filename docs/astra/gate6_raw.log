   664	                    self.task.budget_used = max(0.0, self.task.budget_used - 1.0)   # verified progress
   665	                self._replan(t, ctx)
   666	        else:
   667	            self._go(S.IDLE, t, ctx)
   668	        return 0.0, 0.0
   669	
   670	    def _s_confirm(self, t, est, safe, ctx):
   671	        """Post-retreat confirmation that the cube is still (completely) in the depot."""
   672	        if self.dwell(t) < self.p.verify_s:
   673	            return 0.0, 0.0
