   120	def test_pid_reset_clears_state():
   121	    pid = PID(kp=1.0, ki=1.0, kd=1.0)
   122	    pid.step(1.0, 0.0, 0.02)
   123	    pid.step(1.0, 0.2, 0.02)
   124	    pid.reset()
   125	    assert pid._integral == 0.0 and pid._prev_meas is None and pid._d_filt == 0.0
