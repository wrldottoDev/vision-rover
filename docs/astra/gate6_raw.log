   168	def test_straight_forward_converges_from_offset():
   169	    rover = TruthRover(x=0.0, y=20.0, theta=math.radians(10), rng=np.random.default_rng(3))
   170	    seg = Segment(SegKind.STRAIGHT, Pose(0, 0, 0.0), Pose(500, 0, 0.0), reverse=False)
   171	    sf, log = run_segment(seg, rover, max_ticks=4000)
   172	
   173	    # Bound: P(D)-only line tracking (no integral, matching the spec's control law) leaves a small
   174	    # steady-state cross-track offset under a persistent L/R gain asymmetry (analytically ~3.6 mm here:
   175	    # disturbance omega_bias = (GAIN_R-GAIN_L)*v/track / ((GAIN_R+GAIN_L)/2), nulled via k_y*e_y_ss),
   176	    # plus vision-noise jitter (pos sigma 1.5 mm) riding on top -- 9 mm is a realistic, not a chased-zero,
   177	    # bound and is well inside the ~16 mm worst-case capture slack (G5).
   178	    crosses = [row[6][1] for row in log]
   179	    tail = crosses[len(crosses) // 2:]     # after the first half of the run, should be well converged
   180	    assert max(abs(c) for c in tail) < 9.0, f"cross-track not converged: {max(abs(c) for c in tail)} mm"
   181	    assert abs(rover.y) < 10.0
   182	    assert rover.x > 490.0    # actually reached the end (no premature stop / stall)
