   587	    def _s_measure(self, t, est, safe, ctx):
   588	        """End of a leg: measure contact geometry (orientation belief), then continue."""
   589	        if self.dwell(t) < self.p.verify_s:
   590	            return 0.0, 0.0
   591	        m = self._contact(est, self.t_enter + self.p.verify_s * 0.5, ctx)
   592	        if m is None and self.dwell(t) < self.p.verify_timeout_s:
   593	            return 0.0, 0.0
   594	        if m is not None:
   595	            self._infer_orientation(m[0], est.pose.theta, ctx)
   596	        final = self.task.leg == len(self.task.plan.legs) - 1
   597	        if final:
   598	            self._go(S.VERIFY_DELIVERY, t, ctx)
   599	        else:
   600	            self._begin_retreat(t, ctx, "next_leg")
   601	        return 0.0, 0.0
   602	
   603	    def _s_verify_delivery(self, t, est, safe, ctx):
   604	        if self.dwell(t) < self.p.verify_s:
   605	            return 0.0, 0.0
   606	        if ctx.is_delivered(self.task.color, self.t_enter, t):
   607	            self._begin_retreat(t, ctx, "delivered")
   608	            return 0.0, 0.0
   609	        if self.dwell(t) < self.p.verify_timeout_s:
   610	            return 0.0, 0.0
   611	        self.task.delivery_attempts += 1
   612	        obs = ctx.fresh_cube(self.task.color, t - 0.6)
   613	        if obs is not None and self.task.delivery_attempts <= self.p.delivery_retries:
   614	            dp = np.array(self.task.plan.delivery_point) - obs[0]
   615	            ahead = float(np.dot(dp, est.pose.forward()))
   616	            lateral = abs(float(np.dot(dp, [-math.sin(est.pose.theta), math.cos(est.pose.theta)])))
   617	            xl, yl = est.pose.to_local(float(obs[0][0]), float(obs[0][1]))
   618	            if 2.0 < ahead < 40.0 and lateral < 8.0 and self._fits_channel(xl - self.cfg.rover.x_front_plate, yl):
   619	                # corrective push straight ahead (inside the committed corridor), no new line
   620	                target = obs[0] + ahead * est.pose.forward()
   621	                self.pusher.reset((float(obs[0][0]), float(obs[0][1])), (float(target[0]), float(target[1])))
   622	                self.push_budget = 8.0
   623	                self.last_seen_push = t
   624	                self._go(S.PUSH, t, ctx, "corrective push")
   625	                return 0.0, 0.0
   626	        self._fail_task(t, ctx, "delivery not confirmed")
   627	        return 0.0, 0.0
   628	
   629	    def _s_retreat(self, t, est, safe, ctx):
   630	        if self.retreat_start is None:
   631	            self.retreat_start = est.pose
   632	        back = -float(np.dot(est.pose.xy() - self.retreat_start.xy(), self.retreat_start.forward()))
   633	        remaining = self.retreat_distance - back
   634	        if remaining <= 3.0:
   635	            return self._after_retreat(t, ctx)
   636	        target = self.task.color if self.task else None
   637	        if not ctx.retreat_clear(self.id, est.pose, remaining, target):
   638	            self.retreat_blocked_since = self.retreat_blocked_since or t
   639	            if t - self.retreat_blocked_since > self.p.retreat_blocked_fail_s:
   640	                ctx.log(self.id, "retreat_blocked")
   641	                self.retreat_blocked_since = t
   642	                if self.task:
   643	                    self.task.budget_used += 1.0
   644	            return 0.0, 0.0                          # hold (still engaged); supervisor may move the other rover
   645	        self.retreat_blocked_since = None
   646	        if self.dwell(t) > self.p.retreat_timeout_s:
   647	            ctx.log(self.id, "retreat_slow", back=round(back, 1))
   648	            self.t_enter = t                          # keep trying; engagement is NOT cleared by a timeout
   649	        v, w, done = self.retreat.step(est, t)
   650	        return (v, w) if not done else (-self.cfg.limits.v_capture, 0.0)
   651	
   652	    def _after_retreat(self, t, ctx):
   653	        self.engaged = False
   654	        a = self.after_retreat
   655	        if a == "delivered" and self.task:
   656	            self._go(S.CONFIRM, t, ctx)
   657	        elif a in ("next_leg", "replan") and self.task:
   658	            if self.task.budget_used >= self.p.task_budget or t - self.task.t_start > self.p.task_time_budget_s:
   659	                ctx.release_task(self.id, self.task.color, failed=True, t=t)
