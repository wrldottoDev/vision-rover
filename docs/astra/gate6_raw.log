    90	def line_gains(v_mag: float, wn: float, zeta: float, v_floor: float) -> tuple[float, float]:
    91	    """k_h, k_y for the critically-damped (by default) line-tracking law at speed magnitude `v_mag`."""
    92	    v = max(abs(v_mag), v_floor)
    93	    return 2.0 * zeta * wn, (wn * wn) / v
