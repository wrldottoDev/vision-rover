   118	@dataclass
   119	class _Line:
   120	    """A straight reference line from p0 in direction `path_dir`, optionally driven in reverse."""
   121	
   122	    p0: tuple[float, float]
   123	    path_dir: float
   124	    reverse: bool = False
   125	
   126	    @property
   127	    def reference_heading(self) -> float:
   128	        return wrap(self.path_dir + math.pi) if self.reverse else self.path_dir
   129	
   130	    def errors(self, x: float, y: float, theta: float) -> tuple[float, float, float]:
   131	        """-> (along, cross[left+], heading_error) at world point (x, y, theta)."""
   132	        ref = Pose(self.p0[0], self.p0[1], self.path_dir)
   133	        along, cross = ref.to_local(x, y)
   134	        e_h = angle_diff(theta, self.reference_heading)
   135	        return along, cross, e_h
   136	
   137	    @staticmethod
   138	    def through(p0: tuple[float, float], p1: tuple[float, float], reverse: bool = False) -> "_Line":
   139	        return _Line(p0, math.atan2(p1[1] - p0[1], p1[0] - p0[0]), reverse)
