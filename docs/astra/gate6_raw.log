   390	
   391	class PushController:
   392	    """Pushes the cube along line L = (p0 -> p1).  Controls the CUBE's position (rover pose plus
   393	    `config.contact_distance` along heading, optionally fused with fresh vision), not just the rover:
   394	    cross-track error `e_y` is measured on that cube estimate, heading error `e_h` on the rover (cube
   395	    orientation is not reliably observable -- interpretation_v0 C4).
   396	
   397	    Control law: omega = -(K_h*e_h + K_hd*e_h') - (K_y*e_y + K_yd*e_y'), all terms saturated and rate
   398	    terms taken analytically rather than by differentiating noisy positions:
   399	      * e_h' = est.omega  -- the EKF already fuses this from vision + the motion model, so
   400	        finite-differencing our own heading error would just reinject noise the estimator already
   401	        filtered out.
   402	      * e_y' = est.v*sin(e_h) + contact_distance*est.omega*cos(e_h)  -- exact kinematic derivative of a
   403	        point rigidly offset `contact_distance` ahead of the rover (first term: translation of the
   404	        rover; second: the offset arm sweeping sideways as the rover yaws). Cheap, analytic, and immune
   405	        to the ~2-5 mm/frame vision jitter that a raw d(e_y)/dt would amplify by 1/dt.
   406	
   407	    Push-stability / curvature limit.  A paddle keeps the cube captured through geometric contact plus a
   408	    few mm of slack (G5), not a rigid joint: if the rover yaws quickly, the contact point (the arm above)
   409	    sweeps sideways at `omega*contact_distance`, and once that sideways sweep outruns what the slack can
   410	    absorb the cube slips or is left behind. Bounding the path curvature kappa = omega/v <= push_curv_max
   411	    keeps the turn radius >= 1/push_curv_max (400 mm with the default), independent of speed, which is
   412	    the "does not turn faster than the cube can follow" constraint. omega is clamped to
   413	    push_curv_max * v on every tick in addition to the analytic-PD saturation.
   414	
   415	    Cross-track deadband: the cube has lateral slack inside the channel (G5: capture tolerance up to
   416	    ~4-17 mm depending on orientation), so a small dead zone on e_y before it drives omega prevents
   417	    chattering the rover heading to chase sub-slack cube wobble.
   418	
   419	    Speed schedule: capture speed floor while still moving (never below `v_capture`, which clears the
   420	    motor deadband) ramped up (accel-limited) to `v_push` cruise, dropped to `v_push_slow` inside
   421	    `push_slow_zone` mm of the goal, then an abrupt stop. The stop is triggered predictively: once the
   422	    cube's estimated along-track position PLUS the extra distance it will coast during the ~0.1 s motor
   423	    +command lag (`v * push_stop_lag_s`) reaches the goal, so the realised stopping position -- not the
   424	    command -- lands at p1.
   425	    """
   426	
   427	    def __init__(self, cfg: Config = DEFAULT, params: NavParams = NavParams()):
   428	        self.cfg = cfg
   429	        self.params = params
   430	        self.line: _Line | None = None
   431	        self._length = 0.0
   432	        self._status = PushStatus(0.0, 0.0, 0.0, False)
   433	
   434	    def reset(self, p0: tuple[float, float], p1: tuple[float, float]) -> None:
   435	        self.line = _Line.through(p0, p1, reverse=False)
   436	        self._length = math.hypot(p1[0] - p0[0], p1[1] - p0[1])
   437	        self._status = PushStatus(0.0, 0.0, 0.0, False)
   438	
   439	    def _cube_estimate(self, est: RoverEstimate, cube_xy: tuple[float, float] | None,
   440	                        cube_age_s: float) -> tuple[float, float]:
   441	        pose = est.pose
   442	        cd = self.cfg.contact_distance
   443	        dead_reckon = (pose.x + cd * math.cos(pose.theta), pose.y + cd * math.sin(pose.theta))
   444	        if cube_xy is not None and cube_age_s <= self.cfg.telemetry.cube_fresh_s:
   445	            w = self.params.push_vision_weight
   446	            return (w * cube_xy[0] + (1 - w) * dead_reckon[0],
   447	                    w * cube_xy[1] + (1 - w) * dead_reckon[1])
   448	        return dead_reckon
   449	
   450	    def _lost_cube(self, est: RoverEstimate, cube_xy: tuple[float, float] | None, cube_age_s: float) -> bool:
   451	        if cube_xy is None or cube_age_s > self.cfg.telemetry.cube_fresh_s:
   452	            return False
   453	        pose = est.pose
   454	        along_local, lat_local = pose.to_local(cube_xy[0], cube_xy[1])
   455	        gap = abs(along_local - self.cfg.contact_distance)
   456	        return abs(lat_local) > self.params.push_lost_lateral or gap > self.params.push_lost_gap
   457	
   458	    def step(self, est: RoverEstimate, cube_xy: tuple[float, float] | None, cube_age_s: float,
   459	              t: float) -> tuple[float, float, bool, PushStatus]:
   460	        assert self.line is not None
   461	        pose = est.pose
   462	        cube_x, cube_y = self._cube_estimate(est, cube_xy, cube_age_s)
   463	        cube_along, cube_cross, _ = self.line.errors(cube_x, cube_y, pose.theta)
   464	        _, _, e_h = self.line.errors(pose.x, pose.y, pose.theta)
   465	        lost = self._lost_cube(est, cube_xy, cube_age_s)
   466	        self._status = PushStatus(cube_along, cube_cross, e_h, lost)
   467	
   468	        remaining = self._length - cube_along
   469	        predicted_stop = cube_along + est.v * self.params.push_stop_lag_s
   470	        if predicted_stop >= self._length - self.params.push_stop_tol:
   471	            return 0.0, 0.0, True, self._status
   472	
   473	        v_cap = self.cfg.limits.v_push if remaining > self.params.push_slow_zone else self.cfg.limits.v_push_slow
   474	        v_ramp = _decel_speed(max(cube_along, 0.0), self.params.accel, v_cap)
   475	        v = max(self.cfg.limits.v_capture, v_ramp)
   476	
   477	        e_y = cube_cross
   478	        if abs(e_y) <= self.params.push_cross_deadband:
   479	            e_y_eff = 0.0
   480	        else:
   481	            e_y_eff = e_y - math.copysign(self.params.push_cross_deadband, e_y)
   482	
   483	        e_h_dot = est.omega
   484	        e_y_dot = est.v * math.sin(e_h) + self.cfg.contact_distance * est.omega * math.cos(e_h)
   485	        k_h, k_y = line_gains(v, self.params.push_wn, self.params.push_zeta, self.params.line_v_gain_floor)
   486	        omega = -(k_h * e_h + self.params.push_hdot_gain * e_h_dot) \
   487	                - (k_y * e_y_eff + self.params.push_ydot_gain * e_y_dot)
   488	
   489	        omega_cap = min(self.cfg.limits.w_fine, self.params.push_curv_max * max(v, 1.0))
   490	        omega = max(-omega_cap, min(omega_cap, omega))
   491	        return v, omega, False, self._status
   492	
   493	    def status(self) -> PushStatus:
   494	        return self._status
   495	
