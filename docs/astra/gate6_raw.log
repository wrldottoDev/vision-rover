    46	        d_meas = 0.0 if self._prev_meas is None else (measurement - self._prev_meas) / dt
    47	        alpha = dt / (self.d_tau + dt)
    48	        self._d_filt += alpha * (d_meas - self._d_filt)
    49	        self._prev_meas = measurement
    50	
    51	        # Conditional-integration anti-windup: evaluate saturation using the OLD integral, then
    52	        # only fold this step's contribution in if that doesn't drive further into saturation.
    53	        u_before = self.kp * error + self.ki * self._integral - self.kd * self._d_filt
    54	        pushing_high = u_before >= self.out_max and error > 0.0
    55	        pushing_low = u_before <= self.out_min and error < 0.0
    56	        if not (pushing_high or pushing_low):
    57	            self._integral += error * dt
    58	
    59	        u = self.kp * error + self.ki * self._integral - self.kd * self._d_filt
    60	        return max(self.out_min, min(self.out_max, u))
