   270	    _ROTATE, _NUDGE_TURN, _NUDGE_DRIVE, _NUDGE_BACK, _DONE = (
   271	        "rotating", "nudge_turn", "nudge_drive", "nudge_back", "done")
   272	
   273	    def __init__(self, cfg: Config = DEFAULT, params: NavParams = NavParams()):
   274	        self.cfg = cfg
   275	        self.params = params
   276	        self._rotate = _RotateHold(params, params.align_tol, cfg.limits.w_fine)
   277	        self.line: _Line | None = None
   278	        self._phi = 0.0
   279	        self._phase = self._ROTATE
   280	        self._nudge_count = 0
   281	        self._nudge_target: float | None = None
   282	        self._nudge_start: tuple[float, float] | None = None
   283	        self._last_t: float | None = None
   284	
   285	    def reset(self, line_point: tuple[float, float], phi: float) -> None:
   286	        self.line = _Line(line_point, phi, reverse=False)
   287	        self._phi = phi
   288	        self._phase = self._ROTATE
   289	        self._nudge_count = 0
   290	        self._nudge_target = None
   291	        self._nudge_start = None
   292	        self._last_t = None
   293	        self._rotate.reset(phi)
   294	
   295	    def _dt(self, t: float) -> float:
   296	        dt = 1.0 / 30.0 if self._last_t is None else max(t - self._last_t, 1e-6)
   297	        self._last_t = t
   298	        return dt
   299	
   300	    def step(self, est: RoverEstimate, t: float) -> tuple[float, float, bool, str]:
   301	        assert self.line is not None
   302	        dt = self._dt(t)
   303	        pose = est.pose
   304	
   305	        if self._phase == self._ROTATE:
   306	            omega, done = self._rotate.step(pose.theta, est.omega, dt)
   307	            if not done:
   308	                return 0.0, omega, False, self._phase
   309	            _, cross, _ = self.line.errors(pose.x, pose.y, pose.theta)
   310	            if abs(cross) <= self.params.align_lateral_tol or self._nudge_count >= self.params.align_max_nudges:
   311	                self._phase = self._DONE
   312	                return 0.0, 0.0, True, self._phase
   313	            delta = math.asin(max(-1.0, min(1.0, -cross / self.params.align_nudge_distance)))
   314	            delta = max(-self.params.align_nudge_max_angle, min(self.params.align_nudge_max_angle, delta))
   315	            self._nudge_target = wrap(self._phi + delta)
   316	            self._rotate.reset(self._nudge_target)
   317	            self._phase = self._NUDGE_TURN
   318	            return 0.0, 0.0, False, self._phase
   319	
   320	        if self._phase == self._NUDGE_TURN:
   321	            omega, done = self._rotate.step(pose.theta, est.omega, dt)
   322	            if not done:
   323	                return 0.0, omega, False, self._phase
   324	            self._nudge_start = (pose.x, pose.y)
   325	            self._phase = self._NUDGE_DRIVE
   326	            return 0.0, 0.0, False, self._phase
   327	
   328	        if self._phase == self._NUDGE_DRIVE:
   329	            assert self._nudge_start is not None
   330	            dx, dy = pose.x - self._nudge_start[0], pose.y - self._nudge_start[1]
   331	            travelled = math.hypot(dx, dy)
   332	            if travelled >= self.params.align_nudge_distance:
   333	                self._nudge_count += 1
   334	                self._rotate.reset(self._phi)
   335	                self._phase = self._NUDGE_BACK
   336	                return 0.0, 0.0, False, self._phase
   337	            return self.cfg.limits.v_capture, 0.0, False, self._phase
   338	
   339	        if self._phase == self._NUDGE_BACK:
   340	            omega, done = self._rotate.step(pose.theta, est.omega, dt)
   341	            if not done:
   342	                return 0.0, omega, False, self._phase
   343	            self._phase = self._ROTATE
   344	            self._rotate.reset(self._phi)
   345	            return 0.0, 0.0, False, self._phase
   346	
   347	        return 0.0, 0.0, True, self._DONE
   348	
