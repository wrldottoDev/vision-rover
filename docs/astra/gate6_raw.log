+@pytest.mark.parametrize("latency", [.05, .15])
+def test_capture_settled_stop_accuracy(latency):
+    rover = WheelTruth(latency=latency, seed=6)
+    travel = C.prepush_distance - 77 + 6
+    cc = CaptureController()
+    cc.reset((0, 0), 0, travel)
