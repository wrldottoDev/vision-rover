   142	class _RotateHold:
   143	    """In-place rotation to a target heading: PID(P,I,D) on the unwrapped heading, plus a minimum
   144	    |omega| kick to clear the motor deadband, settled after N consecutive in-tolerance ticks with the
   145	    estimator reporting near-zero angular rate (so we don't declare done mid-overshoot)."""
   146	
   147	    def __init__(self, params: NavParams, tol: float, omega_cap: float):
   148	        self.params = params
   149	        self.tol = tol
   150	        self.omega_cap = omega_cap
   151	        self.pid = PID(params.rotate_kp, params.rotate_ki, params.rotate_kd,
   152	                        out_min=-omega_cap, out_max=omega_cap)
   153	        self._target_unw: float | None = None
   154	        self._unw: _AngleUnwrapper | None = None
   155	        self._settle_count = 0
   156	
   157	    def reset(self, target_theta: float) -> None:
   158	        self._target_final = target_theta
   159	        self._target_unw = None
   160	        self._unw = None
   161	        self._settle_count = 0
   162	        self.pid.reset()
   163	
   164	    def step(self, theta: float, omega_est: float, dt: float) -> tuple[float, bool]:
   165	        if self._unw is None:
   166	            self._unw = _AngleUnwrapper(theta)
   167	            self._target_unw = self._unw.value + angle_diff(self._target_final, wrap(theta))
   168	        theta_unw = self._unw.push(theta)
   169	        err = angle_diff(self._target_final, wrap(theta))
   170	        omega = self.pid.step(setpoint=self._target_unw, measurement=theta_unw, dt=dt)
   171	        if 0.0 < abs(omega) < self.params.rotate_omega_deadband and abs(err) > self.tol:
   172	            omega = math.copysign(self.params.rotate_omega_deadband, omega)
   173	        if abs(err) < self.tol and abs(omega_est) < self.params.rotate_omega_settle:
   174	            self._settle_count += 1
   175	        else:
   176	            self._settle_count = 0
   177	        return omega, self._settle_count >= self.params.rotate_settle_ticks
