     1	"""Small, generic PID controller.
     2	
     3	Used for every closed loop in controllers.py (heading hold, cross-track, etc.). Features:
     4	
     5	- Output saturation (`out_min`/`out_max`).
     6	- Conditional-integration anti-windup: the integral is only advanced when doing so would NOT push
     7	  an already-saturated output further into saturation.  This is simpler and cheaper than back-
     8	  calculation and is exact for our use (no external actuator model available at this layer).
     9	- Derivative-on-measurement with a first-order low-pass filter: differentiating the measurement
    10	  instead of the error avoids a derivative kick when the setpoint jumps, and the low-pass filter
    11	  (time constant `d_tau`) keeps vision/EKF pose noise from being amplified by the 1/dt of a raw
    12	  finite difference.
    13	
    14	Units are whatever the caller uses; the controller itself is dimensionless plumbing.
    15	"""
    16	from __future__ import annotations
    17	
    18	from dataclasses import dataclass, field
    19	
    20	
    21	@dataclass
    22	class PID:
    23	    kp: float
    24	    ki: float
    25	    kd: float
    26	    out_min: float = float("-inf")
    27	    out_max: float = float("inf")
    28	    d_tau: float = 0.05   # s, derivative low-pass filter time constant. TUNED: below the ~0.1 s motor
    29	                          # lag so it filters sensor noise without adding much extra phase lag.
    30	
    31	    _integral: float = field(default=0.0, init=False, repr=False)
    32	    _prev_meas: float | None = field(default=None, init=False, repr=False)
    33	    _d_filt: float = field(default=0.0, init=False, repr=False)
    34	
    35	    def reset(self) -> None:
    36	        """Clear all internal state (call whenever the setpoint context changes discontinuously)."""
    37	        self._integral = 0.0
    38	        self._prev_meas = None
    39	        self._d_filt = 0.0
    40	
    41	    def step(self, setpoint: float, measurement: float, dt: float) -> float:
    42	        dt = max(dt, 1e-9)
    43	        error = setpoint - measurement
    44	
    45	        # Derivative on measurement, low-pass filtered.
    46	        d_meas = 0.0 if self._prev_meas is None else (measurement - self._prev_meas) / dt
    47	        alpha = dt / (self.d_tau + dt)
    48	        self._d_filt += alpha * (d_meas - self._d_filt)
    49	        self._prev_meas = measurement
    50	
    51	        # Conditional-integration anti-windup: evaluate saturation using the OLD integral, then
    52	        # only fold this step's contribution in if that doesn't drive further into saturation.
    53	        u_before = self.kp * error + self.ki * self._integral - self.kd * self._d_filt
    54	        pushing_high = u_before >= self.out_max and error > 0.0
    55	        pushing_low = u_before <= self.out_min and error < 0.0
    56	        if not (pushing_high or pushing_low):
    57	            self._integral += error * dt
    58	
    59	        u = self.kp * error + self.ki * self._integral - self.kd * self._d_filt
    60	        return max(self.out_min, min(self.out_max, u))
    61	
