   107	def test_pid_anti_windup_no_divergence():
   108	    """With a permanently unreachable setpoint (error stays huge and positive the whole run), naive
   109	    integration would grow `_integral` without bound; conditional-integration anti-windup must freeze
   110	    it as soon as the output saturates in the same direction the error is pushing."""
   111	    pid = PID(kp=1.0, ki=2.0, kd=0.0, out_min=-1.0, out_max=1.0)
   112	    x = 0.0
   113	    for _ in range(1000):
   114	        u = pid.step(setpoint=1000.0, measurement=x, dt=0.02)
   115	        assert -1.0 <= u <= 1.0
   116	        x += u * 0.02 * 0.1     # plant barely responds -> setpoint permanently unreachable
   117	    assert abs(pid._integral) < 1e-9, f"integral wound up despite permanent saturation: {pid._integral}"
   118	
