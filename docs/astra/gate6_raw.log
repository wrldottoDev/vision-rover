    36	class TruthRover:
    37	    def __init__(self, x=0.0, y=0.0, theta=0.0, rng=None, vmax=220.0):
    38	        self.x, self.y, self.theta = x, y, theta
    39	        self.vl = self.vr = 0.0
    40	        self.v = self.omega = 0.0
    41	        self.vmax = vmax
    42	        self.rng = rng if rng is not None else np.random.default_rng(0)
    43	        self.t = 0.0
    44	        self._hist: list[tuple] = [(0.0, x, y, theta, 0.0, 0.0)]
    45	
    46	    def command(self, v: float, omega: float, dt: float) -> None:
    47	        wc = WheelCommand.from_unicycle(v, omega, TRACK, self.vmax)
    48	        tl, tr = wc.v_left, wc.v_right
    49	        if abs(tl) < DEADBAND:
    50	            tl = 0.0
    51	        if abs(tr) < DEADBAND:
    52	            tr = 0.0
    53	        tl *= GAIN_L
    54	        tr *= GAIN_R
    55	        a = min(1.0, dt / LAG_TAU)
    56	        self.vl += (tl - self.vl) * a
    57	        self.vr += (tr - self.vr) * a
    58	        self.v = (self.vl + self.vr) / 2.0
    59	        self.omega = (self.vr - self.vl) / TRACK
    60	        self.x += self.v * math.cos(self.theta) * dt
    61	        self.y += self.v * math.sin(self.theta) * dt
    62	        self.theta = wrap(self.theta + self.omega * dt)
    63	        self.t += dt
    64	        self._hist.append((self.t, self.x, self.y, self.theta, self.v, self.omega))
    65	        while len(self._hist) > 2 and self._hist[1][0] < self.t - 1.0:
    66	            self._hist.pop(0)
    67	
    68	    def estimate(self) -> RoverEstimate:
    69	        t_query = self.t - LATENCY_S
    70	        row = self._hist[0]
    71	        for h in self._hist:
    72	            if h[0] >= t_query:
    73	                row = h
    74	                break
    75	            row = h
    76	        _, x, y, th, v, om = row
    77	        x += self.rng.normal(0, POS_NOISE_STD)
    78	        y += self.rng.normal(0, POS_NOISE_STD)
    79	        th = wrap(th + self.rng.normal(0, HEAD_NOISE_STD))
    80	        return RoverEstimate(id=0, pose=Pose(x, y, th), v=v, omega=om)
    81	
    82	
    83	def run_segment(seg: Segment, rover: TruthRover, max_ticks: int = 4000, dt: float = DT):
    84	    sf = SegmentFollower()
    85	    sf.reset(seg)
    86	    log = []
    87	    for i in range(max_ticks):
    88	        est = rover.estimate()
    89	        v, w, done = sf.step(est, rover.t)
    90	        log.append((rover.t, rover.x, rover.y, rover.theta, v, w, sf.tracking_error()))
    91	        if done:
    92	            break
    93	        rover.command(v, w, dt)
    94	    else:
    95	        pytest.fail("segment did not finish within max_ticks")
    96	    return sf, log
