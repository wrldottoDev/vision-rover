   497	# --------------------------------------------------------------------------------------- RetreatController
   498	class RetreatController:
   499	    """Reverses straight `distance_mm` along the heading held at reset/first tick, with heading-hold
   500	    (reusing the same line-tracking law so small drift is corrected, not just heading error)."""
   501	
   502	    def __init__(self, cfg: Config = DEFAULT, params: NavParams = NavParams()):
   503	        self.cfg = cfg
   504	        self.params = params
   505	        self._line = _LineHold(params, params.line_wn, params.line_zeta, cfg.limits.w_fine)
   506	        self._distance = 0.0
   507	        self._armed = False
   508	
   509	    def reset(self, distance_mm: float) -> None:
   510	        self._distance = distance_mm
   511	        self._armed = False
   512	
   513	    def step(self, est: RoverEstimate, t: float) -> tuple[float, float, bool]:
   514	        pose = est.pose
   515	        if not self._armed:
   516	            # `_Line.path_dir` is the geometric direction of TRAVEL, not the nose heading -- since we
   517	            # drive backward, travel direction is the reverse of the heading being held.
   518	            self._line.reset(_Line((pose.x, pose.y), wrap(pose.theta + math.pi), reverse=True))
   519	            self._armed = True
   520	
   521	        along, cross, e_h = self._line.errors(pose)
   522	        remaining = self._distance - along
   523	        if remaining <= self.params.line_along_tol:
   524	            return 0.0, 0.0, True
   525	        v_cap = self.cfg.limits.v_retreat
   526	        v_mag = max(self.params.v_min_moving,
   527	                    min(_decel_speed(remaining, self.params.accel, v_cap),
   528	                        _decel_speed(max(along, 0.0), self.params.accel, v_cap)))
   529	        omega = self._line.omega(e_h, cross, v_mag)
   530	        return -v_mag, omega, False

