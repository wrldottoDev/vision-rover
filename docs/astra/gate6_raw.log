   204	class SegmentFollower:
   205	    """Follows one `world.Segment` (ROTATE in place, or STRAIGHT forward/reverse with closed-loop line
   206	    tracking and an accel-limited, overshoot-free stopping profile)."""
   207	
   208	    def __init__(self, cfg: Config = DEFAULT, params: NavParams = NavParams()):
   209	        self.cfg = cfg
   210	        self.params = params
   211	        self._rotate = _RotateHold(params, params.rotate_tol, cfg.limits.w_nav)
   212	        self._line = _LineHold(params, params.line_wn, params.line_zeta, cfg.limits.w_nav)
   213	        self.seg: Segment | None = None
   214	        self._last_along = 0.0
   215	        self._last_cross = 0.0
   216	        self._last_heading = 0.0
   217	        self._last_t: float | None = None
   218	
   219	    def reset(self, seg: Segment) -> None:
   220	        self.seg = seg
   221	        self._last_along = self._last_cross = self._last_heading = 0.0
   222	        self._last_t = None
   223	        if seg.kind is SegKind.ROTATE:
   224	            self._rotate.reset(seg.end.theta)
   225	        else:
   226	            line = _Line.through((seg.start.x, seg.start.y), (seg.end.x, seg.end.y), reverse=seg.reverse)
