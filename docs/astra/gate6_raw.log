   102	# --------------------------------------------------------------------------------------- helpers
   103	class _AngleUnwrapper:
   104	    """Turns a wrapped (+-pi) angle stream into a continuous scalar, so plain PID math and its
   105	    derivative-on-measurement filter work correctly across the +-pi seam instead of seeing a spurious
   106	    jump of ~2*pi."""
   107	
   108	    def __init__(self, initial: float):
   109	        self.value = initial
   110	        self._last_wrapped = wrap(initial)
   111	
   112	    def push(self, angle: float) -> float:
   113	        self.value += angle_diff(angle, self._last_wrapped)
   114	        self._last_wrapped = wrap(angle)
   115	        return self.value
