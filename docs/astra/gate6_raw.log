   142	
   143	    # Overshoot: once the error first crosses zero, it must not swing back out past a small bound.
   144	    crossed = False
   145	    overshoot = 0.0
   146	    for e in errs:
   147	        if not crossed and abs(e) < math.radians(2.0):
