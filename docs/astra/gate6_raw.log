    25	
    26	TRACK = C.rover.track_width      # 89 mm
    27	DT = 0.02                        # 50 Hz control loop
    28	LATENCY_S = 0.10                 # s, overhead-vision + EKF latency
    29	LAG_TAU = 0.10                   # s, motor first-order speed lag
    30	DEADBAND = 15.0                  # mm/s, per-wheel motor deadband
    31	GAIN_L, GAIN_R = 0.9, 1.0        # 10% L/R gain asymmetry
    32	POS_NOISE_STD = 1.5              # mm, 1-sigma pose noise
    33	HEAD_NOISE_STD = math.radians(1.0)
    34	
