   129	    res.non_target_contacts = wc.get("non_target_contact", 0)
   130	    res.rover_exits = wc.get("rover_exit", 0)
   131	    res.falls = wc.get("rover_fell", 0)
   132	    res.cube_exits = wc.get("cube_exit", 0)
