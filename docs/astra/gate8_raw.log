     1	"""Monte Carlo driver: run many seeded scenarios in parallel processes, classify outcomes, aggregate metrics,
     2	save every failing seed for deterministic reproduction.
     3	
     4	Usage:  python -m rover_strategy.simulation.monte_carlo --n 1000 --family start_zone --out runs/mc_dev
     5	        python -m rover_strategy.simulation.monte_carlo --seeds 17,523 --family hard --verbose
     6	"""
     7	from __future__ import annotations
     8	
     9	import argparse
    10	import json
    11	import os
    12	import statistics
    13	import time
    14	from collections import Counter
    15	from concurrent.futures import ProcessPoolExecutor
    16	from dataclasses import asdict
    17	
    18	from .runner import RunResult, run_seed
    19	
    20	SAFETY_KEYS = ("rover_rover_collisions", "non_target_contacts", "rover_exits", "falls")
    21	
    22	
    23	def _work(args):
    24	    seed, family, max_time = args
    25	    try:
    26	        return asdict(run_seed(seed, family, max_time=max_time))
    27	    except Exception as exc:          # a crash is a finding, never hidden
    28	        import traceback
    29	        return {"seed": seed, "family": family, "outcome": "crash", "failure_class": "software_crash",
    30	                "error": f"{type(exc).__name__}: {exc}", "trace": traceback.format_exc()[-2000:]}
    31	
