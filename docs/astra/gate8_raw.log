   148	def validate(scenario: Scenario, cfg: Config = DEFAULT) -> list[str]:
   149	    """Returns a list of violated-invariant descriptions (empty = valid)."""
   150	    problems: list[str] = []
   151	    fp = Footprint(cfg.rover)
   152	    W, H = cfg.board.width, cfg.board.height
   153	    side = cfg.cube.side
   154	
   155	    rover_polys = []
   156	    for r in scenario.rovers:
   157	        poly = _rover_polygon(fp, r.x, r.y, r.theta)
   158	        rover_polys.append(poly)
   159	        if not S.inside_rect(poly, 0.0, W, 0.0, H):
   160	            problems.append(f"rover {r.id} envelope outside field")
   161	    for i in range(len(rover_polys)):
   162	        for j in range(i + 1, len(rover_polys)):
   163	            if S.distance(rover_polys[i], rover_polys[j]) < GEN.min_clearance_mm:
   164	                problems.append(f"rovers {scenario.rovers[i].id}/{scenario.rovers[j].id} too close")
   165	
   166	    cube_polys = []
   167	    for c in scenario.cubes:
   168	        poly = _cube_polygon(c.x, c.y, side, c.alpha)
   169	        cube_polys.append(poly)
   170	        if not S.inside_rect(poly, 0.0, W, 0.0, H):
   171	            problems.append(f"cube {c.color} outside field")
   172	        for rp, r in zip(rover_polys, scenario.rovers):
   173	            if S.distance(rp, poly) < GEN.min_clearance_mm:
   174	                problems.append(f"rover {r.id} too close to cube {c.color}")
   175	        dcol, drow = scenario.depots[c.color]
   176	        dx, dy = Grid(scenario.board_cols, scenario.board_rows, scenario.cell_mm).to_internal_xy(dcol, drow)
   177	        zone = DepotZone(c.color, dx, dy, cfg.depot.half_size)
   178	        if zone.contains_cube(c.x, c.y, side, c.alpha):
   179	            problems.append(f"cube {c.color} already in its depot")
   180	    for i in range(len(cube_polys)):
   181	        for j in range(i + 1, len(cube_polys)):
   182	            if S.distance(cube_polys[i], cube_polys[j]) < GEN.min_clearance_mm:
   183	                problems.append(f"cubes {scenario.cubes[i].color}/{scenario.cubes[j].color} too close")
   184	    return problems
