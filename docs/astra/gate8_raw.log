+    H, h_rover, h_cube = 2100, 90, 60
+    k = (H - h_cube) / (H - h_rover)
+    projected = [(430 + k * (x - 430), 430 + k * (y - 430))
+                 for x, y in w.footprint.parts(700, 430, 0)[0]]
+    expected = _poly_area(_clip_convex(cube_poly(w.cubes["red"]), projected)) / 3600
