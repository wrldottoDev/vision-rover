   112	            jitter = self.rng.normal(0.0, self.params.jitter_std_s)
   113	            self._next_capture_t += max(0.2 * period, period + jitter)
   114	            guard += 1
   115	
   116	    def _emit(self, world: PhysicsWorld, t_capture: float) -> None:
