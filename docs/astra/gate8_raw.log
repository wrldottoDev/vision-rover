    71	
    72	def main(argv=None) -> None:
    73	    ap = argparse.ArgumentParser()
    74	    ap.add_argument("--n", type=int, default=100)
    75	    ap.add_argument("--start", type=int, default=0)
    76	    ap.add_argument("--seeds", type=str, default="")
    77	    ap.add_argument("--family", default="start_zone")
    78	    ap.add_argument("--max-time", type=float, default=300.0)
    79	    ap.add_argument("--workers", type=int, default=max(1, (os.cpu_count() or 2) - 1))
    80	    ap.add_argument("--out", default="")
    81	    a = ap.parse_args(argv)
    82	    seeds = [int(s) for s in a.seeds.split(",")] if a.seeds else list(range(a.start, a.start + a.n))
    83	    t0 = time.time()
    84	    jobs = [(s, a.family, a.max_time) for s in seeds]
    85	    if a.workers > 1 and len(jobs) > 1:
    86	        with ProcessPoolExecutor(a.workers) as ex:
    87	            results = list(ex.map(_work, jobs, chunksize=4))
    88	    else:
    89	        results = [_work(j) for j in jobs]
    90	    agg = aggregate(results)
    91	    agg["wall_s"] = round(time.time() - t0, 1)
    92	    agg["family"] = a.family
    93	    print(json.dumps(agg, indent=1))
    94	    fails = [r for r in results if r.get("outcome") != "success"]
    95	    for r in fails[:40]:
    96	        print(f"FAIL seed={r['seed']} class={r.get('failure_class')} delivered={r.get('delivered')}/{r.get('n_cubes')} "
    97	              f"{r.get('error', '')} {r.get('detail', '')}")
    98	    if a.out:
    99	        os.makedirs(a.out, exist_ok=True)
   100	        with open(os.path.join(a.out, "summary.json"), "w") as f:
   101	            json.dump(agg, f, indent=1)
   102	        with open(os.path.join(a.out, "results.jsonl"), "w") as f:
   103	            for r in results:
   104	                f.write(json.dumps(r) + "\n")
   105	        with open(os.path.join(a.out, "failed_seeds.txt"), "w") as f:
   106	            for r in fails:
   107	                f.write(f"{r['seed']} {a.family} {r.get('failure_class')}\n")
   108	
   109	
   110	if __name__ == "__main__":
   111	    main()

