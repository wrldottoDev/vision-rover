   192	def _motor_params(rng: np.random.Generator, hard: bool) -> MotorParams:
   193	    lo, hi = (0.85, 1.15) if hard else (0.9, 1.1)
   194	    gl = rng.uniform(lo, hi)
   195	    gr = rng.uniform(lo, hi)
   196	    tau = rng.uniform(0.06, 0.15) if not hard else rng.uniform(0.08, 0.20)
   197	    latency = rng.uniform(0.02, 0.06) if not hard else rng.uniform(0.03, 0.10)
   198	    deadband = rng.uniform(2.0, 6.0)
   199	    noise = rng.uniform(0.01, 0.04) if not hard else rng.uniform(0.02, 0.07)
   200	    return MotorParams(
   201	        gain_left=float(gl), gain_right=float(gr), deadband_mm_s=float(deadband),
   202	        tau_s=float(tau), speed_noise_std=float(noise), latency_s=float(latency),
   203	    )
   204	
   205	
   206	def _sensor_params(rng: np.random.Generator, hard: bool) -> SensorParams:
   207	    base = SensorParams()
   208	    if not hard:
   209	        return base
   210	    scale = rng.uniform(1.3, 2.2)
   211	    return SensorParams(
   212	        frame_drop_prob=min(0.3, base.frame_drop_prob * scale),
   213	        rover_loss_prob=min(0.3, base.rover_loss_prob * scale),
   214	        rover_loss_burst_prob=min(0.05, base.rover_loss_burst_prob * scale),
   215	        pos_noise_std_mm=base.pos_noise_std_mm * scale,
   216	        heading_noise_std_rad=base.heading_noise_std_rad * scale,
   217	        outlier_prob=min(0.05, base.outlier_prob * scale),
   218	        cube_pos_noise_std_mm=base.cube_pos_noise_std_mm * scale,
   219	        cube_pos_bias_mm=base.cube_pos_bias_mm * scale,
   220	    )
   221	
   222	
   223	def _contact_params(rng: np.random.Generator, hard: bool) -> ContactParams:
   224	    c_ls_frac = float(rng.uniform(0.34, 0.42))
   225	    friction_mu = float(rng.uniform(0.3, 0.7))
   226	    floor = float(rng.uniform(0.02, 0.08)) if hard else 0.0
   227	    return ContactParams(c_ls_frac=c_ls_frac, friction_mu=friction_mu, iterations=4, floor_perturb_std=floor)
