   132	            "rovers": rovers,
   133	            "cubes": cubes,
   134	            "obstacles": [],
   135	            "start": {"col": self.start_xy[0], "row": self.start_xy[1]},
   136	            "depots": [{"color": k, "col": v[0], "row": v[1]} for k, v in self.depots.items()],
   137	        }
   138	        latency = max(0.0, self.rng.normal(self.params.latency_mean_s, self.params.latency_jitter_s))
