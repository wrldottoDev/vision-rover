   307	    # --------------------------------------------------------- rover motion --
   308	    def _advance_rover(self, r: SimRover, dt: float) -> None:
   309	        m = r.motor
   310	        while r.pending and r.pending[0][0] <= self.t:
   311	            _, cmd = r.pending.pop(0)
   312	            r.cmd_left, r.cmd_right = cmd.v_left, cmd.v_right
   313	
   314	        def _target(cmd_v: float, gain: float) -> float:
   315	            v = gain * cmd_v
   316	            if abs(v) < m.deadband_mm_s:
   317	                v = 0.0
   318	            return max(-m.max_wheel_speed_mm_s, min(m.max_wheel_speed_mm_s, v))
   319	
   320	        tl = _target(r.cmd_left, m.gain_left)
   321	        tr = _target(r.cmd_right, m.gain_right)
   322	        a = min(1.0, dt / max(m.tau_s, 1e-6))
   323	        r.wl += (tl - r.wl) * a
   324	        r.wr += (tr - r.wr) * a
   325	        nl = 1.0 + self.rng.normal(0.0, m.speed_noise_std)
   326	        nr = 1.0 + self.rng.normal(0.0, m.speed_noise_std)
   327	        wl_eff, wr_eff = r.wl * nl, r.wr * nr
   328	        v = (wl_eff + wr_eff) / 2.0
   329	        w = (wr_eff - wl_eff) / self.track
   330	        r.x += v * math.cos(r.theta) * dt
   331	        r.y += v * math.sin(r.theta) * dt
   332	        r.theta = wrap(r.theta + w * dt)
   333	
   334	    def _resolve_rover_rover(self, prev: dict[int, tuple[float, float, float]]) -> None:
   335	        ids = list(self.rovers.keys())
   336	        new_active: set[tuple[int, int]] = set()
   337	        for i in range(len(ids)):
   338	            for j in range(i + 1, len(ids)):
   339	                a, b = self.rovers[ids[i]], self.rovers[ids[j]]
   340	                Ea = self.footprint.envelope(a.x, a.y, a.theta)
   341	                Eb = self.footprint.envelope(b.x, b.y, b.theta)
   342	                if not S.overlap(Ea, Eb):
   343	                    continue
   344	                pair = (ids[i], ids[j])
   345	                new_active.add(pair)
   346	                if pair not in self._collision_active:
   347	                    self.events.append(Event("collision", self.t, {"rovers": pair}))
   348	                    self.counts["collision"] += 1
   349	                a.x, a.y, a.theta = prev[a.id]
   350	                b.x, b.y, b.theta = prev[b.id]
   351	                a.wl = a.wr = 0.0
   352	                b.wl = b.wr = 0.0
   353	        self._collision_active = new_active
   354	
   355	    # --------------------------------------------------------- cube contact --
   356	    def _apply_twist(self, cube: SimCube, p: Pt, n: Pt, depth: float) -> None:
   357	        depth = min(depth, self.contact.max_correction_mm)
   358	        rx, ry = p[0] - cube.x, p[1] - cube.y
   359	        cross_rn = rx * n[1] - ry * n[0]
   360	        c_ls = self.contact.c_ls_frac * self.cfg.cube.side
   361	        k = depth / (1.0 + (cross_rn * cross_rn) / (c_ls * c_ls))
   362	        if self.contact.floor_perturb_std > 0.0:
   363	            jitter = self.rng.normal(0.0, self.contact.floor_perturb_std * max(abs(k), 1e-6))
   364	            cube.x += -n[1] * jitter
   365	            cube.y += n[0] * jitter
   366	        cube.x += k * n[0]
   367	        cube.y += k * n[1]
   368	        cube.alpha += k * cross_rn / (c_ls * c_ls)
   369	
   370	    def _resolve_rover_cube(self) -> set[tuple[int, str]]:
   371	        side = self.cfg.cube.side
   372	        rover_parts: dict[int, list[list[Pt]]] = {}
   373	        for rid, r in self.rovers.items():
   374	            rover_parts[rid] = [_pts(part) for part in self.footprint.parts(r.x, r.y, r.theta)]
   375	
   376	        touched: set[tuple[int, str]] = set()
   377	        for _ in range(self.contact.iterations):
   378	            for color, cube in self.cubes.items():
   379	                if not cube.in_play:
   380	                    continue
   381	                for rid, parts in rover_parts.items():
   382	                    for part in parts:
   383	                        cube_poly = _square_pts(cube.x, cube.y, side, cube.alpha)
   384	                        depth, n, p = _sat_contact(part, cube_poly)
   385	                        if depth is None or depth < 1e-9:
   386	                            continue
   387	                        touched.add((rid, color))
   388	                        self._apply_twist(cube, p, n, depth)
   389	        return touched
   390	
   391	    def _resolve_cube_cube(self, touched: set[tuple[int, str]]) -> None:
   392	        side = self.cfg.cube.side
   393	        driven_by_rover = {color for (_, color) in touched}
   394	        colors = list(self.cubes.keys())
   395	        for _ in range(self.contact.iterations):
   396	            for i in range(len(colors)):
   397	                for j in range(i + 1, len(colors)):
   398	                    ca, cb = self.cubes[colors[i]], self.cubes[colors[j]]
   399	                    if not ca.in_play or not cb.in_play:
   400	                        continue
   401	                    a_drv = colors[i] in driven_by_rover
   402	                    b_drv = colors[j] in driven_by_rover
   403	                    if a_drv and not b_drv:
   404	                        driver, driven = ca, cb
   405	                    elif b_drv and not a_drv:
   406	                        driver, driven = cb, ca
   407	                    else:
   408	                        # ponytail: neither (or both) cube touched by a rover this step
   409	                        # -- no clear pusher, so just split the overlap symmetrically with
   410	                        # no induced spin. Upgrade to per-pair priority if this matters.
   411	                        A = _square_pts(ca.x, ca.y, side, ca.alpha)
   412	                        B = _square_pts(cb.x, cb.y, side, cb.alpha)
   413	                        depth, n, _p = _sat_contact(A, B)
   414	                        if depth is None or depth < 1e-9:
   415	                            continue
   416	                        ca.x -= 0.5 * depth * n[0]
   417	                        ca.y -= 0.5 * depth * n[1]
   418	                        cb.x += 0.5 * depth * n[0]
   419	                        cb.y += 0.5 * depth * n[1]
   420	                        continue
   421	                    A = _square_pts(driver.x, driver.y, side, driver.alpha)
   422	                    B = _square_pts(driven.x, driven.y, side, driven.alpha)
   423	                    depth, n, p = _sat_contact(A, B)
   424	                    if depth is None or depth < 1e-9:
   425	                        continue
   426	                    self._apply_twist(driven, p, n, depth)
   427	
   428	    def _update_contact_records(self, touched: set[tuple[int, str]]) -> None:
   429	        for rid, color in touched:
   430	            self.cubes[color].touched_by[rid] = self.t
   431	            pair = (rid, color)
   432	            if pair not in self._contact_active:
   433	                if self.targets.get(rid) != color:
   434	                    self.events.append(Event("non_target_contact", self.t, {"rover": rid, "cube": color}))
   435	                    self.counts["non_target_contact"] += 1
   436	        self._contact_active = touched
   437	
   438	    # ------------------------------------------------------------- bounds --
   439	    def _check_board_bounds(self) -> None:
   440	        b = self.cfg.board
   441	        W, H = b.width, b.height
   442	        over = b.overhang_allowance_mm
   443	        phys = b.physical_margin_mm
   444	        for rid, r in self.rovers.items():
   445	            env = _pts(self.footprint.envelope(r.x, r.y, r.theta))
   446	            inside = S.inside_rect(np.array(env), -over, W + over, -over, H + over)
   447	            if not inside and not self._rover_out[rid]:
   448	                self.events.append(Event("rover_exit", self.t, {"rover": rid}))
   449	                self.counts["rover_exit"] += 1
   450	            self._rover_out[rid] = not inside
   451	            fell = not (-phys <= r.x <= W + phys and -phys <= r.y <= H + phys)
   452	            if fell and rid not in self._rover_fell:
   453	                self.events.append(Event("rover_fell", self.t, {"rover": rid}))
   454	                self.counts["rover_fell"] += 1
   455	                self._rover_fell.add(rid)
   456	        for color, c in self.cubes.items():
   457	            if not c.in_play:
   458	                continue
   459	            poly = np.array(_square_pts(c.x, c.y, self.cfg.cube.side, c.alpha))
   460	            inside = S.inside_rect(poly, -over, W + over, -over, H + over)
   461	            if not inside and not self._cube_out[color]:
   462	                self.events.append(Event("cube_exit", self.t, {"cube": color}))
   463	                self.counts["cube_exit"] += 1
   464	            self._cube_out[color] = not inside
