   170	def classify(res: RunResult, sup: Supervisor, t: float, max_time: float, last_progress_t: float,
   171	             stall_s: float) -> str:
   172	    if res.rover_rover_collisions:
   173	        return "coordination_collision"
   174	    if res.falls or res.rover_exits:
   175	        return "board_exit"
   176	    if res.non_target_contacts and res.completion_time is not None:
   177	        return "non_target_contact"
   178	    evs = [e[2] for e in sup.events]
   179	    if res.delivered < res.n_cubes:
   180	        if "no_plan" in evs and res.replans == 0 and res.delivered == 0:
   181	            return "planner_no_solution"
   182	        if sup.counters.get("waiting_all_rovers", 0) > 100 or (res.est_pos_rmse or 0) > 15:
   183	            return "perception_estimation"
   184	        if res.capture_failures >= 3:
   185	            return "controller_capture"
   186	        if sup.counters.get("yield_failed", 0) > 3 or sup.counters.get("commit_denied", 0) > 200:
   187	            return "coordination_deadlock"
   188	        if t - last_progress_t > stall_s:
   189	            return "stall"
   190	        return "timeout"
   191	    if res.non_target_contacts:
   192	        return "non_target_contact"
   193	    return "unclassified"
