   289	def _sample_cube_center(rng: np.random.Generator, cfg: Config, family: str, depots: dict[str, tuple[float, float]],
   290	                         color: str, grid: Grid) -> tuple[float, float]:
   291	    W, H = cfg.board.width, cfg.board.height
