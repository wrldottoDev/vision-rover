+    penetration = max(depth(_pts(p), cube_poly(w.cubes["green"]))
+                      for p in w.footprint.parts(r.x, r.y, r.theta))
+    assert penetration < 1e-3, f"chain pushed cube {penetration:.4f} mm into rover 11"
