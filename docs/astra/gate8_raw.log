   295	    # ---------------------------------------------------------------- step --
   296	    def step(self, dt: float) -> None:
   297	        self.t += dt
   298	        prev = {rid: (r.x, r.y, r.theta) for rid, r in self.rovers.items()}
   299	        for r in self.rovers.values():
   300	            self._advance_rover(r, dt)
   301	        self._resolve_rover_rover(prev)
   302	        touched = self._resolve_rover_cube()
   303	        self._resolve_cube_cube(touched)
   304	        self._update_contact_records(touched)
   305	        self._check_board_bounds()
