   372	def generate(seed: int, family: str, cfg: Config = DEFAULT) -> Scenario:
   373	    if family not in FAMILIES:
   374	        raise ValueError(f"unknown family {family!r}, expected one of {FAMILIES}")
   375	    rng = np.random.default_rng(seed)
   376	    hard = family == "hard"
   377	
   378	    corners = [(cfg.board.cols, 0), (0, cfg.board.rows), (cfg.board.cols, cfg.board.rows)]
   379	    corner_pts = [_depot_point(c, cfg.board.cols, cfg.board.rows) for c in corners]
   380	    shuffled_colors = [str(c) for c in rng.permutation(np.array(COLORS))]
   381	    depots = {color: corner_pts[i] for i, color in enumerate(shuffled_colors)}
   382	    start = _depot_point((0, 0), cfg.board.cols, cfg.board.rows)
   383	
   384	    rovers = _place_rovers(rng, cfg, family)
   385	    cubes = _place_cubes(rng, cfg, family, rovers, depots)
   386	    sensor = _sensor_params(rng, hard)
   387	    contact = _contact_params(rng, hard)
   388	
   389	    scenario = Scenario(
   390	        seed=seed, family=family, rovers=rovers, cubes=cubes, depots=depots, start=start,
   391	        sensor=sensor, contact=contact,
   392	        board_cols=cfg.board.cols, board_rows=cfg.board.rows, cell_mm=cfg.board.cell_mm,
   393	    )
   394	    problems = validate(scenario, cfg)
   395	    if problems:
   396	        raise RuntimeError(f"generated invalid scenario seed={seed} family={family}: {problems}")
   397	    return scenario
   398	
   399	
   400	def instantiate(scenario: Scenario, cfg: Config = DEFAULT) -> tuple[PhysicsWorld, VisionEmulator]:
   401	    """Build the two runnable ground-truth objects (`PhysicsWorld`, `VisionEmulator`)
   402	    from a `Scenario`. The runner drives `world` and reads telemetry through `emu`
   403	    (see physics.PhysicsWorld / sensors.VisionEmulator docstrings for the step/poll
   404	    API). Physics and sensor noise get independent RNG streams spawned from the same
   405	    seed (`np.random.SeedSequence.spawn`), so the pair is still fully determined by
   406	    `scenario.seed` alone.
   407	    """
   408	    rng_phys, rng_sensor = (np.random.default_rng(s) for s in np.random.SeedSequence(scenario.seed).spawn(2))
   409	    rovers = [SimRover(id=r.id, x=r.x, y=r.y, theta=r.theta, motor=r.motor) for r in scenario.rovers]
   410	    cubes = [SimCube(color=c.color, x=c.x, y=c.y, alpha=c.alpha) for c in scenario.cubes]
   411	    world = PhysicsWorld(cfg, rovers, cubes, scenario.contact, rng_phys)
   412	    emu = VisionEmulator(scenario.sensor, rng_sensor, scenario.depots, scenario.start)
   413	    return world, emu

