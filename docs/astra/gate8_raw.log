+def test_cached_observation_age_is_independent_of_transport_latency():
+    """Control: age_ms counts missed detections; ts_ms carries network age."""
+    w = world([SimRover(10, 300, 430, 0, motor())])
+    e = emulator(latency_mean_s=0.2)
+    e.capture(w, 0)
