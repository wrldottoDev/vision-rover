   230	def _clamp_inside_field(fp: Footprint, x: float, y: float, theta: float, W: float, H: float) -> tuple[float, float]:
   231	    poly = fp.envelope(x, y, theta)
   232	    lo_x, hi_x = float(poly[:, 0].min()), float(poly[:, 0].max())
   233	    lo_y, hi_y = float(poly[:, 1].min()), float(poly[:, 1].max())
   234	    dx = -lo_x if lo_x < 0.0 else (W - hi_x if hi_x > W else 0.0)
   235	    dy = -lo_y if lo_y < 0.0 else (H - hi_y if hi_y > H else 0.0)
