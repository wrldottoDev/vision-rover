+    second, = e.poll(0.25)
+    assert first["rovers"][0]["age_ms"] == 0
+    assert second["rovers"][0]["age_ms"] == 50
+    assert second["rovers"][0]["col"] == first["rovers"][0]["col"]
+    assert second["ts_ms"] == 50
