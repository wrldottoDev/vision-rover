    40	def aggregate(results: list[dict]) -> dict:
    41	    n = len(results)
    42	    ok = [r for r in results if r.get("outcome") == "success"]
    43	    times = [r["completion_time"] for r in ok if r.get("completion_time") is not None]
    44	    feasible = [r for r in results if r.get("failure_class") != "physically_infeasible"]
    45	    agg = {
    46	        "runs": n,
    47	        "success_rate": len(ok) / n if n else 0.0,
    48	        "success_rate_feasible": (len([r for r in feasible if r.get("outcome") == "success"]) / len(feasible)) if feasible else 0.0,
    49	        "delivered_3of3_rate": sum(1 for r in results if r.get("delivered", 0) == r.get("n_cubes", -1)) / n if n else 0,
    50	        "mean_delivered": statistics.mean([r.get("delivered", 0) for r in results]) if n else 0,
    51	        "failure_classes": dict(Counter(r.get("failure_class", "none") for r in results if r.get("outcome") != "success")),
    52	        "mean_completion_time": statistics.mean(times) if times else None,
    53	        "median_completion_time": statistics.median(times) if times else None,
    54	        "p95_completion_time": pct(times, 0.95),
    55	        "max_completion_time": max(times) if times else None,
    56	    }
    57	    for k in SAFETY_KEYS + ("deadlocks", "delivery_undone", "cube_exits", "replans", "recoveries", "estops",
    58	                            "capture_failures"):
    59	        vals = [r.get(k, 0) or 0 for r in results]
    60	        agg[k + "_total"] = sum(vals)
    61	        agg[k + "_runs"] = sum(1 for v in vals if v)
    62	    for k in ("est_pos_rmse", "est_heading_rmse_deg", "push_cross_track_p95", "max_occlusion_s"):
    63	        vals = [r[k] for r in results if r.get(k) is not None]
    64	        agg[k + "_mean"] = statistics.mean(vals) if vals else None
    65	        agg[k + "_max"] = max(vals) if vals else None
    66	    rec = [r for r in results if (r.get("recoveries") or 0) > 0]
    67	    agg["recovery_success_rate"] = (sum(1 for r in rec if r.get("outcome") == "success") / len(rec)) if rec else None
    68	    agg["replans_per_run"] = agg["replans_total"] / n if n else 0
    69	    return agg
