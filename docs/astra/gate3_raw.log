    16	@dataclass(frozen=True)
    17	class Pose:
    18	    x: float
    19	    y: float
    20	    theta: float
    21	
    22	    def xy(self) -> np.ndarray:
    23	        return np.array([self.x, self.y])
    24	
    25	    def forward(self) -> np.ndarray:
    26	        return np.array([math.cos(self.theta), math.sin(self.theta)])
    27	
    28	    def moved(self, dist: float) -> "Pose":
    29	        return Pose(self.x + dist * math.cos(self.theta), self.y + dist * math.sin(self.theta), self.theta)
    30	
    31	    def rotated_to(self, theta: float) -> "Pose":
    32	        return Pose(self.x, self.y, wrap(theta))
    33	
    34	    def to_local(self, px: float, py: float) -> tuple[float, float]:
    35	        """World point -> this pose's frame (x forward, y left)."""
    36	        dx, dy = px - self.x, py - self.y
    37	        c, s = math.cos(self.theta), math.sin(self.theta)
    38	        return c * dx + s * dy, -s * dx + c * dy
