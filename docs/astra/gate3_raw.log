   152	    def commit_region(self, rid: int, polygons: list[np.ndarray], prio: int) -> bool:
   153	        est = self.est[rid].estimate(self.t)
   154	        region = list(polygons) + [self.fp.envelope(est.pose.x, est.pose.y, est.pose.theta)]
   155	        if self.res.conflicts(rid, region):
   156	            self.log(rid, "commit_denied")
   157	            return False
   158	        self.res.reserve(rid, region, prio, self.t)
   159	        self.committed[rid] = region
