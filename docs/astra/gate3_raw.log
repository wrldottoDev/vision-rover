   118	class PoseEstimator:
   119	    """EKF pose tracker for a single rover. Call `initialize` once, then feed
   120	    `set_command` / `update_vision` as they occur and `predict` / `estimate` on demand.
   121	    """
   122	
   123	    def __init__(self, cfg: EstimatorConfig, policy: TelemetryPolicy, rover_id: int):
   124	        self.cfg = cfg
   125	        self.policy = policy
   126	        self.rover_id = rover_id
   127	        self._initialized = False
   128	        # exposed counters for the lead to log
   129	        self.consecutive_rejects = 0
   130	        self.reinit_count = 0
   131	
   132	    # ------------------------------------------------------------------ lifecycle
   133	    def initialize(self, pose: Pose, t: float) -> None:
   134	        self._x = np.array([pose.x, pose.y, wrap(pose.theta), 0.0, 0.0])
   135	        self._P = np.diag([
   136	            self.cfg.meas_pos_std ** 2, self.cfg.meas_pos_std ** 2,
   137	            self.cfg.meas_heading_std ** 2, _INIT_V_STD ** 2, _INIT_OMEGA_STD ** 2,
   138	        ])
   139	        self._t = t
   140	        self._cmd_hist: list[tuple[float, float, float]] = [(t, 0.0, 0.0)]
   141	        self._checkpoints: list[tuple[float, np.ndarray, np.ndarray]] = [(t, self._x.copy(), self._P.copy())]
   142	        self._last_accepted_t = t          # for age_s (capture-time based)
   143	        self._last_processed_capture_t = t  # dedup guard (capture-time based)
   144	        self._anchor_xy = (pose.x, pose.y)  # position at last accepted fix, for blind-travel
   145	        self.consecutive_rejects = 0
   146	        self._initialized = True
   147	
   148	    def set_command(self, t: float, v_cmd: float, w_cmd: float) -> None:
   149	        # Appended, not inserted: callers (a live control loop) issue commands in
   150	        # non-decreasing t order. bisect_right in _cmd_active then resolves same-
   151	        # timestamp duplicates as "last write wins", matching append order.
   152	        self._cmd_hist.append((t, v_cmd, w_cmd))
   153	        cutoff = self._t - self.cfg.history_s
   154	        self._cmd_hist = _trim_keep_anchor(self._cmd_hist, cutoff)
   155	
   156	    # ------------------------------------------------------------------ propagation
   157	    def predict(self, t: float) -> None:
   158	        if t <= self._t:
   159	            return
   160	        self._x, self._P = self._advance(self._x, self._P, self._t, t)
   161	        self._t = t
   162	        self._checkpoints.append((t, self._x.copy(), self._P.copy()))
   163	        self._trim_history()
   164	
   165	    def _trim_history(self) -> None:
   166	        cutoff = self._t - self.cfg.history_s
   167	        self._checkpoints = _trim_keep_anchor(self._checkpoints, cutoff)
   168	        self._cmd_hist = _trim_keep_anchor(self._cmd_hist, cutoff)
   169	
   170	    def _cmd_active(self, t: float) -> tuple[float, float]:
   171	        times = [c[0] for c in self._cmd_hist]
   172	        idx = bisect.bisect_right(times, t) - 1
   173	        if idx < 0:
   174	            return 0.0, 0.0
   175	        _, v_cmd, w_cmd = self._cmd_hist[idx]
   176	        return v_cmd, w_cmd
   177	
   178	    def _advance(self, x: np.ndarray, P: np.ndarray, t0: float, t1: float) -> tuple[np.ndarray, np.ndarray]:
   179	        if t1 <= t0:
   180	            return x, P
   181	        x = x.copy()
   182	        P = P.copy()
   183	        breakpoints = [c[0] for c in self._cmd_hist if t0 < c[0] < t1]
   184	        bounds = [t0] + sorted(breakpoints) + [t1]
   185	        for a, b in zip(bounds[:-1], bounds[1:]):
   186	            dur = b - a
   187	            if dur <= 0.0:
   188	                continue
   189	            v_cmd, w_cmd = self._cmd_active(a)
   190	            n = max(1, math.ceil(dur / _MAX_SUBSTEP_S))
   191	            h = dur / n
   192	            for _ in range(n):
   193	                x, P = self._step(x, P, h, v_cmd, w_cmd)
   194	        return x, P
   195	
   196	    def _step(self, x: np.ndarray, P: np.ndarray, h: float, v_cmd: float, w_cmd: float) -> tuple[np.ndarray, np.ndarray]:
   197	        xx, yy, th, v, om = x
   198	        tau = self.cfg.cmd_tau
   199	        a = math.exp(-h / tau) if tau > 0 else 0.0
   200	
   201	        v1 = v_cmd + (v - v_cmd) * a
   202	        om1 = w_cmd + (om - w_cmd) * a
   203	        v_avg = 0.5 * (v + v1)
   204	        om_avg = 0.5 * (om + om1)
   205	        d_avg_dself = 0.5 * (1.0 + a)     # d(v_avg)/dv == d(om_avg)/domega
   206	        th_mid = th + 0.5 * om_avg * h
   207	        dthmid_domega = 0.25 * h * (1.0 + a)
   208	
   209	        c, s = math.cos(th_mid), math.sin(th_mid)
   210	        x1 = xx + v_avg * c * h
   211	        y1 = yy + v_avg * s * h
   212	        th1 = wrap(th + om_avg * h)
   213	
   214	        F = np.zeros((5, 5))
   215	        F[0, 0] = 1.0
   216	        F[0, 2] = -v_avg * s * h
   217	        F[0, 3] = d_avg_dself * c * h
   218	        F[0, 4] = -v_avg * s * h * dthmid_domega
   219	        F[1, 1] = 1.0
   220	        F[1, 2] = v_avg * c * h
   221	        F[1, 3] = d_avg_dself * s * h
   222	        F[1, 4] = v_avg * c * h * dthmid_domega
   223	        F[2, 2] = 1.0
   224	        F[2, 4] = h * d_avg_dself
   225	        F[3, 3] = a
   226	        F[4, 4] = a
   227	
   228	        Q = np.zeros((5, 5))
   229	        Q[3, 3] = self.cfg.accel_noise ** 2 * h
   230	        Q[4, 4] = self.cfg.alpha_noise ** 2 * h
   231	
   232	        x_new = np.array([x1, y1, th1, v1, om1])
   233	        P_new = F @ P @ F.T + Q
   234	        P_new = 0.5 * (P_new + P_new.T)
   235	        return x_new, P_new
   236	
   237	    # ------------------------------------------------------------------ vision update
   238	    def update_vision(self, pose_meas: Pose, t_capture: float, t_now: float) -> bool:
   239	        """Rewind to t_capture using stored history, gate + correct there, then replay
   240	        forward to t_now with the recorded commands. Returns True iff the state was
   241	        modified (accepted correction, or a kidnap re-init)."""
   242	        if t_capture <= self._last_processed_capture_t:
   243	            # Duplicate (frozen ts_ms while occluded) or out-of-order/older-than-history.
   244	            # Not new evidence: no reject, no age reset, no state change.
   245	            return False
   246	        if not self._checkpoints or t_capture < self._checkpoints[0][0]:
   247	            # Older than our replay buffer: cannot safely rewind. Ignore.
   248	            return False
   249	
   250	        self._last_processed_capture_t = t_capture
   251	
   252	        times = [c[0] for c in self._checkpoints]
   253	        idx = bisect.bisect_right(times, t_capture) - 1
   254	        if idx < 0:
   255	            return False
   256	        t0, x0, P0 = self._checkpoints[idx]
   257	        x_tc, P_tc = self._advance(x0, P0, t0, t_capture)
   258	
   259	        innov = np.array([
   260	            pose_meas.x - x_tc[0],
   261	            pose_meas.y - x_tc[1],
   262	            wrap(pose_meas.theta - x_tc[2]),
   263	        ])
   264	        R = np.diag([self.cfg.meas_pos_std ** 2, self.cfg.meas_pos_std ** 2, self.cfg.meas_heading_std ** 2])
   265	        S = _H_POSE @ P_tc @ _H_POSE.T + R
   266	        d2 = float(innov @ np.linalg.solve(S, innov))
   267	
   268	        reinit = False
   269	        if d2 <= self.cfg.gate_chi2:
   270	            self.consecutive_rejects = 0
   271	        else:
   272	            self.consecutive_rejects += 1
   273	            if self.consecutive_rejects >= self.cfg.max_consecutive_rejects:
   274	                reinit = True
   275	                self.reinit_count += 1
   276	                self.consecutive_rejects = 0
   277	            else:
   278	                return False
   279	
   280	        if reinit:
   281	            x_new = np.array([pose_meas.x, pose_meas.y, wrap(pose_meas.theta), 0.0, 0.0])
   282	            P_new = np.diag([
   283	                self.cfg.meas_pos_std ** 2, self.cfg.meas_pos_std ** 2,
   284	                self.cfg.meas_heading_std ** 2, _INIT_V_STD ** 2, _INIT_OMEGA_STD ** 2,
   285	            ])
