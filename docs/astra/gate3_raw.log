    34	def resolve_deadlock(state_a: str, id_a: int, waiting_s_a: float,
    35	                      state_b: str, id_b: int, waiting_s_b: float, timeout_s: float) -> int | None:
    36	    """Both rovers WAITING on each other (mutually blocked) past `timeout_s` -> the lower-priority
    37	    one is told to yield.  Returns the rover id that must yield, or None if no deadlock is declared
    38	    yet (either side hasn't been waiting long enough)."""
    39	    if waiting_s_a < timeout_s or waiting_s_b < timeout_s:
    40	        return None
    41	    pa, pb = priority(state_a, id_a), priority(state_b, id_b)
    42	    return id_b if pa >= pb else id_a
