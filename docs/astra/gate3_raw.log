   287	            K = P_tc @ _H_POSE.T @ np.linalg.inv(S)
   288	            x_new = x_tc + K @ innov
   289	            x_new[2] = wrap(x_new[2])
   290	            I_KH = np.eye(5) - K @ _H_POSE
   291	            P_new = I_KH @ P_tc @ I_KH.T + K @ R @ K.T
   292	            P_new = 0.5 * (P_new + P_new.T)
