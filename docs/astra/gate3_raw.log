    73	    def conflicts(self, rover_id: int, polygons: list[np.ndarray]) -> list[int]:
    74	        """Other rover ids whose reservation comes within cfg.margins.rover_rover of `polygons`
    75	        (distance < margin is exactly "would intersect once both are inflated by the margin")."""
    76	        margin = self.cfg.margins.rover_rover
