   166	    def is_delivered(self, color: str, t: float) -> bool:
   167	        depot = self.depots.get(color)
   168	        tr = self.cubes.get(color)
   169	        if depot is None or tr is None:
   170	            return False
   171	        q = [(tc, x, y) for (tc, x, y) in self.fresh.get(color, ()) if tc >= t - 1.0]
   172	        if len(q) < self.cfg.depot.confirm_frames:
   173	            return False
   174	        c = tr.estimate(t)
   175	        alpha = c.alpha if (c.alpha is not None and c.alpha_std <= math.radians(10)) else None
   176	        side = self.cfg.cube.side
   177	        if alpha is not None:          # worst case over the belief interval
   178	            half = max(cube_half_extent(side, alpha + k * c.alpha_std) for k in (-2, 0, 2))
   179	            ok = all(depot.cx - depot.half + half <= x <= depot.cx + depot.half - half and
   180	                     depot.cy - depot.half + half <= y <= depot.cy + depot.half - half for _, x, y in q[-self.cfg.depot.confirm_frames:])
   181	            return ok
   182	        return all(depot.contains_cube(x, y, side, None, 0.0) for _, x, y in q[-self.cfg.depot.confirm_frames:])
