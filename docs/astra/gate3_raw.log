   503	    def _s_retreat(self, t, est, safe, ctx):
   504	        if self.dwell(t) > self.p.retreat_timeout_s:
   505	            ctx.log(self.id, "retreat_timeout")
   506	            return self._after_retreat(t, ctx)
   507	        if self.dwell(t) < 0.05 and not ctx.retreat_clear(self.id, est.pose, self.retreat.distance):
   508	            return 0.0, 0.0          # something behind us: hold (supervisor safety layer resolves)
   509	        v, w, done = self.retreat.step(est, t)
   510	        if done:
   511	            return self._after_retreat(t, ctx)
   512	        return v, w
   513	
   514	    def _after_retreat(self, t, ctx):
   515	        a = self.after_retreat
   516	        if a == "delivered" and self.task:
   517	            ctx.on_delivered(self.id, self.task.color, t)
   518	            ctx.release_task(self.id, self.task.color, failed=False, t=t)
   519	            self.task = None
   520	            self._go(S.IDLE, t, ctx, "delivered")
   521	        elif a == "next_leg" and self.task:
   522	            self._replan(t, ctx)      # re-plan remaining legs from the observed cube state
   523	        elif a == "replan" and self.task:
   524	            self._replan(t, ctx)
   525	        else:
   526	            self._go(S.IDLE, t, ctx)
   527	        return 0.0, 0.0
