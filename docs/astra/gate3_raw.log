   131	def imminent_collision(est_a: RoverEstimate, est_b: RoverEstimate, horizon_s: float,
   132	                        cfg: Config = DEFAULT, dt: float = 0.1) -> bool:
   133	    """Predict whether the two rovers' footprints (inflated by cfg.margins.rover_rover_estop, split
   134	    evenly so the required clearance between raw footprints is the full margin) would overlap at any
   135	    sampled instant within `horizon_s`, assuming each holds its current (v, omega)."""
   136	    fp = Footprint(cfg.rover, inflate=cfg.margins.rover_rover_estop / 2.0)
   137	    steps = max(1, int(round(horizon_s / dt)))
   138	    for i in range(steps + 1):
   139	        t = i * dt
   140	        pa = _rollout(est_a, t)
   141	        pb = _rollout(est_b, t)
   142	        if S.overlap(fp.envelope(*pa), fp.envelope(*pb)):
   143	            return True
   144	    return False
