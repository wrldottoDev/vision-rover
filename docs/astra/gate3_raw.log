   205	    def tick(self, t: float) -> dict[int, WheelCommand]:
   206	        self.t = t
   207	        if not hasattr(self, "committed"):
   208	            self.committed = {i: [] for i in self.ids}
   209	        ests: dict[int, RoverEstimate] = {}
   210	        for rid in self.ids:
   211	            if rid in self.est:
   212	                self.est[rid].predict(t)
   213	                ests[rid] = self.est[rid].estimate(t)
   214	        feed_stale = (t - self.newest_capture) > self.p.stale_feed_s
   215	        if self.phase != "RUNNING" or feed_stale or len(ests) < 1:
   216	            return self._stop_all(t, "phase" if self.phase != "RUNNING" else "stale feed")
   217	
   218	        self._refresh_reservations(ests)
   219	        self._allocate(t, ests)
   220	
   221	        for rid in self.ids:
   222	            a = self.agents[rid]
   223	            if rid not in ests:
   224	                self.cmd[rid] = (0.0, 0.0)
   225	                continue
   226	            safe = self.est[rid].is_safe_to_drive(t)
   227	            self.cmd[rid] = a.step(t, ests[rid], safe, self)
   228	
   229	        self._safety_layer(t, ests)
   230	        self._resolve_deadlock(t, ests)
   231	        out = {}
   232	        for rid in self.ids:
   233	            v, w = self.cmd[rid]
   234	            wc = WheelCommand.from_unicycle(v, w, self.cfg.rover.track_width, self.cfg.limits.wheel_speed_max)
   235	            v2, w2 = wc.unicycle(self.cfg.rover.track_width)
   236	            if rid in self.est:
   237	                self.est[rid].set_command(t, v2, w2)
   238	            out[rid] = wc
   239	        return out
   240	
   241	    def _stop_all(self, t: float, why: str) -> dict[int, WheelCommand]:
   242	        for rid in self.ids:
   243	            self.cmd[rid] = (0.0, 0.0)
   244	            if rid in self.est:
   245	                self.est[rid].set_command(t, 0.0, 0.0)

