   127	@dataclass(frozen=True)
   128	class WheelCommand:
   129	    v_left: float         # mm/s
   130	    v_right: float
   131	
   132	    @staticmethod
   133	    def from_unicycle(v: float, w: float, track: float, vmax: float) -> "WheelCommand":
   134	        l, r = v - w * track / 2.0, v + w * track / 2.0
   135	        k = max(1.0, abs(l) / vmax, abs(r) / vmax)      # scale both to keep curvature
   136	        return WheelCommand(l / k, r / k)
   137	
   138	    def unicycle(self, track: float) -> tuple[float, float]:
   139	        return (self.v_left + self.v_right) / 2.0, (self.v_right - self.v_left) / track
