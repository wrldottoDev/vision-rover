    27	def priority(state_name: str, rover_id: int) -> int:
    28	    """Deterministic priority ordinal: state dominates, ties broken in favour of the lower
    29	    rover id.  Higher = more important = the other rover yields to it."""
    30	    base = 100 if state_name in HIGH_PRIORITY_STATES else 10
