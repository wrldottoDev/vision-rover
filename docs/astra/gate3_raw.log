   140	    def plan_push(self, rid: int, color: str):
   141	        cube = self.cube(color)
   142	        depot = self.depots.get(color)
   143	        if cube is None or depot is None:
   144	            return None
   145	        others = [self.cube(c) for c in self.cubes if c != color]
   146	        plans = self.pusher.plan(cube, depot, others, self.board_w, self.board_h, max_plans=3)
   147	        if not plans:
   148	            self.log(rid, "push_plan_fail", color=color, why=self.pusher.last_failure)
   149	            return None
   150	        return plans[0]
