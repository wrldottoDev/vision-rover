   269	                self.path = None
   270	                self._go(S.YIELD, t, ctx, "retry")
   271	            elif self.task:
   272	                self._start_nav(t, ctx)
   273	            else:
   274	                self._go(S.IDLE, t, ctx)
   275	        return 0.0, 0.0
   276	
   277	    def _wait(self, t, ctx, resume: S, why: str):
   278	        self.resume = resume
   279	        self._go(S.WAIT, t, ctx, why)
   280	        return 0.0, 0.0

