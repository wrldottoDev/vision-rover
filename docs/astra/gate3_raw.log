    75	# TUNED: sub-step ceiling for the mean/covariance integrator. At the fastest planned
    76	# speeds (v_nav=110 mm/s, w_nav=1.4 rad/s) a 20 ms step turns theta by <=0.028 rad
    77	# within the step -- small compared to the per-frame heading noise (1.5 deg = 0.026
    78	# rad) -- so the midpoint method's O(h^3) linearization error stays negligible next to
    79	# sensor noise without needing a stiffer/rk4 integrator.
    80	_MAX_SUBSTEP_S = 0.02
    81	
    82	# ASSUMED: velocity-state uncertainty injected on initialize()/re-init, when v/omega
    83	# are not actually known (start-of-match, or after a kidnap re-init from a bare pose
    84	# measurement). Large enough that a few cmd_tau time-constants of predict+update pull
    85	# it down to the steady-state uncertainty quickly, small enough not to blow up the
    86	# Mahalanobis gate on the very next vision fix.
    87	_INIT_V_STD = 80.0           # mm/s
    88	_INIT_OMEGA_STD = 1.5         # rad/s
