   287	            if path is None:
   288	                self.nav_fail += 1
   289	                self.stats.nav_failures += 1
   290	                return 0.0, 0.0, "fail" if self.nav_fail > self.p.max_nav_failures else "wait"
   291	            from ..planning.navigation import swept_polygons
   292	            from ..geometry.footprint import Footprint
   293	            region = swept_polygons(Footprint(self.cfg.rover), path) + extra_region
   294	            if not ctx.commit_region(self.id, region, priority):
   295	                return 0.0, 0.0, "wait"
   296	            self.path, self.seg_i = path, 0
   297	            self.nav_t0 = t
   298	            if self.path.segments:
   299	                self.follow.reset(self.path.segments[0])
   300	        if self.seg_i >= len(self.path.segments):
   301	            return 0.0, 0.0, "arrived"
   302	        if t - self.nav_t0 > self.p.nav_timeout_factor * self.path.cost_s + 10.0:
   303	            self.path = None
   304	            return 0.0, 0.0, "wait"
   305	        seg = self.path.segments[self.seg_i]
   306	        v, w, done = self.follow.step(est, t)
   307	        if seg.kind == SegKind.STRAIGHT:
   308	            _, cross, head = self.follow.tracking_error()
   309	            if abs(cross) > self.p.nav_track_cross_tol or abs(head) > self.p.nav_track_heading_tol:
   310	                ctx.log(self.id, "nav_deviation", cross=cross, head=head)
   311	                self.path = None
