   198	    # ------------------------------------------------------------------ external interrupts
   199	    def estop(self, t: float, ctx: AgentContext) -> None:
   200	        if self.state not in (S.EMERGENCY_STOP, S.RELOCALIZE, S.IDLE, S.DONE):
   201	            self.resume = self.state
   202	            self.stats.estops += 1
