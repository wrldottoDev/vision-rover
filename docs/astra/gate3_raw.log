   282	    # ---- navigation (also used by YIELD)
   283	    def _navigate_to(self, t, est, ctx, goal: Pose, priority: int, extra_region: list[np.ndarray]):
   284	        """Returns (v, w, status) status in {'moving','arrived','wait','fail'}."""
