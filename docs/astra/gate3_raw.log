    71	def _end_pose(plan: PushPlan, cfg: Config, params: AllocatorParams) -> Pose:
    72	    """Rover pose after finishing `plan`: contact pose at the final leg's cube_end, then backed off
    73	    by contact_distance + an assumed retreat distance along the (unchanged) push heading."""
    74	    last = plan.legs[-1]
    75	    heading = last.heading
    76	    back = cfg.contact_distance + params.retreat_distance_mm
    77	    cx, cy = last.cube_end
    78	    return Pose(cx - back * math.cos(heading), cy - back * math.sin(heading), heading)
