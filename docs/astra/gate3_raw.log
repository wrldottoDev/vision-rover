   123	            c = tr.estimate(self.t)
   124	            alpha = c.alpha if (c.alpha is not None and c.alpha_std < math.radians(15)) else None
   125	            r = cube_half_extent(self.cfg.cube.side, alpha) + m.cube_nav + min(c.pos_std, 15.0)
   126	            out.append(DiscObstacle(c.x, c.y, r))
