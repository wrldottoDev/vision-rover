   118	# --------------------------------------------------------------------------- hard safety layer
   119	def _rollout(est: RoverEstimate, t: float) -> tuple[float, float, float]:
   120	    """Constant-twist (v, omega) rollout of a rover pose forward by `t` seconds."""
   121	    x0, y0, th0 = est.pose.x, est.pose.y, est.pose.theta
   122	    w = est.omega
   123	    if abs(w) < 1e-6:
   124	        return x0 + est.v * math.cos(th0) * t, y0 + est.v * math.sin(th0) * t, th0
   125	    th1 = th0 + w * t
   126	    x1 = x0 + (est.v / w) * (math.sin(th1) - math.sin(th0))
   127	    y1 = y0 - (est.v / w) * (math.cos(th1) - math.cos(th0))
   128	    return x1, y1, th1
