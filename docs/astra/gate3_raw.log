    97	def _trim_keep_anchor(history: list, cutoff: float) -> list:
    98	    """Keep entries with t >= cutoff, plus the single entry immediately before cutoff
    99	    (so a later rewind to a time right at the edge still has something to start from)."""
   100	    if not history:
   101	        return history
   102	    keep_from = len(history) - 1
   103	    for i, e in enumerate(history):
   104	        if e[0] >= cutoff:
   105	            keep_from = max(0, i - 1)
   106	            break
   107	    return history[keep_from:]
