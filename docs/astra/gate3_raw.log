    95	def _work_region(plan: PushPlan, cfg: Config) -> S.Poly:
    96	    """Convex hull of everything the rover physically occupies while running `plan`: its footprint at
    97	    every leg's prepush pose plus the cube's start/end points on each leg."""
    98	    fp = Footprint(cfg.rover)
    99	    pts = [fp.envelope(plan.legs[0].prepush.x, plan.legs[0].prepush.y, plan.legs[0].prepush.theta)]
   100	    for leg in plan.legs:
   101	        pts.append(fp.envelope(leg.prepush.x, leg.prepush.y, leg.prepush.theta))
   102	        pts.append(np.array([leg.cube_start]))
   103	        pts.append(np.array([leg.cube_end]))
   104	    return S.hull(np.vstack(pts))
