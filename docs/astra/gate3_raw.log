   175	        m = self.margins.prepush_clearance + self.margins.pose_uncertainty
   176	        tips = self.rover.x_paddle_tip + self.cube.half_diag + m
   177	        sweep = self.rover.sweep_radius + self.cube.half_diag + m
   178	        return max(tips, sweep)
