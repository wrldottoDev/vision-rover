    62	        depots[str(d["color"])] = DepotZone(str(d["color"]), x, y, cfg.depot.half_size)
    63	
    64	    obstacles = tuple(grid.to_internal_xy(_num(o, "col"), _num(o, "row")) for o in msg.get("obstacles", []))
    65	    return Frame(seq=int(msg["seq"]), t_capture=t_cap, t_received=t_received, phase=str(msg["phase"]),
    66	                 board_w=grid.cols * grid.cell_mm, board_h=grid.rows * grid.cell_mm,
    67	                 rovers=rovers, cubes=cubes, depots=depots, obstacles=obstacles)

