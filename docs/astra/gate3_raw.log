   435	              and c.half - self.p.capture_depth_tol <= depth <= c.half_diag + self.p.capture_depth_tol)
   436	        ctx.log(self.id, "verify_capture", ok=ok, xl=round(xl, 1), yl=round(yl, 1), depth=round(depth, 1), n=n)
   437	        if not ok:
