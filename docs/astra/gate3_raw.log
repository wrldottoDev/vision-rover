   201	    def log(self, rid: int, event: str, **kw) -> None:
   202	        self.events.append((round(self.t, 3), rid, event, kw))
   203	
   204	    # ================================================================== main tick
   205	    def tick(self, t: float) -> dict[int, WheelCommand]:
   206	        self.t = t
   207	        if not hasattr(self, "committed"):
   208	            self.committed = {i: [] for i in self.ids}
   209	        ests: dict[int, RoverEstimate] = {}
   210	        for rid in self.ids:
   211	            if rid in self.est:
   212	                self.est[rid].predict(t)
   213	                ests[rid] = self.est[rid].estimate(t)
   214	        feed_stale = (t - self.newest_capture) > self.p.stale_feed_s
   215	        if self.phase != "RUNNING" or feed_stale or len(ests) < 1:
   216	            return self._stop_all(t, "phase" if self.phase != "RUNNING" else "stale feed")
   217	
   218	        self._refresh_reservations(ests)
   219	        self._allocate(t, ests)
   220	
   221	        for rid in self.ids:
   222	            a = self.agents[rid]
   223	            if rid not in ests:
   224	                self.cmd[rid] = (0.0, 0.0)
   225	                continue
   226	            safe = self.est[rid].is_safe_to_drive(t)
   227	            self.cmd[rid] = a.step(t, ests[rid], safe, self)
   228	
   229	        self._safety_layer(t, ests)
   230	        self._resolve_deadlock(t, ests)
   231	        out = {}
   232	        for rid in self.ids:
   233	            v, w = self.cmd[rid]
   234	            wc = WheelCommand.from_unicycle(v, w, self.cfg.rover.track_width, self.cfg.limits.wheel_speed_max)
   235	            v2, w2 = wc.unicycle(self.cfg.rover.track_width)
   236	            if rid in self.est:
   237	                self.est[rid].set_command(t, v2, w2)
   238	            out[rid] = wc
   239	        return out
   240	
   241	    def _stop_all(self, t: float, why: str) -> dict[int, WheelCommand]:
   242	        for rid in self.ids:
   243	            self.cmd[rid] = (0.0, 0.0)
   244	            if rid in self.est:
   245	                self.est[rid].set_command(t, 0.0, 0.0)
   246	        return {rid: STOP for rid in self.ids}
   247	
   248	    # ================================================================== reservations
   249	    def _refresh_reservations(self, ests: dict[int, RoverEstimate]) -> None:
   250	        moving = {S.NAVIGATE, S.YIELD, S.ALIGN, S.CAPTURE, S.VERIFY_CAPTURE, S.PUSH, S.VERIFY_DELIVERY, S.RETREAT}
   251	        for rid, e in ests.items():
   252	            a = self.agents[rid]
   253	            env = self.fp.envelope(e.pose.x, e.pose.y, e.pose.theta)
   254	            if a.state in moving and self.committed.get(rid):
   255	                region = self.committed[rid] + [env]
   256	            else:
   257	                region = [env]
   258	                self.committed[rid] = []
   259	            self.res.reserve(rid, region, priority(a.state.value, rid), self.t)
   260	
   261	    # ================================================================== allocation
   262	    def _allocate(self, t: float, ests: dict[int, RoverEstimate]) -> None:
   263	        idle = [rid for rid in self.ids if self.agents[rid].state == S.IDLE and rid in ests
   264	                and self.est[rid].is_safe_to_drive(t)]
   265	        if not idle:
   266	            return
   267	        free = [c for c in self.cubes if c not in self.delivered and c not in self.claimed
   268	                and self.cooldown.get(c, -1) <= t and c in self.depots]
   269	        # A delivered cube that got knocked out must be re-delivered.
   270	        for c in list(self.delivered):
   271	            if not self.is_delivered_now(c):
   272	                self.delivered.discard(c)
   273	                self.log(-1, "delivery_undone", color=c)
   274	        if not free:
   275	            if all(c in self.delivered for c in self.cubes if c in self.depots) and not self.claimed:
   276	                for rid in idle:
   277	                    self.agents[rid].state = S.DONE
   278	            return
   279	        plans = {}
   280	        for c in free:
   281	            cube = self.cube(c)
   282	            others = [self.cube(o) for o in self.cubes if o != c]
   283	            ps = self.pusher.plan(cube, self.depots[c], others, self.board_w, self.board_h, max_plans=3)
   284	            if ps:
   285	                plans[c] = ps
   286	            else:
   287	                self.cooldown[c] = t + self.p.failed_cube_cooldown_s
   288	                self.log(-1, "no_plan", color=c, why=self.pusher.last_failure)
   289	        if not plans:
   290	            return
   291	        rovers = {rid: ests[rid] for rid in ests if self.est[rid].is_safe_to_drive(t)}
   292	        locked = {rid: (self.agents[rid].task.color if self.agents[rid].task else None) for rid in rovers}
   293	        alloc = self.alloc.allocate(rovers, plans, locked)
   294	        for rid in idle:
   295	            seq = alloc.sequences.get(rid, [])
   296	            if not seq:
   297	                continue
   298	            color, plan = seq[0]
   299	            if color in self.claimed:
   300	                continue
   301	            self.claimed[color] = rid
   302	            self.agents[rid].assign(Task(color, plan), t, self)
   303	
   304	    def is_delivered_now(self, color: str) -> bool:
   305	        c = self.cube(color)
   306	        d = self.depots.get(color)
   307	        if c is None or d is None:
   308	            return False
   309	        return d.contains_cube(c.x, c.y, self.cfg.cube.side, c.alpha if c.alpha is not None else None, -3.0)
   310	
   311	    # ================================================================== safety layer
   312	    def _safety_layer(self, t: float, ests: dict[int, RoverEstimate]) -> None:
   313	        # 1) board guard: stop a rover whose predicted envelope leaves the field (not while engaged: corridor verified).
   314	        for rid, e in ests.items():
   315	            a = self.agents[rid]
   316	            v, w = self.cmd[rid]
   317	            h = self.p.board_guard_lookahead_s
   318	            th = e.pose.theta + w * h
   319	            x = e.pose.x + v * h * math.cos(e.pose.theta + w * h / 2)
   320	            y = e.pose.y + v * h * math.sin(e.pose.theta + w * h / 2)
   321	            env = self.fp.envelope(x, y, th)
   322	            if not shapes.inside_rect(env, -2.0, self.board_w + 2.0, -2.0, self.board_h + 2.0) and (v != 0 or w != 0):
   323	                moving_out = not shapes.inside_rect(self.fp.envelope(e.pose.x, e.pose.y, e.pose.theta),
   324	                                                    -2.0, self.board_w + 2.0, -2.0, self.board_h + 2.0) is False
   325	                self.log(rid, "board_guard", state=a.state.value)
   326	                self.cmd[rid] = (0.0, 0.0)
   327	        # 2) rover-rover imminent collision on commanded twists.
   328	        if len(ests) == 2:
   329	            a_id, b_id = self.ids
   330	            if a_id in ests and b_id in ests:
   331	                ea, eb = self._with_cmd(ests[a_id], a_id), self._with_cmd(ests[b_id], b_id)
   332	                if imminent_collision(ea, eb, self.p.estop_horizon_s, self.cfg):
   333	                    pa = priority(self.agents[a_id].state.value, a_id)
   334	                    pb = priority(self.agents[b_id].state.value, b_id)
   335	                    low, high = (a_id, b_id) if pa < pb else (b_id, a_id)
   336	                    self._estop(low, t)
   337	                    eh = self._with_cmd(ests[high], high)
   338	                    el = self._with_cmd(ests[low], low)
   339	                    if imminent_collision(eh, el, self.p.estop_horizon_s, self.cfg):
   340	                        self._estop(high, t)
   341	                else:
   342	                    for rid in (a_id, b_id):
   343	                        if self.agents[rid].state == S.EMERGENCY_STOP:
   344	                            since = self.estop_since.setdefault(rid, t)
   345	                            if t - since >= self.p.estop_clear_s:
   346	                                self.estop_since.pop(rid, None)
   347	                                self.agents[rid].clear_estop(t, self)
   348	
   349	    def _with_cmd(self, e: RoverEstimate, rid: int) -> RoverEstimate:
   350	        v, w = self.cmd[rid]
   351	        return RoverEstimate(e.id, e.pose, v, w, e.cov, e.age_s, e.quality)
   352	
   353	    def _estop(self, rid: int, t: float) -> None:
   354	        self.cmd[rid] = (0.0, 0.0)
   355	        self.estop_since.pop(rid, None)
   356	        if self.agents[rid].state != S.EMERGENCY_STOP:
   357	            self.log(rid, "estop")
   358	            self.agents[rid].estop(t, self)
   359	
   360	    # ================================================================== deadlock / yield
   361	    def _resolve_deadlock(self, t: float, ests: dict[int, RoverEstimate]) -> None:
   362	        if len(self.ids) != 2 or any(r not in ests for r in self.ids):
   363	            return
   364	        a, b = (self.agents[i] for i in self.ids)
   365	        for waiter, other in ((a, b), (b, a)):
   366	            stuck = waiter.state in (S.WAIT, S.EMERGENCY_STOP) and waiter.task is not None
   367	            if not stuck:
   368	                continue
   369	            if not hasattr(waiter, "wait_since") or waiter.wait_since is None:
   370	                waiter.wait_since = t
   371	            if t - waiter.wait_since < self.p.deadlock_wait_s:
   372	                continue
   373	            other_passive = other.state in (S.IDLE, S.DONE, S.WAIT, S.EMERGENCY_STOP, S.RELOCALIZE)
   374	            if not other_passive:
   375	                continue
   376	            # who yields: the one with lower priority; passive-without-task always yields to the one with a task
   377	            if other.task is None:
   378	                yielder, keeper = other, waiter
   379	            else:
   380	                pw = priority(waiter.state.value, waiter.id) + (10 if waiter.task else 0)
   381	                po = priority(other.state.value, other.id) + (10 if other.task else 0)
   382	                yielder, keeper = (other, waiter) if po < pw or (po == pw and other.id > waiter.id) else (waiter, other)
   383	            if yielder.state in CUBE_ENGAGED:
   384	                continue
   385	            goal = self._parking_pose(yielder.id, keeper, ests)
   386	            if goal is not None:
   387	                self.log(yielder.id, "yield", for_rover=keeper.id)
   388	                yielder.order_yield(goal, t, self)
   389	                waiter.wait_since = None
   390	        for ag in (a, b):
   391	            if ag.state not in (S.WAIT, S.EMERGENCY_STOP):
   392	                ag.wait_since = None
   393	
   394	    def _keeper_region(self, keeper: RoverAgent, ests) -> list[np.ndarray]:
   395	        region = [self.fp.envelope(ests[keeper.id].pose.x, ests[keeper.id].pose.y, ests[keeper.id].pose.theta)]
   396	        if keeper.task:
   397	            path = self.plan_nav(keeper.id, keeper.leg.prepush, ignore_other=True)
   398	            if path is not None:
   399	                region += swept_polygons(self.fp, path)
   400	            region += keeper._leg_region()
   401	        return region
   402	
   403	    def _parking_pose(self, rid: int, keeper: RoverAgent, ests) -> Pose | None:
   404	        region = self._keeper_region(keeper, ests)
   405	        me = ests[rid].pose
   406	        m = self.cfg.margins
   407	        cubes = self._cube_obstacles()
   408	        cands = []
   409	        step = 60.0
   410	        for x in np.arange(80.0, self.board_w - 60.0, step):
   411	            for y in np.arange(80.0, self.board_h - 60.0, step):
   412	                for th in (0.0, math.pi / 2, math.pi, -math.pi / 2):
   413	                    env = self.fp.envelope(x, y, th)
   414	                    if not shapes.inside_rect(env, m.board, self.board_w - m.board, m.board, self.board_h - m.board):
   415	                        continue
   416	                    if any(shapes.disc_distance(env, (c.x, c.y), c.r) <= 0 for c in cubes):
   417	                        continue
   418	                    if any(shapes.distance(env, r) < m.rover_rover for r in region):
   419	                        continue
   420	                    cands.append((math.hypot(x - me.x, y - me.y) + 20 * abs(wrap(th - me.theta)), x, y, th))
   421	        cands.sort()
   422	        for _, x, y, th in cands[:6]:
   423	            goal = Pose(float(x), float(y), th)
   424	            if self.plan_nav(rid, goal) is not None:
   425	                return goal
   426	        return None

