   102	        # Fresh observation: predict the running covariance to t_capture, then correct.
   103	        elapsed = max(0.0, t_capture - self._last_fresh_t)
   104	        q_rate = self._process_var_rate()
   105	        self._Pxx += q_rate * elapsed
   106	        self._Pyy += q_rate * elapsed
   107	
   108	        dist = math.hypot(x - self._x, y - self._y)
