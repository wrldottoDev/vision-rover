    87	                    continue
    88	                break
    89	        return sorted(hits)
    90	
    91	    def as_obstacles(self, for_rover: int) -> list[np.ndarray]:
    92	        """The other rover's reserved area, inflated by cfg.margins.rover_rover, as static obstacle
    93	        polygons a path planner for `for_rover` can route around."""
    94	        margin = self.cfg.margins.rover_rover
