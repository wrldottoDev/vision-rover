   124	def distribute_cubes(cubes: list[str], rover_ids: list[int]) -> Iterator[dict[int, list[str]]]:
   125	    """Every way to split `cubes` (order matters, order = execution sequence) across `rover_ids`
   126	    (1 or 2 of them).  For n cubes and 2 rovers this yields n! * (n+1) distributions."""
   127	    if len(rover_ids) == 1:
