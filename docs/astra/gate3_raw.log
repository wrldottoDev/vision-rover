   211	        self._go(S.YIELD, t, ctx)
   212	
   213	    # ------------------------------------------------------------------ main step
   214	    def step(self, t: float, est: RoverEstimate, safe: bool, ctx: AgentContext) -> tuple[float, float]:
   215	        dt = max(1e-3, t - self._last_t)
   216	        self._last_t = t
   217	        if not safe and self.state not in (S.RELOCALIZE, S.IDLE, S.DONE):
   218	            self.resume = self.resume if self.state in (S.EMERGENCY_STOP, S.WAIT) else self.state
   219	            self._go(S.RELOCALIZE, t, ctx, "estimate unsafe")
   220	        handler = getattr(self, "_s_" + self.state.value.lower())
   221	        v, w = handler(t, est, safe, ctx)
   222	        if self.state == S.WAIT:
   223	            self.stats.waits_s += dt
   224	        return v, w
