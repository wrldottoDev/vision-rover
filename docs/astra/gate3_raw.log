   152	def _sequence_timing(rover_id: int, seq: list[tuple[str, PushPlan]], start_pose: Pose,
   153	                      cfg: Config, params: AllocatorParams,
   154	                      nav_time: Callable[[Pose, Pose], float]) -> tuple[float, list[_Timing]]:
