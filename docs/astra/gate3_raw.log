    32	        msg = json.loads(msg)
    33	    if msg.get("v") != PROTOCOL_VERSION:
    34	        raise TelemetryError(f"unsupported protocol version {msg.get('v')!r}")
    35	    g = msg["grid"]
    36	    grid = Grid(int(g["cols"]), int(g["rows"]), _num(g, "cell_mm"))
    37	    t_cap = _num(msg, "ts_ms") / 1000.0
    38	    rg = cfg.rover
    39	
    40	    rovers: dict[int, RoverObs] = {}
    41	    for r in msg.get("rovers", []):
    42	        try:
    43	            x, y, th = grid.to_internal_pose(_num(r, "col"), _num(r, "row"), _num(r, "theta"))
    44	            age = max(0.0, _num(r, "age_ms") / 1000.0)
    45	            bx, by, bth = marker_to_body(x, y, th, rg.marker_offset_fwd, rg.marker_offset_left, rg.marker_angle_offset)
    46	            rovers[int(r["id"])] = RoverObs(int(r["id"]), Pose(bx, by, bth), t_cap - age, age)
    47	        except (KeyError, TypeError, TelemetryError):
    48	            continue
    49	
    50	    cubes: dict[str, CubeObs] = {}
    51	    for c in msg.get("cubes", []):
    52	        try:
    53	            x, y = grid.to_internal_xy(_num(c, "col"), _num(c, "row"))
    54	            age = max(0.0, _num(c, "age_ms") / 1000.0)
    55	            cubes[str(c["color"])] = CubeObs(str(c["color"]), x, y, t_cap - age, age)
    56	        except (KeyError, TypeError, TelemetryError):
