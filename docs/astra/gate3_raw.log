    27	    def envelope(self, x: float, y: float, th: float) -> Poly:
    28	        return transform(self._env, x, y, th)
    29	
    30	    def parts(self, x: float, y: float, th: float) -> list[Poly]:
    31	        return [transform(p, x, y, th) for p in (self._body, self._pl, self._pr)]
    32	
    33	    def straight_sweep(self, x: float, y: float, th: float, dist: float) -> Poly:
    34	        """Convex region swept by the envelope translating `dist` along heading (negative = reverse)."""
    35	        a = self.envelope(x, y, th)
    36	        b = self.envelope(x + dist * math.cos(th), y + dist * math.sin(th), th)
    37	        return hull(np.vstack([a, b]))
