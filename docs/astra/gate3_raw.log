   106	def _inflate_poly(P: np.ndarray, margin: float, n_dirs: int = 12) -> np.ndarray:
   107	    """Conservative outward offset of a convex polygon by `margin`, via the exact Minkowski sum with
   108	    a regular n_dirs-gon whose INradius equals margin (so real offset >= margin everywhere).
   109	    ponytail: n-gon approximation of a disc offset; swap for an exact circular offset if margins get tight."""
   110	    if margin <= 0:
   111	        return P
   112	    r = margin / math.cos(math.pi / n_dirs)
   113	    dirs = np.array([[math.cos(2 * math.pi * k / n_dirs), math.sin(2 * math.pi * k / n_dirs)] for k in range(n_dirs)])
   114	    pts = np.vstack([P + d * r for d in dirs])
   115	    return S.hull(pts)
