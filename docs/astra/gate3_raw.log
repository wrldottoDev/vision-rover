   320	    def _leg_region(self) -> list[np.ndarray]:
   321	        """Push corridor of the current leg (reserved together with the approach path)."""
   322	        from ..geometry.footprint import Footprint
   323	        leg = self.leg
   324	        fp = Footprint(self.cfg.rover)
   325	        pre = leg.prepush
   326	        travel = math.hypot(leg.cube_end[0] - pre.x, leg.cube_end[1] - pre.y) - self.cfg.contact_distance
   327	        back = -(self.cfg.rover.paddle_reach + self.p.retreat_extra)
   328	        end = pre.moved(max(0.0, travel))
   329	        return [fp.straight_sweep(pre.x, pre.y, pre.theta, max(0.0, travel)),
   330	                fp.straight_sweep(end.x, end.y, end.theta, back)]
