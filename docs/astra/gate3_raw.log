    22	        self._body = rect(g.x_rear, g.x_front_plate, -g.outer_half_width, g.outer_half_width)
    23	        self._pl = rect(g.x_front_plate, g.x_paddle_tip, g.inner_half_width, g.outer_half_width)
    24	        self._pr = rect(g.x_front_plate, g.x_paddle_tip, -g.outer_half_width, -g.inner_half_width)
