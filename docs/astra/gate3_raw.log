   107	def _seg_point_dist(a: np.ndarray, b: np.ndarray, p: np.ndarray) -> float:
   108	    ab = b - a
   109	    denom = float(np.dot(ab, ab))
   110	    t = 0.0 if denom < 1e-12 else float(np.clip(np.dot(p - a, ab) / denom, 0.0, 1.0))
   111	    return float(np.linalg.norm(a + t * ab - p))
