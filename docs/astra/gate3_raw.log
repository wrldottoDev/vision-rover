    81	def default_nav_time(a: Pose, b: Pose, cfg: Config = DEFAULT, params: AllocatorParams | None = None) -> float:
    82	    """Rotate to face b, drive the straight-line distance (inflated by a detour factor to account for
    83	    obstacles not modelled here), rotate to b's heading."""
    84	    params = params or AllocatorParams()
    85	    dx, dy = b.x - a.x, b.y - a.y
    86	    d = math.hypot(dx, dy)
    87	    if d < 1e-6:
    88	        return abs(angle_diff(b.theta, a.theta)) / cfg.limits.w_nav
    89	    heading = math.atan2(dy, dx)
    90	    rot1 = abs(angle_diff(heading, a.theta))
    91	    rot2 = abs(angle_diff(b.theta, heading))
    92	    return (rot1 + rot2) / cfg.limits.w_nav + d * params.detour_factor / cfg.limits.v_nav
