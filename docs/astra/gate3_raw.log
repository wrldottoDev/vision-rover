   480	    def _s_verify_delivery(self, t, est, safe, ctx):
   481	        if self.dwell(t) < self.p.verify_s:
   482	            return 0.0, 0.0
   483	        if ctx.is_delivered(self.task.color, t):
   484	            self._begin_retreat(t, ctx, "delivered")
   485	            return 0.0, 0.0
   486	        if self.dwell(t) < self.p.verify_timeout_s:
   487	            return 0.0, 0.0
   488	        # Not (yet) confirmed.  Small corrective push if the cube is still in the channel, else replan.
   489	        self.task.delivery_attempts += 1
   490	        obs = ctx.fresh_cube(self.task.color, t, 0.6)
   491	        if obs is not None and self.task.delivery_attempts <= self.p.delivery_retries:
   492	            xl, yl = self._cube_local(est, obs[0])
   493	            dp = np.array(self.task.plan.delivery_point) - obs[0]
   494	            ahead = float(np.dot(dp, est.pose.forward()))
   495	            if abs(yl) <= self.cfg.rover.inner_half_width - self.cfg.cube.half and ahead > 2.0:
   496	                self.pusher.reset(obs[0], np.array(self.task.plan.delivery_point, float))
   497	                self.push_budget = 8.0
   498	                self._go(S.PUSH, t, ctx, "corrective push")
   499	                return 0.0, 0.0
   500	        self._fail_task(t, ctx, "delivery not confirmed")
   501	        return 0.0, 0.0
