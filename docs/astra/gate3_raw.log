    98	    def trim(self, rover_id: int, progress_polygons: list[np.ndarray]) -> None:
    99	        """Drop whichever of `rover_id`'s reserved polygons overlap the area already traversed."""
   100	        res = self._res.get(rover_id)
   101	        if res is None:
