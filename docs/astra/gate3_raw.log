   176	        self.stats.replans += 1
   177	        if self.task.failures >= self.p.max_task_failures:
   178	            ctx.release_task(self.id, self.task.color, failed=True, t=t)
   179	            self.task = None
   180	            self._go(S.IDLE, t, ctx, "too many failures")
   181	            return
   182	        plan = ctx.plan_push(self.id, self.task.color)
   183	        if plan is None:
   184	            ctx.release_task(self.id, self.task.color, failed=True, t=t)
   185	            self.task = None
   186	            self._go(S.IDLE, t, ctx, "no push plan")
   187	            return
   188	        self.task.plan, self.task.leg = plan, 0
   189	        self._start_nav(t, ctx)
