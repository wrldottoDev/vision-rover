   241	    def _s_emergency_stop(self, t, est, safe, ctx):
   242	        return 0.0, 0.0     # the supervisor calls clear_estop()
   243	
   244	    def clear_estop(self, t: float, ctx: AgentContext) -> None:
   245	        if self.state == S.EMERGENCY_STOP:
   246	            self._resume(t, ctx)
   247	
   248	    def _resume(self, t, ctx):
   249	        r, self.resume = self.resume, None
   250	        if r in (S.PUSH, S.CAPTURE, S.VERIFY_DELIVERY):
   251	            self._go(S.VERIFY_CAPTURE if r != S.VERIFY_DELIVERY else S.VERIFY_DELIVERY, t, ctx, "resume")
