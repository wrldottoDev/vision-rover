   1 """Nivel N3: capa geometrica de planificacion, barridos globales."""
   2 from __future__ import annotations
   3 import math, sys
   4 import numpy as np
   5 sys.path.insert(0, '/tmp/bench')
   6 from modelo import *
   7 from arnes import prueba, resumen, volcar
   8 
   9 # ------------------------------------------------------------- parametros ---
  10 CELL   = 20.0
  11 COLS   = 43.0
  12 BORDE  = 3.5                      # borde muerto del tablero fisico, en celdas
  13 L      = 60.0                     # mm
  14 # DIMENSIONES REALES, medidas del archivo de fabricacion oficial
  15 # archivos_fabricacion/CENFOBOT_Rover_Rev1.dxf (escala confirmada por las
  16 # ranuras de 3.00 mm del acrilico y por el ultrasonico: 2 discos de 16.15 mm
  17 # separados 24.00 mm, patron estandar HC-SR04).
  18 # Dos anchos DISTINTOS, y confundirlos es un error:
  19 #   W_EXT  = huella exterior, punta a punta de las lenguetas. Gobierna colision,
  20 #            punto de puesta y frontera.
  21 #   W_CANAL= separacion entre las caras INTERNAS de los paneles laterales.
  22 #            Gobierna la captura del cubo (teorema del embudo).
  23 # El chasis mide 93.50 mm de cuerpo con lenguetas de 3.00 mm por lado (= espesor
  24 # del acrilico, junta pasante), asi que las caras internas de los paneles
  25 # coinciden con los bordes del cuerpo del chasis.
  26 W_EXT   = 99.50
  27 W_CANAL = 93.50
  28 W      = W_EXT      # por defecto, la huella
  29 LAM    = 94.00      # largo del chasis
  30 # MEDIDO sobre el rover fisico (regla, +-1 mm). Confirma el DXF:
  31 #   ancho total 100 (DXF 99.50), canal 95 (DXF 93.50),
  32 #   largo total 150 = chasis 94 + paletas 55  -> el DXF cierra exacto.
  33 LAMBDA  = 55.0      # alcance de las paletas por delante de la placa frontal
  34 # La huella NO es simetrica respecto del centro del chasis: hacia atras llega
  35 # LAM/2, hacia adelante LAM/2 + LAMBDA (las paletas). Ignorar esto subestima
  36 # el radio envolvente en un 67 %, que es un error del lado peligroso.
  37 X_ATRAS = -LAM / 2.0
  38 X_ADEL  = LAM / 2.0 + LAMBDA
  39 HW      = W_EXT / 2.0
  40 RROV_ASIM = math.hypot(X_ADEL, HW)      # disco envolvente centrado en el chasis
  41 S_MARG = 40.0
  42 RROV   = R_rov(W, LAM)            # mm
  43 RHO_PU = rho_puesta(L, LAM, S_MARG)
  44 RHO_CT_MIN = L / 2 + LAM / 2
  45 RHO_CT_MAX = L * math.sqrt(2) / 2 + LAM / 2
  46 V      = 6.0 * CELL               # mm/s   (velocidad_rover_celdas_s = 6)
  47 OM     = 90.0                     # grados/s
  48 DEPOTS = {'green': np.array([40.5, 2.5]), 'blue': np.array([2.5, 40.5]),
  49           'red':   np.array([40.5, 40.5])}
  50 rng = np.random.default_rng(20260902)
  51 
  52 # limites del tablero fisico en celdas
  53 TAB_MIN, TAB_MAX = -BORDE, COLS + BORDE
  54 
  55 
  56 def dentro_tablero(p, margen_mm=0.0):
  57     m = margen_mm / CELL
  58     p = np.atleast_2d(p)
  59     return np.all((p >= TAB_MIN + m) & (p <= TAB_MAX - m), axis=1)
  60 
  61 
  62 # ------------------------------------------------------------------ N3.1 ----
  63 
  64 @prueba('N3.1', 'Mapa de factibilidad del punto de puesta')
  65 def n31(r):
  66     """Dos modelos de cuerpo: disco envolvente (conservador) y rectangulo orientado."""
  67     paso = 0.25
  68     g = np.arange(0.0, COLS + 1e-9, paso)
  69     X, Y = np.meshgrid(g, g, indexing='ij')
  70     C = np.stack([X.ravel(), Y.ravel()], axis=1)
  71 
  72     def factible(gv, modelo):
  73         D = gv[None, :] - C
  74         n = np.linalg.norm(D, axis=1)
  75         m = n > 1e-9
  76         d = np.zeros_like(D); d[m] = D[m] / n[m, None]
  77         A = C - (RHO_PU / CELL) * d
  78         if modelo == 'disco':
  79             ok = dentro_tablero(A, RROV)
  80         else:
  81             # rectangulo orientado segun phi* = rumbo hacia el deposito
  82             phi = arg_de(d)
  83             up = u(phi); pe = u(phi + 90.0)
  84             hl, hw = (LAM / 2) / CELL, (W / 2) / CELL
  85             ok = np.ones(len(C), bool)
  86             for sa in (-1, 1):
  87                 for sb in (-1, 1):
  88                     esq = A + sa * hl * up + sb * hw * pe
  89                     ok &= dentro_tablero(esq, 0.0)
  90         ok[~m] = True
  91         return ok, d
  92 
  93     print()
  94     print('           %-8s %14s %14s %16s' % ('deposito', 'inviab_disco', 'inviab_rect', 'banda_teorica_c'))
  95     fr_d = {}; fr_r = {}
  96     for color, gv in DEPOTS.items():
  97         okd, _ = factible(gv, 'disco')
  98         okr, _ = factible(gv, 'rect')
  99         fr_d[color] = 1.0 - okd.mean(); fr_r[color] = 1.0 - okr.mean()
 100         print('           %-8s %13.2f%% %13.2f%% %16.2f'
 101               % (color, 100 * fr_d[color], 100 * fr_r[color], RHO_PU / CELL))
 102         r.metrica('inviable_%s_disco_pct' % color, 100 * fr_d[color])
 103         r.metrica('inviable_%s_rect_pct' % color, 100 * fr_r[color])
 104 
 105     # --- geometria de la region: debe estar del lado OPUESTO al deposito -----
 106     gv = DEPOTS['green']
 107     okr, d = factible(gv, 'rect')
 108     inv = C[~okr]
 109     dist_inv = np.linalg.norm(inv - gv, axis=1) if len(inv) else np.array([0.0])
 110     dist_all = np.linalg.norm(C - gv, axis=1)
 111     lado_ok = bool(dist_inv.mean() > dist_all.mean())
 112     r.metrica('dist_media_inviable_c', float(dist_inv.mean()))
 113     r.metrica('dist_media_cancha_c', float(dist_all.mean()))
 114     r.metrica('region_del_lado_opuesto', lado_ok)
 115 
 116     # --- espesor de la banda medido sobre el eje x, para el deposito verde ---
 117     # (el deposito verde esta a col alta, asi que la banda inviable esta a col baja)
 118     inv_x = inv[:, 0] if len(inv) else np.array([np.nan])
 119     r.metrica('banda_col_max_c', float(np.nanmax(inv_x)) if len(inv) else 0.0)
 120     r.metrica('banda_teorica_c', RHO_PU / CELL)
 121 
 122     # --- verificacion cruzada: un punto factible debe tener puesta valida ----
 123     idx = rng.choice(len(C), 5000, replace=False)
 124     incoherencias = 0
 125     for i in idx:
 126         c = C[i]
 127         dd = gv - c; nn = np.linalg.norm(dd)
 128         if nn < 1e-9: continue
 129         a = c - (RHO_PU / CELL) * (dd / nn)
 130         phi = float(arg_de(dd / nn))
 131         up = u(phi); pe = u(phi + 90.0)
 132         hl, hw = (LAM / 2) / CELL, (W / 2) / CELL
 133         esqs = np.array([a + sa * hl * up + sb * hw * pe
 134                          for sa in (-1, 1) for sb in (-1, 1)])
 135         dentro = bool(np.all(dentro_tablero(esqs, 0.0)))
 136         if dentro != bool(okr[i]):
 137             incoherencias += 1
 138     r.metrica('incoherencias_verificacion', incoherencias)
 139 
 140     print()
 141     print('           HALLAZGO H-05: la fraccion de cancha SIN empuje directo es grande.')
 142     print('           Con el rectangulo real del rover: %.1f%% de las posiciones de cubo.' % (100 * fr_r['green']))
 143     print('           El empuje multi-tramo NO es una rama muerta: hace falta para 1 de cada %.1f'
 144           % (1.0 / fr_r['green']))
 145     print('           posiciones posibles del cubo.')
 146     r.nota('HALLAZGO H-05: %.1f%% de la cancha (modelo rectangulo) no admite empuje directo'
 147            % (100 * fr_r['green']))
 148     r.nota('el modelo enunciaba la region cualitativamente; cuantificada resulta mayoritariamente')
 149     r.nota('relevante: el empuje multi-tramo es obligatorio, no opcional.')
 150     r.nota('el disco envolvente sobreestima la region en %.1f puntos porcentuales'
 151            % (100 * (fr_d['green'] - fr_r['green'])))
 152     r.exigir(lado_ok and incoherencias == 0,
 153              'la region debe estar del lado opuesto y ser coherente punto a punto')
