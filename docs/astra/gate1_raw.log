 136 def abrir_fuente(cfg: ConfigVision, args):
 137     """Devuelve `(fuente, descripción)`. Cámara por defecto; sintético si se pide.
 138 
 139     La cámara real pasa además por `FuenteRectificada`, que le quita la
 140     distorsión del lente **antes** de que nadie la mire. Las imágenes generadas
 141     no la necesitan: representan el cuadro ya rectificado a propósito.
 142     """
 143     if args.sintetico:
 144         return FuenteSintetica(cfg), "IMÁGENES GENERADAS (sin cámara)"
 145 
 146     camara = FuenteCamara(cfg.camara, indice=args.indice)
 147     primero, limite = None, time.monotonic() + 10.0
 148     while primero is None and time.monotonic() < limite:
 149         primero = camara.leer()
 150         time.sleep(0.01)
 151     if primero is None:
 152         camara.cerrar()
 153         raise ErrorCamara("la cámara no entregó imágenes")
 154     alto, ancho = primero.imagen.shape[:2]
 155 
 156     perfil = elegir_perfil(cfg.calibracion, BASE_VISION, ancho, alto,
 157                            nombre=args.camara, interactivo=sys.stdin.isatty())
 158     print(comparar_con_camara(perfil, ancho, alto).mensaje())
 159     rectificador = Rectificador(perfil, alpha=cfg.calibracion.alpha, tamano=(ancho, alto))
 160     fuente = FuenteRectificada(camara, rectificador)
 161     fuente.matriz_camara = rectificador.matriz_nueva  # la que necesita la pose
 162     return fuente, "cámara {} ({}x{})".format(perfil.camara, ancho, alto)
 163 
 164 
 165 def procesar(cuadro, cfg, matriz_camara, fase, seguidor, anclaje):
 166     """De un cuadro al estado del mundo. Lanza si la geometría no se puede armar.
 167 
 168     Una sola pasada del detector de ArUco por cuadro: el mismo resultado sirve
 169     para armar las coordenadas y para encontrar los rovers.
 170 
 171     Devuelve `(sistema de coordenadas, estado del mundo)`. El sistema se devuelve
 172     porque la vista lo necesita para dibujar celdas sobre la imagen; el estado es
 173     lo único que cruza hacia los consumidores.
 174 
 175     El estado sale del **seguidor** y no de las detecciones sueltas, porque es
 176     él quien tiene la memoria: si algo no se ve en este cuadro, conserva su
 177     última posición buena y le hace crecer la edad, en vez de que desaparezca.
 178 
 179     Ojo con el orden: si esta función lanza, el seguidor **no se entera** de que
 180     hubo un cuadro. Es lo correcto: un cuadro que no se pudo procesar no es una
 181     observación, y la edad de todos los objetos tiene que seguir creciendo.
 182     """
 183     detectados = detectar_marcadores(cuadro.imagen, cfg.marcadores_esquina.nombre_diccionario)
 184     # El anclaje aguanta que falte UN marcador: conserva la homografía buena y usa
 185     # los tres visibles para comprobar que la cámara no se movió. Con dos o menos,
 186     # o si los tres la desmienten, lanza y el falla-abierto se hace cargo.
 187     sistema = anclaje.actualizar(cuadro.imagen, detectados)
 188     pose = pose_camara(sistema, matriz_camara)
 189     return sistema, seguidor.actualizar(
 190         ts_ms=cuadro.ts_ms,
 191         fase=fase,
 192         rovers=detectar_rovers(detectados, sistema, cfg, pose),
 193         cubos=detectar_cubos(cuadro.imagen, sistema, cfg, pose),
 194     )
 195 
 196 
 197 def _hilo_teclado(arbitro: Arbitro, salir: threading.Event) -> None:
 198     """Lee comandos por consola. La visión es árbitro; esta es su boca."""
 199     for linea in sys.stdin:
 200         if salir.is_set():
 201             return
 202         comando = linea.strip().lower()
 203         if comando in ("quit", "salir"):
 204             salir.set()
 205             return
 206         if comando in _TRANSICIONES:
 207             print("[fase] " + arbitro.intentar(comando), flush=True)
 208         elif comando:
 209             print("[fase] comandos: ready | start | stop | quit", flush=True)
 210     salir.set()
 211 
