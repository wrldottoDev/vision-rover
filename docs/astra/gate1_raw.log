 208     def __init__(self, cfg: ConfigVision):
 209         self._cfg = cfg
 210         self._sistema: SistemaCoordenadas | None = None
 211         #: Cuántos cuadros seguidos se viene conservando la homografía.
 212         self.cuadros_conservados = 0
 213         #: Cuántas esquinas se vieron en el último cuadro.
 214         self.esquinas_visibles = 0
 215         #: Cuánto se desviaron las visibles de donde deberían estar, en mm.
 216         self.desvio_mm = 0.0
 217 
 218     def actualizar(self, imagen: np.ndarray, detectados: dict[int, np.ndarray]) -> SistemaCoordenadas:
 219         """Devuelve el sistema de coordenadas de este cuadro.
 220 
 221         Lanza `ErrorGeometria` cuando no se puede sostener: con dos marcadores o
 222         menos, o cuando los tres visibles delatan que la cámara se movió.
 223         """
 224         esperados = self._cfg.marcadores_esquina.ids_esperados
 225         visibles = sorted(esperados & set(detectados))
 226         self.esquinas_visibles = len(visibles)
 227 
 228         if len(visibles) == 4:
 229             self._sistema = construir_sistema(imagen, self._cfg, detectados)
 230             self.cuadros_conservados = 0
 231             self.desvio_mm = 0.0
 232             return self._sistema
 233 
 234         if self._sistema is None:
 235             raise ErrorGeometria(
 236                 "hacen falta los cuatro marcadores de esquina para arrancar; se ven {}. "
 237                 "Todavía no hay un sistema de coordenadas anterior que conservar.".format(visibles)
 238             )
 239         if len(visibles) < 3:
 240             raise ErrorGeometria(
 241                 "solo se ven {} marcadores de esquina. Con menos de tres no se puede "
 242                 "comprobar que la cámara no se haya movido, así que la homografía "
 243                 "guardada deja de ser confiable.".format(len(visibles))
 244             )
 245 
 246         # Tres visibles: se conserva la homografía y se la somete a los tres.
 247         self.desvio_mm = self._desvio(detectados, visibles)
 248         if self.desvio_mm > self._cfg.marcadores_esquina.desvio_maximo_mm:
 249             self.cuadros_conservados = 0
 250             raise ErrorGeometria(
 251                 "se ven 3 marcadores de esquina y NO confirman la geometría guardada: "
 252                 "se desvían {:.2f} mm, más del máximo de {:.2f}. La cámara se movió, "
 253                 "así que las coordenadas viejas ya no valen.".format(
 254                     self.desvio_mm, self._cfg.marcadores_esquina.desvio_maximo_mm)
 255             )
 256         self.cuadros_conservados += 1
 257         return self._sistema
 258 
 259     def _desvio(self, detectados: dict[int, np.ndarray], visibles: list[int]) -> float:
 260         """Cuánto se apartan los marcadores visibles de donde deberían caer.
 261 
 262         Se los pasa por la homografía guardada y se compara contra la celda que
 263         declara la configuración. Si la cámara no se movió, el desvío es el
 264         ruido de detección; si se movió, se dispara.
 265         """
 266         assert self._sistema is not None
 267         observados = np.array([centro_de(detectados[i]) for i in visibles], dtype=np.float64)
 268         recuperados = self._sistema.a_celdas(observados)
 269         declarados = np.array(
 270             [self._cfg.marcadores_esquina.disposicion[i] for i in visibles], dtype=np.float64
 271         )
 272         distancias = np.linalg.norm(recuperados - declarados, axis=1)
 273         return float(distancias.max()) * self._cfg.tablero.cell_mm
 274 
 275     @property
 276     def conservando(self) -> bool:
 277         """Si el cuadro actual está usando una homografía guardada."""
 278         return self.cuadros_conservados > 0
