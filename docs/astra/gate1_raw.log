   1 """Recalcula el modelo geometrico con las mediciones tomadas sobre el rover fisico.
   2 
   3 Uso tipico, con lo que se haya podido medir (todo es opcional):
   4 
   5     python3 recalcular.py --hueco45 8.7
   6     python3 recalcular.py --hueco45 8.7 --hueco0 33.5 --ancho-max 104 --lam 40
   7     python3 recalcular.py --tres-cubos 180.5 --sesgo-lateral 2.0 --radio-arista 2.0
   8 
   9 El script no supone nada: si no le pasas un valor, usa el del modelo actual (el
  10 deducido del DXF de piezas separadas) y lo marca como MODELO en la salida. Todo lo
  11 que le pases se marca como MEDIDO y manda sobre lo derivado.
  12 
  13 Al final dice explicitamente que conclusiones del informe cambian.
  14 """
  15 import argparse
  16 import math
  17 
  18 # --- valores del modelo actual (DXF de piezas separadas) ---------------------
  19 M_WU = 93.50        # ancho util del canal
  20 M_WEXT = 99.50      # huella exterior
  21 M_LAM = 94.00       # largo del chasis
  22 M_L = 60.00         # arista del cubo
  23 SIG_VIS = 5.00      # incertidumbre de vision adoptada
  24 MARGEN = 3.00       # margen de control que se le reserva al controlador
  25 S_SEG = 40.00       # margen de seguridad del punto de puesta
  26 CELL = 20.0
  27 
  28 
  29 def marca(medido):
  30     return 'MEDIDO ' if medido else 'modelo '
  31 
  32 
  33 def ancho_proyectado(L, delta_deg, r=0.0):
  34     """Anchura proyectada de un cuadrado de lado L girado delta, con aristas de radio r.
  35 
  36     Con aristas vivas (r=0) es la formula clasica L(|cos|+|sin|). El redondeo
  37     recorta las esquinas: el ancho maximo baja de L*sqrt2 a L*sqrt2 - 2r(sqrt2-1).
  38     """
  39     d = math.radians(delta_deg)
  40     w = L * (abs(math.cos(d)) + abs(math.sin(d)))
  41     if r > 0:
  42         # el recorte es proporcional a cuanto se aparta de la posicion alineada
  43         w -= 2 * r * (abs(math.cos(d)) + abs(math.sin(d)) - 1.0)
  44     return w
  45 
  46 
  47 def main():
  48     ap = argparse.ArgumentParser(description=__doc__,
  49                                  formatter_class=argparse.RawDescriptionHelpFormatter)
  50     ap.add_argument('--hueco45', type=float,
  51                     help='M1: hueco junto al cubo girado 45 grados, en mm')
  52     ap.add_argument('--hueco0', type=float,
  53                     help='M2: hueco junto al cubo alineado, en mm')
  54     ap.add_argument('--canal', type=float,
  55                     help='M9: separacion medida directamente entre caras interiores')
  56     ap.add_argument('--ancho-max', type=float,
  57                     help='M7: ancho maximo real del rover incluyendo ruedas')
  58     ap.add_argument('--largo-max', type=float, help='M8: largo maximo real')
  59     ap.add_argument('--lam', type=float, help='M6: alcance de las paletas por delante')
  60     ap.add_argument('--largo-chasis', type=float, default=M_LAM,
  61                     help='largo del chasis (por defecto 94.00, del DXF)')
  62     ap.add_argument('--tres-cubos', type=float,
  63                     help='M11: largo de los tres cubos en fila, en mm')
  64     ap.add_argument('--radio-arista', type=float, default=0.0,
  65                     help='M12: radio de redondeo de las aristas del cubo')
  66     ap.add_argument('--sesgo-lateral', type=float, default=0.0,
  67                     help='M4: descentrado lateral del marcador ArUco, en mm')
  68     ap.add_argument('--sigma-vis', type=float, default=SIG_VIS,
  69                     help='incertidumbre de vision adoptada (por defecto 5 mm)')
  70     a = ap.parse_args()
  71 
  72     # ---------------------------------------------------------------- arista
  73     med_L = a.tres_cubos is not None
  74     L = a.tres_cubos / 3.0 if med_L else M_L
  75     r = a.radio_arista
