 358     imagen = []
 359     for id_aruco in ids:
 360         col, row = sistema.celda_de(*sistema.centros_px[id_aruco])
 361         objeto.append([col * sistema.cell_mm, -row * sistema.cell_mm, 0.0])
 362         imagen.append(list(sistema.centros_px[id_aruco]))
 363 
 364     objeto = np.array(objeto, dtype=np.float64)
 365     imagen = np.array(imagen, dtype=np.float64)
 366 
 367     ok, rvec, tvec = cv2.solvePnP(
 368         objeto, imagen, np.asarray(matriz_camara, dtype=np.float64),
 369         np.zeros(5, dtype=np.float64), flags=cv2.SOLVEPNP_IPPE,
 370     )
 371     if not ok:
 372         raise ErrorGeometria("solvePnP no pudo resolver la pose de la cámara")
 373 
 374     rot, _ = cv2.Rodrigues(rvec)
 375     # El centro óptico en coordenadas del mundo.
 376     centro = (-rot.T @ tvec).ravel()
 377 
 378     reproyectado, _ = cv2.projectPoints(
 379         objeto, rvec, tvec, np.asarray(matriz_camara, dtype=np.float64),
 380         np.zeros(5, dtype=np.float64),
 381     )
 382     error = float(np.linalg.norm(reproyectado.reshape(-1, 2) - imagen, axis=1).max())
 383 
 384     return PoseCamara(
 385         nadir_celdas=(float(centro[0] / sistema.cell_mm), float(-centro[1] / sistema.cell_mm)),
 386         altura_mm=float(centro[2]),
 387         error_reproyeccion_px=error,
 388     )
 389 
 390 
 391 def construir_sistema(
 392     imagen: np.ndarray,
 393     cfg: ConfigVision,
 394     detectados: dict[int, np.ndarray] | None = None,
 395 ) -> SistemaCoordenadas:
 396     """Establece el sistema de coordenadas de la cancha a partir de una imagen.
 397 
 398     Exige los cuatro marcadores de esquina. Con tres no alcanza: una homografía
 399     necesita cuatro correspondencias, y con menos habría que suponer cosas sobre
 400     la cámara que no queremos suponer.
 401 
 402     `detectados` permite pasarle una detección ya hecha sobre ESTA misma imagen.
 403     Sirve para el bucle de proceso, que necesita los mismos marcadores para dos
 404     cosas —armar las coordenadas y encontrar los rovers— y no tiene por qué
 405     correr el detector de ArUco dos veces sobre el mismo cuadro. Si no se pasa,
 406     detecta por su cuenta, que es lo que hace falta para usarlo suelto.
 407     """
 408     if detectados is None:
 409         detectados = detectar_marcadores(imagen, cfg.marcadores_esquina.nombre_diccionario)
 410     esperados = cfg.marcadores_esquina.ids_esperados
 411     faltantes = sorted(esperados - set(detectados))
 412     if faltantes:
 413         raise ErrorGeometria(
 414             "faltan marcadores de esquina: se esperaban {} y se detectaron {}. "
 415             "Revisar que los cuatro estén planos, completos, iluminados y con su "
 416             "zona blanca sin tapar.".format(sorted(esperados), sorted(detectados))
 417         )
 418 
 419     # El orden importa: cada centro en píxeles tiene que corresponderse con la
 420     # celda de SU marcador. Se recorre por ID para que no dependa del orden en
 421     # que el detector los haya devuelto.
 422     ids = sorted(esperados)
 423     origen_px = np.array([centro_de(detectados[i]) for i in ids], dtype=np.float32)
 424     destino_celdas = np.array(
 425         [cfg.marcadores_esquina.disposicion[i] for i in ids], dtype=np.float32
 426     )
 427 
 428     a_celdas_h = cv2.getPerspectiveTransform(origen_px, destino_celdas).astype(np.float64)
 429     a_pixeles_h = cv2.getPerspectiveTransform(destino_celdas, origen_px).astype(np.float64)
 430 
 431     return SistemaCoordenadas(
 432         a_celdas_h=a_celdas_h,
 433         a_pixeles_h=a_pixeles_h,
 434         cols=cfg.tablero.cols,
 435         rows=cfg.tablero.rows,
 436         cell_mm=cfg.tablero.cell_mm,
 437         centros_px={i: centro_de(detectados[i]) for i in ids},
 438     )

