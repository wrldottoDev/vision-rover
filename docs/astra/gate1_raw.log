 106 class Arbitro:
 107     """La fase de la ronda. La visión es árbitro y tiene que ser una sola voz.
 108 
 109     Se protege con un candado porque la escribe el hilo del teclado y la lee el
 110     de proceso. Es un dato chiquito, pero un dato compartido igual.
 111 
 112     Las transiciones son explícitas y las inválidas se rechazan avisando, en vez
 113     de aceptarse en silencio: escribir `start` sin haber preparado la cancha es
 114     un error de quien opera, y merece enterarse.
 115     """
 116 
 117     def __init__(self, inicial: str = "IDLE"):
 118         self._fase = inicial
 119         self._lock = threading.Lock()
 120 
 121     @property
 122     def fase(self) -> str:
 123         with self._lock:
 124             return self._fase
 125 
 126     def intentar(self, comando: str) -> str:
 127         destino, desde = _TRANSICIONES[comando]
 128         with self._lock:
 129             if self._fase not in desde:
 130                 return "'{}' no es válido desde {} (se puede desde {})".format(
 131                     comando, self._fase, list(desde))
 132             anterior, self._fase = self._fase, destino
 133             return "fase: {} -> {}".format(anterior, destino)
 134 
