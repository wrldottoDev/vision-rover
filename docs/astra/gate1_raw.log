 260 @dataclass(frozen=True)
 261 class Mensaje:
 262     """Un mensaje completo de telemetría: la foto del mundo en un instante.
 263 
 264     `seq` y `ts_ms` los pone el publicador, no el detector: sirven para que el
 265     consumidor detecte pérdidas (saltos de `seq`) y mida latencia real
 266     (`ahora - ts_ms`, con `ts_ms` = instante de CAPTURA del cuadro, no de envío).
 267     """
 268 
 269     seq: int
 270     ts_ms: int
 271     phase: str
 272     grid: Grid
 273     start: Start
 274     depots: tuple[Depot, ...] = ()
 275     rovers: tuple[Rover, ...] = ()
 276     cubes: tuple[Cube, ...] = ()
 277     obstacles: tuple[Obstacle, ...] = ()
 278     v: int = PROTOCOL_VERSION
 279 
 280     def a_dict(self) -> dict[str, Any]:
 281         return {
 282             "v": self.v,
 283             "seq": self.seq,
 284             "ts_ms": self.ts_ms,
 285             "phase": self.phase,
 286             "grid": self.grid.a_dict(),
 287             "rovers": [r.a_dict() for r in self.rovers],
 288             "cubes": [c.a_dict() for c in self.cubes],
 289             "obstacles": [o.a_dict() for o in self.obstacles],
 290             "start": self.start.a_dict(),
 291             "depots": [d.a_dict() for d in self.depots],
 292         }
 293 
 294     @staticmethod
 295     def desde_dict(d: dict[str, Any]) -> Mensaje:
 296         """Construye un `Mensaje` a partir de un dict ya parseado.
 297 
 298         Valida primero: preferimos fallar con un mensaje claro antes que
 299         construir un objeto a medias que reviente más adelante.
 300         """
 301         error = validate_message(d)
 302         if error is not None:
 303             raise ValueError(error)
 304         return Mensaje(
 305             v=d["v"],
 306             seq=d["seq"],
 307             ts_ms=d["ts_ms"],
 308             phase=d["phase"],
 309             grid=Grid.desde_dict(d["grid"]),
 310             start=Start.desde_dict(d["start"]),
 311             depots=tuple(Depot.desde_dict(x) for x in d["depots"]),
 312             rovers=tuple(Rover.desde_dict(x) for x in d["rovers"]),
 313             cubes=tuple(Cube.desde_dict(x) for x in d["cubes"]),
 314             obstacles=tuple(Obstacle.desde_dict(x) for x in d["obstacles"]),
 315         )
 316 
 317 
 318 # --------------------------------------------------------------------------
 319 # Validación
 320 # --------------------------------------------------------------------------
 321 
 322 
 323 def _es_entero(valor: Any) -> bool:
 324     """True si es un entero de verdad.
 325 
 326     `bool` es subclase de `int` en Python, así que `True` pasaría como entero.
 327     Lo excluimos a mano: un `True` en `seq` es un bug, no un dato.
 328     """
 329     return isinstance(valor, int) and not isinstance(valor, bool)
 330 
 331 
 332 def _es_numero(valor: Any) -> bool:
 333     """True si es un número finito.
 334 
 335     Aceptamos `int` donde el contrato dice `float` porque JSON serializa `2.0`
 336     como `2`: rechazarlo tiraría mensajes perfectamente válidos. La regla de
 337     "nunca redondear a entero" es del PRODUCTOR, no del validador.
 338     """
 339     if isinstance(valor, bool):
 340         return False
 341     if not isinstance(valor, (int, float)):
 342         return False
 343     return math.isfinite(valor)
 344 
 345 
 346 def _revisar_campos(obj: Any, esperados: frozenset, donde: str) -> str | None:
 347     """Verifica que `obj` sea un dict con exactamente los campos esperados."""
 348     if not isinstance(obj, dict):
 349         return "{}: se esperaba un objeto, llegó {}".format(donde, type(obj).__name__)
 350     presentes = set(obj.keys())
 351     faltantes = esperados - presentes
 352     if faltantes:
 353         return "{}: faltan campos {}".format(donde, sorted(faltantes))
 354     sobrantes = presentes - esperados
 355     if sobrantes:
 356         return "{}: campos no reconocidos {}".format(donde, sorted(sobrantes))
 357     return None
 358 
 359 
 360 def _revisar_posicion(obj: dict[str, Any], donde: str) -> str | None:
 361     """Valida `col`/`row`.
 362 
 363     NO se exige que caigan dentro de la grilla: la corrección de paralaje puede
 364     dejar un objeto apenas afuera del borde, y eso es un dato válido, no un
 365     error de contrato. Solo se exige que sean números finitos.
 366     """
 367     for campo in ("col", "row"):
 368         if not _es_numero(obj[campo]):
 369             return "{}: '{}' debe ser un número finito, llegó {!r}".format(
 370                 donde, campo, obj[campo]
 371             )
 372     return None
 373 
 374 
 375 def _revisar_edad(obj: dict[str, Any], donde: str) -> str | None:
 376     if not _es_entero(obj["age_ms"]) or obj["age_ms"] < 0:
 377         return "{}: 'age_ms' debe ser un entero >= 0, llegó {!r}".format(donde, obj["age_ms"])
 378     return None
 379 
 380 
 381 def _revisar_lista(msg: dict[str, Any], nombre: str) -> str | None:
 382     if not isinstance(msg[nombre], list):
 383         return "'{}' debe ser una lista, llegó {}".format(nombre, type(msg[nombre]).__name__)
 384     return None
 385 
 386 
 387 def validate_message(msg: Any) -> str | None:
 388     """Valida un mensaje contra el contrato.
 389 
 390     Devuelve `None` si el mensaje cumple, o un texto claro con el PRIMER error
 391     encontrado si no. Devolver texto en vez de lanzar excepción es a propósito:
 392     un cliente debe poder descartar un mensaje malo y seguir andando, sin
 393     envolver todo en try/except.
 394 
 395     Rechaza, entre otras cosas: versión desconocida, campos faltantes o
 396     sobrantes, fase inválida, `theta` fuera de rango, colores fuera del
 397     contrato, colores de cubo duplicados (el color es la identidad), IDs de
 398     rover duplicados, y cubos sin un depot de su color.
 399     """
 400     # --- raíz -------------------------------------------------------------
 401     error = _revisar_campos(msg, _CAMPOS_MENSAJE, "mensaje")
 402     if error:
 403         return error
 404 
 405     # La versión se revisa primero: si no la conocemos, el resto de la forma no
 406     # es confiable y cualquier otro error sería ruido.
 407     if not _es_entero(msg["v"]):
 408         return "'v' debe ser un entero, llegó {!r}".format(msg["v"])
 409     if msg["v"] != PROTOCOL_VERSION:
 410         return "versión de protocolo desconocida: {} (esta implementación entiende {})".format(
 411             msg["v"], PROTOCOL_VERSION
 412         )
 413 
 414     if not _es_entero(msg["seq"]) or msg["seq"] < 0:
 415         return "'seq' debe ser un entero >= 0, llegó {!r}".format(msg["seq"])
 416     if not _es_entero(msg["ts_ms"]) or msg["ts_ms"] < 0:
 417         return "'ts_ms' debe ser un entero >= 0, llegó {!r}".format(msg["ts_ms"])
 418     if msg["phase"] not in PHASES:
 419         return "'phase' inválida: {!r} (válidas: {})".format(msg["phase"], list(PHASES))
 420 
 421     # --- grid -------------------------------------------------------------
 422     error = _revisar_campos(msg["grid"], _CAMPOS_GRID, "grid")
 423     if error:
 424         return error
 425     grid = msg["grid"]
 426     for campo in ("cols", "rows"):
 427         if not _es_entero(grid[campo]) or grid[campo] <= 0:
 428             return "grid: '{}' debe ser un entero > 0, llegó {!r}".format(campo, grid[campo])
 429     if not _es_numero(grid["cell_mm"]) or grid["cell_mm"] <= 0:
 430         return "grid: 'cell_mm' debe ser un número > 0, llegó {!r}".format(grid["cell_mm"])
 431 
 432     # --- listas dinámicas -------------------------------------------------
 433     for nombre in ("rovers", "cubes", "obstacles", "depots"):
 434         error = _revisar_lista(msg, nombre)
 435         if error:
 436             return error
 437 
 438     # --- rovers -----------------------------------------------------------
 439     ids_vistos = set()
 440     for i, rover in enumerate(msg["rovers"]):
 441         donde = "rovers[{}]".format(i)
 442         error = _revisar_campos(rover, _CAMPOS_ROVER, donde)
 443         if error:
 444             return error
 445         if not _es_entero(rover["id"]) or rover["id"] < 0:
 446             return "{}: 'id' debe ser un entero >= 0 (ID del marcador ArUco), llegó {!r}".format(
 447                 donde, rover["id"]
 448             )
 449         if rover["id"] in ids_vistos:
 450             return "{}: 'id' duplicado {} — cada rover aparece una sola vez".format(
 451                 donde, rover["id"]
 452             )
 453         ids_vistos.add(rover["id"])
 454         error = _revisar_posicion(rover, donde) or _revisar_edad(rover, donde)
 455         if error:
 456             return error
 457         if not _es_numero(rover["theta"]) or not (0.0 <= rover["theta"] <= 360.0):
 458             return "{}: 'theta' debe estar en grados dentro de [0, 360], llegó {!r}".format(
 459                 donde, rover["theta"]
 460             )
 461 
 462     # --- depots (se validan antes que los cubos porque los cubos dependen) --
 463     colores_depot = set()
 464     for i, depot in enumerate(msg["depots"]):
 465         donde = "depots[{}]".format(i)
 466         error = _revisar_campos(depot, _CAMPOS_DEPOT, donde)
 467         if error:
 468             return error
 469         if depot["color"] not in CUBE_COLORS:
 470             return "{}: color fuera del contrato: {!r} (válidos: {})".format(
 471                 donde, depot["color"], list(CUBE_COLORS)
 472             )
 473         if depot["color"] in colores_depot:
 474             return "{}: hay más de un depot de color {!r} — debe haber uno por color".format(
 475                 donde, depot["color"]
 476             )
 477         colores_depot.add(depot["color"])
 478         error = _revisar_posicion(depot, donde)
 479         if error:
 480             return error
 481 
 482     # --- cubes ------------------------------------------------------------
 483     colores_cubo = set()
 484     for i, cubo in enumerate(msg["cubes"]):
 485         donde = "cubes[{}]".format(i)
 486         error = _revisar_campos(cubo, _CAMPOS_CUBE, donde)
 487         if error:
 488             return error
 489         if cubo["color"] not in CUBE_COLORS:
 490             return "{}: color fuera del contrato: {!r} (válidos: {}; el {} está reservado " \
 491                    "para obstáculos)".format(
 492                        donde, cubo["color"], list(CUBE_COLORS), COLOR_RESERVADO_OBSTACULO
 493                    )
 494         if cubo["color"] in colores_cubo:
 495             return "{}: color de cubo duplicado {!r} — el color ES la identidad del cubo".format(
 496                 donde, cubo["color"]
 497             )
 498         colores_cubo.add(cubo["color"])
 499         error = _revisar_posicion(cubo, donde) or _revisar_edad(cubo, donde)
 500         if error:
 501             return error
 502 
 503     # Invariante de juego: todo cubo tiene a dónde ir. Un cubo sin depot de su
 504     # color dejaría a los equipos con una tarea imposible.
 505     sin_destino = sorted(colores_cubo - colores_depot)
 506     if sin_destino:
 507         return "hay cubos sin depot de su color: {} (depots presentes: {})".format(
 508             sin_destino, sorted(colores_depot)
 509         )
 510 
 511     # --- obstacles --------------------------------------------------------
 512     for i, obst in enumerate(msg["obstacles"]):
 513         donde = "obstacles[{}]".format(i)
 514         error = _revisar_campos(obst, _CAMPOS_OBSTACLE, donde)
 515         if error:
 516             return error
 517         error = _revisar_posicion(obst, donde) or _revisar_edad(obst, donde)
 518         if error:
 519             return error
 520 
 521     # --- start ------------------------------------------------------------
 522     error = _revisar_campos(msg["start"], _CAMPOS_START, "start")
 523     if error:
 524         return error
 525     error = _revisar_posicion(msg["start"], "start")
 526     if error:
 527         return error
 528 
 529     return None
 530 
 531 
 532 # --------------------------------------------------------------------------
 533 # Formato de cable (NDJSON)
 534 #
 535 # Vive en el contrato para que el simulador, el cliente de referencia y el
 536 # sistema de visión real usen exactamente el mismo código de serialización. Si
 537 # el formato de cable estuviera duplicado, tarde o temprano divergiría.
 538 # --------------------------------------------------------------------------
 539 
 540 
 541 def codificar_ndjson(msg: Any) -> str:
 542     """Serializa un mensaje (dict o `Mensaje`) a una línea NDJSON con `\\n`.
 543 
 544     `separators` sin espacios para no gastar ancho de banda, y `ensure_ascii`
 545     en False porque no hay razón para escapar: el contrato es ASCII puro.
 546     """
 547     if isinstance(msg, Mensaje):
 548         msg = msg.a_dict()
 549     return json.dumps(msg, separators=(",", ":"), ensure_ascii=False) + "\n"
 550 
 551 
 552 def decodificar_ndjson(linea: str) -> dict[str, Any]:
 553     """Parsea una línea NDJSON a dict. Lanza `ValueError` si no es JSON válido.
 554 
 555     No valida el contrato: eso es trabajo de `validate_message`. Separar
 556     "parsear" de "validar" permite reportar los dos errores por separado.
 557     """
 558     dato = json.loads(linea)
 559     if not isinstance(dato, dict):
 560         raise ValueError("la línea no contiene un objeto JSON")
 561     return dato

