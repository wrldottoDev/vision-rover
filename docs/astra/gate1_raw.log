  84     elif a.hueco0 is not None:
  85         Wu, via = a.hueco0 + ancho_proyectado(L, 0.0, r), 'deducido del hueco alineado (M2)'
  86     else:
  87         Wu, via, med_W = M_WU, 'DXF de piezas separadas', False
  88 
  89     Wext = a.ancho_max if a.ancho_max is not None else M_WEXT
  90     med_Wext = a.ancho_max is not None
  91     Lam = a.largo_max if a.largo_max is not None else M_LAM
  92     med_Lam = a.largo_max is not None
  93 
  94     print('=' * 74)
  95     print('ENTRADAS')
  96     print('=' * 74)
  97     print('  %sarista del cubo L      = %8.2f mm' % (marca(med_L), L))
  98     if r:
  99         print('  MEDIDO radio de arista       = %8.2f mm' % r)
 100     print('  %sancho util del canal   = %8.2f mm   (%s)' % (marca(med_W), Wu, via))
 101     print('  %sancho maximo real      = %8.2f mm' % (marca(med_Wext), Wext))
 102     print('  %slargo (para R_rov)     = %8.2f mm' % (marca(med_Lam), Lam))
