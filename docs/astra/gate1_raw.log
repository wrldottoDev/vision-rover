FILE codigos/motor_calibration.py
   1 # motor_calibration.py
   2 #
   3 # Calcula una compensación entre los dos motores del CenfoBot.
   4 #
   5 # El robot intenta avanzar recto mientras la IMU mide
   6 # cuánto cambia su orientación.
   7 #
   8 # Como el CenfoBot no tiene encoders, esta calibración
   9 # mide el efecto final de las diferencias entre:
  10 #
  11 # - motores
  12 # - reductores
  13 # - ruedas
  14 # - fricción
  15 #
  16 # El resultado es un factor RIGHT_GAIN que puede utilizarse
  17 # posteriormente en drive.py, move_heading.py, etc.
  18 #
  19 # IMPORTANTE:
  20 # Ejecutar sobre una superficie plana y con espacio suficiente.
  21 
  22 
  23 import board
  24 import time
  25 import math
  26 
  27 from ideaboard import IdeaBoard
  28 from adafruit_lsm6ds.lsm6ds3trc import LSM6DS3TRC
  29 
  30 
  31 # --------------------------------------------------
  32 # CONFIGURACION
  33 # --------------------------------------------------
  34 
  35 TEST_SPEED = 0.35
  36 TEST_DURATION = 1.0
  37 
  38 # Cambio intencional que utilizamos para descubrir
  39 # cómo responde el robot al modificar motor_2.
  40 PROBE_GAIN = 0.10
  41 
  42 MIN_GAIN = 0.70
  43 MAX_GAIN = 1.30
  44 
  45 RAD_TO_DEG = 180 / math.pi
  46 
  47 
  48 # --------------------------------------------------
  49 # HARDWARE
  50 # --------------------------------------------------
  51 
  52 ib = IdeaBoard()
  53 
  54 i2c = board.I2C()
  55 sensor = LSM6DS3TRC(i2c, 0x6B)
  56 
  57 
  58 # --------------------------------------------------
  59 # FUNCIONES AUXILIARES
  60 # --------------------------------------------------
  61 
  62 def limit(value, minimum, maximum):
  63     return max(minimum, min(maximum, value))
  64 
  65 
  66 def stop():
  67 
  68     ib.motor_1.throttle = 0
  69     ib.motor_2.throttle = 0
  70 
  71 
  72 # --------------------------------------------------
  73 # CALIBRACION DEL GIROSCOPIO
  74 # --------------------------------------------------
  75 
  76 def calibrate_gyro_drift(sensor, seconds=3):
  77 
  78     print("Calibrando giroscopio...")
  79     print("No mover el robot.")
  80 
  81     total = 0
  82     samples = 0
  83 
  84     start = time.monotonic()
  85 
  86     while time.monotonic() - start < seconds:
  87 
  88         gyro_z = sensor.gyro[2]
  89 
  90         if abs(gyro_z) < 0.05:
  91 
  92             total += gyro_z
  93             samples += 1
  94 
  95         time.sleep(0.005)
  96 
  97     if samples == 0:
  98         return 0
  99 
 100     drift = total / samples
 101 
 102     print("Drift:", drift, "rad/s")
 103 
 104     return drift
 105 
 106 
 107 # --------------------------------------------------
 108 # PRUEBA DE MOVIMIENTO
 109 # --------------------------------------------------
 110 
 111 def straight_test(
 112     speed,
 113     duration,
 114     drift,
 115     right_gain=1.0
 116 ):
 117 
 118     """
 119     Hace avanzar el robot durante un tiempo determinado
 120     y devuelve cuánto cambió su orientación.
 121 
 122     motor_1 se utiliza como referencia.
 123 
 124     motor_2 se multiplica por right_gain.
 125     """
 126 
 127     heading_change = 0.0
 128 
 129     left_speed = speed
 130     right_speed = speed * right_gain
 131 
 132     left_speed = limit(left_speed, -1, 1)
 133     right_speed = limit(right_speed, -1, 1)
 134 
 135     print()
 136     print("Prueba")
 137     print("Motor 1:", round(left_speed, 3))
 138     print("Motor 2:", round(right_speed, 3))
 139 
 140     previous_time = time.monotonic()
 141     start_time = previous_time
 142 
 143     try:
 144 
 145         ib.motor_1.throttle = left_speed
 146         ib.motor_2.throttle = right_speed
 147 
 148         while time.monotonic() - start_time < duration:
 149 
 150             current_time = time.monotonic()
 151 
 152             dt = current_time - previous_time
 153             previous_time = current_time
 154 
 155             gyro_z = sensor.gyro[2] - drift
 156 
 157             angular_velocity = (
 158                 gyro_z * RAD_TO_DEG
 159             )
 160 
 161             heading_change += (
 162                 angular_velocity * dt
 163             )
 164 
 165             time.sleep(0.005)
 166 
 167     finally:
 168 
 169         stop()
 170 
 171     print(
 172         "Desviacion:",
 173         round(heading_change, 2),
 174         "grados"
 175     )
 176 
 177     return heading_change
 178 
 179 
 180 # --------------------------------------------------
 181 # CALIBRACION DE MOTORES
 182 # --------------------------------------------------
 183 
 184 def calibrate_motors(
