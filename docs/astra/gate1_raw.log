 117 def a_mensaje(estado: EstadoMundo, cfg: ConfigVision, seq: int) -> schema.Mensaje:
 118     """Convierte el estado del mundo al mensaje del contrato.
 119 
 120     `seq` lo pone el publicador y no el detector: cuenta **mensajes publicados**,
 121     no cuadros procesados. Los huecos que ve un cliente son mensajes que se le
 122     pisaron por la política de último-valor-gana, y eso es la política
 123     funcionando, no una falla.
 124 
 125     `obstacles` sale siempre como lista vacía: esta edición del reto no los usa.
 126     El campo sigue existiendo y sigue siendo una lista, así que **no es un cambio
 127     de contrato** y ningún equipo tiene que tocar nada.
 128     """
 129     return schema.Mensaje(
 130         seq=seq,
 131         ts_ms=estado.ts_ms,
 132         phase=estado.fase,
 133         grid=schema.Grid(cols=cfg.tablero.cols, rows=cfg.tablero.rows,
 134                          cell_mm=cfg.tablero.cell_mm),
 135         start=schema.Start(col=cfg.lugares.start_col, row=cfg.lugares.start_row),
 136         depots=tuple(
 137             schema.Depot(color=d.color, col=d.col, row=d.row) for d in cfg.lugares.depositos
 138         ),
 139         rovers=tuple(
 140             schema.Rover(id=r.id, col=round(r.col, 3), row=round(r.row, 3),
 141                          theta=round(r.theta_grados, 2), age_ms=r.age_ms)
 142             for r in estado.rovers
 143         ),
 144         cubes=tuple(
 145             schema.Cube(color=c.color, col=round(c.col, 3), row=round(c.row, 3),
 146                         age_ms=c.age_ms)
 147             for c in estado.cubos
 148         ),
 149         obstacles=(),
 150     )

FILE vision-system/vision/tracking/seguimiento.py
   1 """Seguimiento entre cuadros: memoria, oclusión y edad.
   2 
   3 Acá NO hay problema de asociación
   4 ---------------------------------
   5 Vale la pena decirlo primero, porque cambia por completo el tamaño del problema:
   6 **cada objeto de este reto trae su propia identidad**. El rover la trae en el ID
   7 de su marcador ArUco; el cubo, en su color, y no hay dos del mismo.
   8 
   9 O sea que no hay que adivinar **qué detección de este cuadro corresponde a cuál
  10 del anterior** —que es el problema difícil de todo seguimiento, el que obliga a
  11 predicciones, filtros y algoritmos de asignación— porque la respuesta viene
  12 escrita en el objeto.
  13 
  14 Lo que queda es mucho más simple, y por eso mucho más confiable: **recordar la
  15 última observación buena de cada identidad y decir cuánto hace que fue**.
  16 
  17 La regla que no se negocia
  18 --------------------------
  19 Un objeto tapado **mantiene su última posición** y su **edad crece**. Nunca
  20 parpadea entre existir y no existir.
  21 
  22 Un objeto que aparece y desaparece vuelve loco al consumidor: el código del
  23 equipo tendría que distinguir "se lo llevaron" de "no lo veo ahora mismo", y no
  24 puede. Es preferible un dato viejo **marcado como viejo** que un agujero.
  25 
  26 Qué cuenta como "verlo de verdad"
  27 ---------------------------------
  28 Un rover: que se haya detectado su marcador. La detección de ArUco es binaria —
  29 lo encuentra o no lo encuentra.
  30 
  31 Un cubo: que se haya detectado **y que el ajuste sea confiable**. Una detección
  32 no confiable dice "el cubo está por acá" pero no "el cubo está acá", y por eso
  33 **no refresca la posición ni la edad**. Es justo el caso del rover empujando un
  34 cubo y tapándole casi todo: se conserva la última posición buena y la edad crece,
  35 que es exactamente lo que el contrato promete para un objeto ocluido. Refrescar
  36 con esa detección sería publicar una posición que el propio sistema considera
  37 dudosa, y encima presentarla como fresca.
  38 
  39 La edad se mide en tiempo de captura
  40 ------------------------------------
  41 `edad = ts_ms de este cuadro − ts_ms del cuadro donde se lo vio por última vez`.
  42 Los dos son instantes de **captura**, así que la edad no depende de cuánto tardó
  43 el procesamiento ni de cuándo se publicó. Es la edad real del dato, que es lo que
  44 el equipo necesita para decidir si frenar.
  45 """
  46 
  47 from __future__ import annotations
  48 
  49 from dataclasses import dataclass
  50 
  51 try:  # como paquete
  52     from ..configuracion import ConfigVision
  53     from ..detectors.cubos import CuboDetectado
  54     from ..detectors.rovers import RoverDetectado
  55     from ..mundo import CuboEnMundo, EstadoMundo, RoverEnMundo
  56 except ImportError:  # como script suelto
  57     from vision.configuracion import ConfigVision  # type: ignore[no-redef]
  58     from vision.detectors.cubos import CuboDetectado  # type: ignore[no-redef]
  59     from vision.detectors.rovers import RoverDetectado  # type: ignore[no-redef]
  60     from vision.mundo import (  # type: ignore[no-redef]
  61         CuboEnMundo, EstadoMundo, RoverEnMundo,
  62     )
  63 
  64 
  65 @dataclass(slots=True)
  66 class _Recuerdo:
  67     """La última observación buena de un objeto, y cuándo fue.
  68 
  69     Es mutable a propósito, y es lo único que lo es en todo este camino: la
  70     memoria del seguidor vive del lado de los productores y nunca cruza. Lo que
  71     cruza es el estado del mundo, que se produce nuevo en cada cuadro.
  72     """
  73 
  74     col: float
  75     row: float
  76     theta_grados: float
  77     ts_ms: int
  78 
  79 
  80 class Seguidor:
  81     """Memoria de los objetos vistos, cuadro a cuadro.
  82 
  83     Es el único que convierte detecciones en estado del mundo, y lo hace
  84     **recordando**. Sin memoria, todo se publicaría con edad cero y un objeto
  85     tapado desaparecería de la lista, que es justo lo que el contrato promete
  86     que no pasa.
  87 
  88     No es seguro para usar desde varios hilos, y no hace falta que lo sea: vive
  89     en el hilo de proceso, que es el único que lo toca.
  90     """
  91 
  92     def __init__(self, cfg: ConfigVision):
  93         self._cfg = cfg
  94         self._rovers: dict[int, _Recuerdo] = {}
  95         self._cubos: dict[str, _Recuerdo] = {}
  96         # Contadores para el diagnóstico: cuántas veces se conservó una posición
  97         # porque no se vio el objeto. Es la medida de cuánta oclusión hubo.
  98         self.conservados_rover = 0
  99         self.conservados_cubo = 0
 100         self.barridos = 0
 101 
 102     def actualizar(
 103         self,
 104         ts_ms: int,
 105         fase: str,
 106         rovers: tuple[RoverDetectado, ...],
 107         cubos: tuple[CuboDetectado, ...],
 108     ) -> EstadoMundo:
 109         """Incorpora las detecciones de un cuadro y produce el estado del mundo."""
 110         vistos_rover = {r.id for r in rovers}
 111         for r in rovers:
 112             self._rovers[r.id] = _Recuerdo(r.col, r.row, r.theta_grados, ts_ms)
 113 
 114         refrescar_dudosos = self._cfg.seguimiento.refrescar_con_cubos_no_confiables
 115         vistos_cubo = set()
 116         for c in cubos:
 117             if c.confiable or refrescar_dudosos:
 118                 self._cubos[c.color] = _Recuerdo(c.col, c.row, 0.0, ts_ms)
 119                 vistos_cubo.add(c.color)
 120 
 121         self.conservados_rover += len(set(self._rovers) - vistos_rover)
 122         self.conservados_cubo += len(set(self._cubos) - vistos_cubo)
 123         self._barrer(ts_ms)
 124 
 125         return EstadoMundo(
 126             ts_ms=ts_ms,
 127             fase=fase,
 128             rovers=tuple(
 129                 RoverEnMundo(id=id_rover, col=r.col, row=r.row,
 130                              theta_grados=r.theta_grados, age_ms=max(0, ts_ms - r.ts_ms))
 131                 for id_rover, r in sorted(self._rovers.items())
 132             ),
 133             cubos=tuple(
 134                 CuboEnMundo(color=color, col=c.col, row=c.row,
 135                             age_ms=max(0, ts_ms - c.ts_ms))
 136                 for color, c in sorted(self._cubos.items())
 137             ),
 138         )
 139 
 140     def _barrer(self, ts_ms: int) -> None:
 141         """Saca los objetos que hace demasiado que no se ven.
 142 
 143         No es para oclusiones: para eso está la edad, y el contrato promete que
 144         un objeto tapado no desaparece. Esto barre **fantasmas** —una detección
 145         espuria que nunca se repitió, o un objeto que de verdad se fue de la
 146         cancha— y el límite es generoso a propósito para que una oclusión
 147         legítima nunca lo alcance.
 148         """
 149         limite = self._cfg.seguimiento.edad_maxima_ms
 150         for memoria in (self._rovers, self._cubos):
 151             viejos = [k for k, v in memoria.items() if ts_ms - v.ts_ms > limite]
 152             for k in viejos:
 153                 del memoria[k]
 154                 self.barridos += 1
 155 
 156     @property
 157     def edades_ms(self) -> dict[str, int]:
 158         """Las edades actuales, para el diagnóstico. No se publica desde acá."""
 159         ultimo = max(
 160             [r.ts_ms for r in self._rovers.values()] + [c.ts_ms for c in self._cubos.values()],
 161             default=0,
 162         )
 163         salida = {"rover {}".format(k): ultimo - v.ts_ms for k, v in self._rovers.items()}
 164         salida.update({c: ultimo - v.ts_ms for c, v in self._cubos.items()})
 165         return salida

