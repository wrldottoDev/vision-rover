 108     if a.hueco45 is not None and a.hueco0 is not None:
 109         dif = a.hueco0 - a.hueco45
 110         esperado = ancho_proyectado(L, 45.0, r) - ancho_proyectado(L, 0.0, r)
 111         print()
 112         print('CONTROL M2 - M1 (identidad geometrica, no depende de W_u)')
 113         print('  medido   = %6.2f mm' % dif)
 114         print('  esperado = %6.2f mm' % esperado)
 115         if abs(dif - esperado) <= 1.5:
 116             print('  -> COHERENTE: las dos mediciones se pueden creer.')
 117         else:
 118             print('  -> INCOHERENTE por %.2f mm. Revisar antes de usar estos numeros:' %
 119                   abs(dif - esperado))
 120             print('     o el cubo no mide lo que se cree, o las paletas no son paralelas,')
 121             print('     o uno de los dos huecos se midio mal.')
 122 
 123     # ------------------------------------------------------------- derivadas
 124     wS_max = ancho_proyectado(L, 45.0, r)
 125     wS_min = ancho_proyectado(L, 0.0, r)
 126     emax_peor = (Wu - wS_max) / 2
 127     emax_mejor = (Wu - wS_min) / 2
 128     presu_peor = emax_peor - a.sigma_vis - a.sesgo_lateral
 129     presu_mejor = emax_mejor - a.sigma_vis - a.sesgo_lateral
 130 
 131     R_rov = 0.5 * math.sqrt(Wext ** 2 + Lam ** 2)
 132     rho_ct = wS_max / 2 + Lam / 2
 133     if a.lam is not None:
 134         rho_ct_real = wS_max / 2 + Lam / 2 + a.lam
 135     else:
 136         rho_ct_real = None
 137     rho_pu = rho_ct + S_SEG
 138 
 139     print()
 140     print('=' * 74)
 141     print('MAGNITUDES DERIVADAS')
 142     print('=' * 74)
 143     print('  anchura proyectada w_S       = [%6.2f, %6.2f] mm' % (wS_min, wS_max))
 144     print('  R_rov (envolvente)           = %8.2f mm = %.3f celdas' % (R_rov, R_rov / CELL))
 145     print('  rho_contacto (cota)          = %8.2f mm' % rho_ct)
 146     if a.lam is not None:
 147         X_ADEL = a.largo_chasis / 2.0 + a.lam
 148         R_real = math.hypot(X_ADEL, Wext / 2.0)
 149         R_mod = 0.5 * math.hypot(Wext, a.largo_chasis)
 150         rho_man = R_real + wS_max / 2 + 5.0
 151         print()
 152         print('  --- envolvente CON las paletas (hallazgo H-12) ---')
 153         print('  huella asimetrica            atras %.1f, adelante %.1f, lateral +-%.1f mm'
 154               % (a.largo_chasis / 2, X_ADEL, Wext / 2))
 155         print('  largo total                  = %8.2f mm' % (a.largo_chasis + a.lam))
 156         print('  R_rov del modelo (chasis)    = %8.2f mm' % R_mod)
 157         print('  R_rov real                   = %8.2f mm   -> +%.0f %%'
 158               % (R_real, 100 * (R_real / R_mod - 1)))
 159         print('  anillo de maniobra           = %8.2f mm   (para girar sin barrer el cubo)'
 160               % rho_man)
 161         print('  despeje lateral junto a otro cubo = %.2f mm' % (Wext / 2 + wS_max / 2))
 162         print('  retirada antes de girar      = %8.2f mm   (= lambda)' % a.lam)
 163         if a.lam < wS_max:
 164             print('  NOTA: lambda < w_S maximo: el cubo sobresale de las puntas; las')
 165             print('        paletas cubren el %.0f %% de su extension a 45 grados.'
 166                   % (100 * a.lam / wS_max))
 167     print('  rho_puesta (s=%.0f)            = %8.2f mm = %.2f celdas'
 168           % (S_SEG, rho_pu, rho_pu / CELL))
 169     print('  umbral de cuerda del anillo  = %8.2f grados'
 170           % (2 * math.degrees(math.acos(min(1.0, rho_ct / rho_pu)))))
 171     print('  e_max                        = [%6.2f, %6.2f] mm' % (emax_peor, emax_mejor))
 172     print('  presupuesto de control       = [%6.2f, %6.2f] mm' % (presu_peor, presu_mejor))
 173 
 174     # ---------------------------------------------------------- ventana angular
 175     print()
 176     print('  %-10s %12s %13s %16s' % ('margen m', 'w admisible', '|Delta| max', 'frac. orient.'))
 177     for m in (0.0, 1.0, 2.0, 3.0, 5.0):
 178         w = Wu - 2 * (m + a.sigma_vis + a.sesgo_lateral)
 179         if w < wS_min:
 180             print('  %-10.1f %12.2f %13s %16s' % (m, w, 'IMPOSIBLE', '0 %'))
 181             continue
 182         rr = (w / L) ** 2 - 1 if r == 0 else None
 183         if r == 0 and rr >= 1:
 184             print('  %-10.1f %12.2f %13s %16s' % (m, w, 'sin limite', '100 %'))
 185             continue
 186         # barrido numerico, valido tambien con aristas redondeadas
 187         adm = [d / 10.0 for d in range(0, 451)
 188                if ancho_proyectado(L, d / 10.0, r) <= w]
 189         if not adm:
 190             print('  %-10.1f %12.2f %13s %16s' % (m, w, 'IMPOSIBLE', '0 %'))
 191             continue
 192         dmax = max(adm)
 193         print('  %-10.1f %12.2f %12.2f%s %15.0f %%' % (m, w, dmax, chr(176), 100 * dmax / 45.0))
 194 
 195     # ------------------------------------------------------------- veredicto
 196     print()
 197     print('=' * 74)
 198     print('VEREDICTO SOBRE LOS HALLAZGOS DEL INFORME')
 199     print('=' * 74)
 200 
 201     # H-11
 202     if presu_peor < 0:
 203         neg = [d / 10.0 for d in range(0, 901)
 204                if (Wu - ancho_proyectado(L, d / 10.0, r)) / 2 - a.sigma_vis
 205                - a.sesgo_lateral < 0]
 206         frac = 100.0 * len(neg) / 901.0
 207         print('  H-11  CONFIRMADO. Presupuesto de control negativo (%.2f mm) en el peor' % presu_peor)
 208         print('        caso; %.0f %% de las orientaciones queda sin margen.' % frac)
 209         print('        Conocer el angulo del cubo es OBLIGATORIO.')
 210     elif presu_peor < MARGEN:
 211         print('  H-11  ATENUADO. El presupuesto en el peor caso es %.2f mm: positivo pero' % presu_peor)
 212         print('        por debajo del margen de control deseable (%.1f mm). Conocer el' % MARGEN)
 213         print('        angulo deja de ser obligatorio y vuelve a ser palanca de robustez.')
 214     else:
 215         print('  H-11  REFUTADO. El presupuesto en el peor caso es %.2f mm, suficiente.' % presu_peor)
 216         print('        Conocer el angulo del cubo vuelve a ser una mejora de eficiencia.')
 217 
 218     # factibilidad basica
 219     if Wu < wS_max:
 220         print('  NUEVO CRITICO: W_u = %.2f < w_S maximo = %.2f. Hay orientaciones en las'
 221               % (Wu, wS_max))
 222         print('        que el cubo NO ENTRA entre las paletas. El modelo supone que')
 223         print('        siempre entra; esa hipotesis se cae.')
 224     else:
 225         print('  Factibilidad: W_u = %.2f > w_S maximo = %.2f, el cubo siempre entra.'
 226               % (Wu, wS_max))
 227 
 228     # H-10 / R_rov
 229     if med_Wext and Wext > M_WEXT + 0.5:
 230         print('  H-10  AMPLIADO. El ancho real (%.2f) supera al del acrilico (%.2f):'
 231               % (Wext, M_WEXT))
 232         print('        R_rov sube de %.2f a %.2f mm. El inflado de obstaculos y la zona'
 233               % (0.5 * math.sqrt(M_WEXT ** 2 + M_LAM ** 2), R_rov))
 234         print('        de exclusion de borde estaban SUBESTIMADOS: error del lado peligroso.')
 235 
 236     if a.sesgo_lateral:
 237         print('  SESGO del marcador: se lleva %.2f mm del presupuesto. Es sistematico,'
 238               % a.sesgo_lateral)
 239         print('        asi que se puede compensar en el cliente restandolo a la posicion')
 240         print('        reportada. Hacerlo devuelve esos %.2f mm.' % a.sesgo_lateral)
 241 
 242     if r:
 243         base = (M_WU - 60 * math.sqrt(2)) / 2
 244         print('  Aristas redondeadas: e_max en el peor caso pasa de %.2f a %.2f mm.'
 245               % (base, emax_peor))

FILE 05_Mediciones_CAD/medir_dxf.py
   1 """Mide las piezas del CAD de fabricacion del CenfoBot y verifica la escala.
   2 
   3 Uso:   python3 medir_dxf.py [carpeta_archivos_fabricacion]
   4        python3 medir_dxf.py --piezas <CENFOBOT_PIEZAS_SEPARADAS.dxf>
   5 
   6 El segundo modo mide el despiece separado, que es el que resuelve el ancho util
   7 del canal W_u: el chasis tiene cuerpo de 93.50 y lenguetas de 3.00 por lado, y
   8 como la lengueta mide lo mismo que el espesor del acrilico la junta es pasante,
   9 de modo que la cara interior del panel lateral coincide con el borde del cuerpo.
  10 
  11 El DXF del rover NO declara unidades. El script confirma que 1 unidad = 1 mm por
  12 tres vias independientes antes de reportar cualquier medida:
  13   (a) las ranuras de ensamble deben medir 3.00 (espesor del acrilico);
  14   (b) los dos agujeros de la placa frontal deben dar 16 mm de diametro y 24 mm
  15       de separacion (patron del ultrasonico HC-SR04);
  16   (c) cubos.dxf, que si declara mm, debe medir 180.30 (tres cubos de 60 mm).
  17 
  18 Dependencias: ezdxf, cairosvg, opencv-python, numpy.
  19 """
  20 import sys, os
  21 import numpy as np
  22 
  23 CARPETA = sys.argv[1] if len(sys.argv) > 1 else '.'
  24 ROVER_DXF = os.path.join(CARPETA, 'CENFOBOT_Rover_Rev1.dxf')
  25 ROVER_SVG = os.path.join(CARPETA, 'CENFOBOT_Rover_Rev1.svg')
  26 CUBOS_DXF = os.path.join(CARPETA, 'cubos.dxf')
  27 
  28 
  29 def _pts(e):
  30     t = e.dxftype()
  31     if t == 'LINE':
  32         return np.array([[e.dxf.start.x, e.dxf.start.y], [e.dxf.end.x, e.dxf.end.y]])
  33     if t == 'LWPOLYLINE':
  34         return np.array([[p[0], p[1]] for p in e.get_points('xy')])
  35     if t == 'SPLINE':
  36         try:
  37             return np.array([[p[0], p[1]] for p in e.control_points])
  38         except Exception:
  39             return np.zeros((0, 2))
  40     return np.zeros((0, 2))
  41 
  42 
  43 def control_de_escala():
  44     """Via (c): cubos.dxf declara mm y debe medir 180.30 de lado."""
  45     import ezdxf
  46     d = ezdxf.readfile(CUBOS_DXF)
  47     P = [_pts(e) for e in d.modelspace()]
  48     A = np.vstack([p for p in P if len(p)])
  49     lado = float(A[:, 0].max() - A[:, 0].min())
  50     print('  (c) cubos.dxf: %.2f mm de lado  (esperado 180.30 = 3 x 60)' % lado)
  51     return abs(lado - 180.30) < 1.0
  52 
  53 
  54 def piezas_y_agujeros(ancho_px=4000):
  55     """Segmenta el sheet rasterizando el SVG y mide cada pieza en mm."""
  56     import cairosvg, cv2, re
  57     svg = open(ROVER_SVG).read()
  58     vb = [float(x) for x in re.search(r'viewBox="([-\d.eE ]+)"', svg).group(1).split()]
  59     cairosvg.svg2png(url=ROVER_SVG, write_to='/tmp/_sheet.png',
  60                      output_width=ancho_px, background_color='white')
  61     img = cv2.imread('/tmp/_sheet.png', 0)
  62     mm = vb[2] / ancho_px
  63     libre = (img >= 128).astype(np.uint8)
  64     n, lab, st, cen = cv2.connectedComponentsWithStats(libre, 4)
  65     fondo = lab[0, 0]
  66     comp = []
  67     for k in range(1, n):
  68         if k == fondo or st[k, cv2.CC_STAT_AREA] < 120:
  69             continue
  70         w = st[k, cv2.CC_STAT_WIDTH] * mm
  71         h = st[k, cv2.CC_STAT_HEIGHT] * mm
  72         a = st[k, cv2.CC_STAT_AREA] * mm * mm
  73         comp.append(dict(w=w, h=h, area=a, cx=cen[k][0] * mm, cy=cen[k][1] * mm,
  74                          llenado=a / (np.pi * (w / 2) * (h / 2)) if w * h else 0))
  75     return comp
  76 
  77 
  78 def ranuras_de_acrilico():
  79     """Via (a): las ranuras de ensamble deben medir 3.00 (espesor del acrilico).
  80 
  81     Cada ranura esta dibujada como varios segmentos independientes, asi que hay
  82     que agrupar las entidades del DXF por contigueidad antes de medirlas:
  83     ninguna entidad tiene por si sola la caja de 3 mm.
  84     """
  85     import ezdxf
  86     d = ezdxf.readfile(ROVER_DXF)
  87     P = [_pts(e) for e in d.modelspace()]
  88     P = [p for p in P if len(p) >= 2]
  89     B = [(p[:, 0].min(), p[:, 1].min(), p[:, 0].max(), p[:, 1].max()) for p in P]
  90     padre = list(range(len(P)))
  91 
  92     def raiz(i):
  93         while padre[i] != i:
  94             padre[i] = padre[padre[i]]
  95             i = padre[i]
  96         return i
  97 
  98     tol = 0.3
  99     for i in range(len(P)):
 100         for j in range(i + 1, len(P)):
 101             a, b = B[i], B[j]
 102             if (a[0] - tol <= b[2] and b[0] - tol <= a[2] and
 103                     a[1] - tol <= b[3] and b[1] - tol <= a[3]):
 104                 ri, rj = raiz(i), raiz(j)
 105                 if ri != rj:
 106                     padre[ri] = rj
 107 
 108     grupos = {}
 109     for i in range(len(P)):
 110         grupos.setdefault(raiz(i), []).append(i)

