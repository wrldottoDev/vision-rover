  84 def primera_altura(fuente, tiempo_max: float = 5.0) -> int:
  85     """Alto en píxeles del primer cuadro que entregue la fuente.
  86 
  87     La vista lo necesita para escalar la tipografía del panel: el mismo tamaño
  88     de letra se lee bien en 720p y queda diminuto en 1080p.
  89     """
  90     limite = time.monotonic() + tiempo_max
  91     while time.monotonic() < limite:
  92         cuadro = fuente.leer()
  93         if cuadro is not None:
  94             return int(cuadro.imagen.shape[0])
  95         time.sleep(0.01)
  96     return 720
