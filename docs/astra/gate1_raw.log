 272     ultimo_error = ""
 273     proximo_informe = time.monotonic() + 5.0
 274     fin = time.monotonic() + args.duracion if args.duracion > 0 else float("inf")
 275 
 276     try:
 277         while not salir.is_set() and time.monotonic() < fin:
 278             cuadro = fuente.leer()
