 386     # ------------------------------------------------------------ metricas --
 387     def entregados(self, tol_celdas=1.0):
 388         n = 0
 389         for cb in self.cubos:
 390             g = np.array(self.depots[cb.color]) * CELL
 391             if np.linalg.norm(cb.c - g) <= tol_celdas * CELL:
 392                 n += 1
 393         return n
 394 
 395     def distancias_al_deposito(self):
 396         return {cb.color: float(np.linalg.norm(cb.c - np.array(self.depots[cb.color]) * CELL) / CELL)
 397                 for cb in self.cubos}

