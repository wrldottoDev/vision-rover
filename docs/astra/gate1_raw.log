 252 class Simulador:
 253     """Genera estados del mundo sintéticos pero realistas.
 254 
 255     OJO con el alcance: el movimiento de los rovers es deambulación con rebote,
 256     no navegación. Este proyecto NO implementa la inteligencia de los rovers;
 257     acá los robots se mueven solamente para que haya algo que mirar.
 258     """
 259 
 260     def __init__(self, cfg: Config):
 261         self.cfg = cfg
 262         self.rng = random.Random(cfg.semilla)
 263         t0 = ahora_ms()
 264         self.rovers = [
 265             _RoverSim(int(r["id"]), float(r["col"]), float(r["row"]), float(r["theta"]), t0)
 266             for r in cfg.rovers_iniciales
 267         ]
 268         self.cubes = [
 269             _CuboSim(c["color"], float(c["col"]), float(c["row"]), t0) for c in cfg.cubes_iniciales
 270         ]
 271         # Los obstáculos son fijos: no tienen estado que evolucione.
 272         self.obstacles = [(float(o["col"]), float(o["row"])) for o in cfg.obstacles_iniciales]
 273 
 274     # -- helpers ----------------------------------------------------------
 275 
 276     def _dentro(self, col: float, row: float) -> bool:
 277         """Deja un margen de media celda para que el robot no se pegue al borde."""
 278         margen = 1.0
 279         return (
 280             margen <= col <= self.cfg.grid.cols - margen
 281             and margen <= row <= self.cfg.grid.rows - margen
 282         )
 283 
 284     def _choca_obstaculo(self, col: float, row: float) -> bool:
 285         for ocol, orow in self.obstacles:
 286             if math.hypot(col - ocol, row - orow) < 2.5:
 287                 return True
 288         return False
 289 
 290     def _ruido_pos(self) -> float:
 291         return self.rng.gauss(0.0, self.cfg.pos_sigma)
 292 
 293     # -- paso de simulación ------------------------------------------------
 294 
 295     def paso(self, dt_s: float, phase: str) -> EstadoMundo:
 296         """Avanza el mundo `dt_s` segundos y devuelve la foto observada.
 297 
 298         Solo se mueve en `RUNNING`. En las otras fases el mundo queda quieto,
 299         pero se sigue observando y publicando: el sistema nunca deja de emitir.
 300         """
 301         t = ahora_ms()
 302 
 303         if phase == FASE_RUNNING:
 304             self._mover_rovers(dt_s)
 305 
 306         rovers = self._observar_rovers(t)
 307         cubes = self._observar_cubes(t)
 308         obstacles = self._observar_obstacles()
 309 
 310         return EstadoMundo(
 311             ts_ms=t, phase=phase, rovers=rovers, cubes=cubes, obstacles=obstacles
 312         )
 313 
 314     def _mover_rovers(self, dt_s: float) -> None:
 315         paso = self.cfg.velocidad_celdas_s * dt_s
 316         for rv in self.rovers:
 317             # Deriva suave del rumbo para que la trayectoria no sea una recta
 318             # aburrida y el equipo vea theta cambiando de verdad.
 319             rv.theta = (rv.theta + self.rng.gauss(0.0, self.cfg.giro_grados_s * dt_s * 0.3)) % 360.0
 320 
 321             rad = math.radians(rv.theta)
 322             # row crece hacia ABAJO y theta es antihorario, de ahí el signo
 323             # negativo en el avance sobre row.
 324             dcol = math.cos(rad) * paso
 325             drow = -math.sin(rad) * paso
 326             ncol, nrow = rv.col + dcol, rv.row + drow
 327 
 328             if not self._dentro(ncol, nrow) or self._choca_obstaculo(ncol, nrow):
 329                 # Rebote: da media vuelta con algo de azar y se queda donde está
 330                 # este cuadro. Simple y suficiente; no es planificación.
 331                 rv.theta = (rv.theta + 180.0 + self.rng.uniform(-60.0, 60.0)) % 360.0
 332                 continue
 333 
 334             rv.col, rv.row = ncol, nrow
 335             self._empujar_cubos(rv, dcol, drow)
 336 
