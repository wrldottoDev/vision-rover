  98 #: Transiciones válidas de la ronda. La visión es árbitro y esta es su voz.
  99 _TRANSICIONES = {
 100     "ready": ("READY", ("IDLE", "FINISHED", "READY")),
 101     "start": ("RUNNING", ("READY",)),
 102     "stop": ("FINISHED", ("RUNNING",)),
 103 }
